@using AgenticSystem.Services
@using AgenticSystem.Data
@inject FirebaseAuthService AuthService
@inject FirebaseProfileService ProfileService

<style>
    .onboard-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0c0f1d 70%, #030712 100%);
        padding: 1.5rem;
    }

    .onboard-card {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.4);
        width: 100%;
        max-width: 550px;
        padding: 2.5rem;
        animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .onboard-input {
        width: 100%;
        padding: 0.8rem 1.1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.6);
        color: white;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .onboard-input:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }

    .onboard-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .onboard-btn {
        width: 100%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: white;
        padding: 0.9rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        margin-top: 1.5rem;
    }

    .onboard-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .onboard-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .alert-banner {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 8px;
        color: #f87171;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .step-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
    }

    .step-dot.active {
        background: #38bdf8;
        box-shadow: 0 0 8px #38bdf8;
        transform: scale(1.2);
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 44px;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        transition: background-color 0.2s ease;
        cursor: pointer;
    }
    
    .checkbox-row:hover {
        background: rgba(255, 255, 255, 0.03);
    }

    @@media (max-width: 480px) {
        .onboard-overlay {
            padding: 0.75rem !important;
        }

        .onboard-card {
            padding: 1.25rem !important;
            border-radius: 16px !important;
        }

        .onboard-input {
            padding: 0.8rem 1rem !important;
            font-size: 0.95rem !important;
            min-height: 44px !important;
        }

        .onboard-btn {
            padding: 0.85rem !important;
            min-height: 44px !important;
        }

        .step-indicator {
            margin-bottom: 1.5rem !important;
        }
    }
</style>

<div class="onboard-overlay">
    <div class="onboard-card">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="font-size: 2.25rem; margin-bottom: 0.25rem;">🏢</div>
            <h2 style="margin: 0; background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; font-size: 1.75rem;">Business Profile Onboarding</h2>
            <p style="color: #64748b; margin: 0.25rem 0 0 0; font-size: 0.95rem;">Tell Gemini about your company to customize the AI operational model</p>
        </div>

        <!-- Step Indicator -->
        <div class="step-indicator">
            <div class="step-dot @(CurrentStep == 1 ? "active" : "")"></div>
            <div class="step-dot @(CurrentStep == 2 ? "active" : "")"></div>
            <div class="step-dot @(CurrentStep == 3 ? "active" : "")"></div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert-banner">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <span>@ErrorMessage</span>
            </div>
        }

        <form @onsubmit="HandleSubmit">
            @if (CurrentStep == 1)
            {
                <!-- Step 1: Business Identity -->
                <div class="form-group">
                    <label class="form-label" for="businessName">Business Name</label>
                    <input type="text" id="businessName" @bind="BusinessName" class="onboard-input" placeholder="Acme Corporation" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="industry">Industry / Domain</label>
                    <select id="industry" @bind="BusinessIndustry" class="onboard-input" required>
                        <option value="">Select your industry...</option>
                        <option value="SaaS / Software">SaaS & Software Systems</option>
                        <option value="E-Commerce / Retail">E-Commerce & Retail</option>
                        <option value="Healthcare / Biotech">Healthcare & Biotech</option>
                        <option value="Finance / Fintech">Finance & Fintech</option>
                        <option value="Logistics / Supply Chain">Logistics & Supply Chain</option>
                        <option value="Education / EdTech">Education & EdTech</option>
                        <option value="Agency / Professional Services">Agency & Professional Services</option>
                        <option value="Other">Other Industry</option>
                    </select>
                </div>

                <button type="button" @onclick="NextStep" disabled="@(string.IsNullOrWhiteSpace(BusinessName) || string.IsNullOrWhiteSpace(BusinessIndustry))" class="onboard-btn" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);">
                    <span>Next: Objectives</span>
                </button>
            }
            else if (CurrentStep == 2)
            {
                <!-- Step 2: Target & Objectives -->
                <div class="form-group">
                    <label class="form-label" for="description">What does your business do?</label>
                    <textarea id="description" @bind="BusinessDescription" class="onboard-input onboard-textarea" placeholder="Describe your core product, services, and operations..." required></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label" for="audience">Who is your target audience or primary goal?</label>
                    <textarea id="audience" @bind="TargetAudience" class="onboard-input onboard-textarea" placeholder="E.g., B2B enterprise clients, local retail customers, maximizing system uptime..." required></textarea>
                </div>

                <div style="display: flex; gap: 1rem;">
                    <button type="button" @onclick="PrevStep" class="onboard-btn" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8; box-shadow: none;">
                        Back
                    </button>
                    
                    <button type="button" @onclick="NextStep" disabled="@(string.IsNullOrWhiteSpace(BusinessDescription) || string.IsNullOrWhiteSpace(TargetAudience))" class="onboard-btn" style="flex: 2; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);">
                        <span>Next: Social Channels</span>
                    </button>
                </div>
            }
            else
            {
                <!-- Step 3: Social Platform checklist -->
                <div class="form-group">
                    <label class="form-label">Select Social Platforms You Use</label>
                    <p style="color: #64748b; font-size: 0.85rem; margin-top: -0.25rem; margin-bottom: 1rem;">The Advisor agent will only draft recommendations for checked platforms.</p>
                    
                    <div style="display: flex; flex-direction: column; gap: 0.85rem; background: rgba(0,0,0,0.15); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.04);">
                        <div class="checkbox-row">
                            <input type="checkbox" id="chkLinkedIn" @bind="UseLinkedIn" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="chkLinkedIn" style="color: #cbd5e1; font-size: 0.95rem; cursor: pointer; user-select: none;">💼 LinkedIn</label>
                        </div>
                        
                        <div class="checkbox-row">
                            <input type="checkbox" id="chkTwitter" @bind="UseTwitter" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="chkTwitter" style="color: #cbd5e1; font-size: 0.95rem; cursor: pointer; user-select: none;">🐦 Twitter / X</label>
                        </div>

                        <div class="checkbox-row">
                            <input type="checkbox" id="chkInstagram" @bind="UseInstagram" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="chkInstagram" style="color: #cbd5e1; font-size: 0.95rem; cursor: pointer; user-select: none;">📸 Instagram</label>
                        </div>

                        <div class="checkbox-row">
                            <input type="checkbox" id="chkFacebook" @bind="UseFacebook" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="chkFacebook" style="color: #cbd5e1; font-size: 0.95rem; cursor: pointer; user-select: none;">👥 Facebook</label>
                        </div>

                        <div class="checkbox-row">
                            <input type="checkbox" id="chkYouTube" @bind="UseYouTube" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="chkYouTube" style="color: #cbd5e1; font-size: 0.95rem; cursor: pointer; user-select: none;">🎥 YouTube Video Context</label>
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                    <button type="button" @onclick="PrevStep" class="onboard-btn" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8; box-shadow: none; margin-top: 0;">
                        Back
                    </button>
                    
                    <button type="submit" disabled="@IsSubmitting" class="onboard-btn" style="flex: 2; margin-top: 0;">
                        @if (IsSubmitting)
                        {
                            <span style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1rem; height: 1rem; border-width: 0.15em;"></span>
                                Initializing Core...
                            </span>
                        }
                        else
                        {
                            <span>Launch Workspace</span>
                        }
                    </button>
                </div>
            }
        </form>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<UserBusinessProfile> OnOnboardingSuccess { get; set; }

    private int CurrentStep { get; set; } = 1;
    private string BusinessName { get; set; } = string.Empty;
    private string BusinessIndustry { get; set; } = string.Empty;
    private string BusinessDescription { get; set; } = string.Empty;
    private string TargetAudience { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; } = false;

    // Platform checklist states
    private bool UseInstagram { get; set; } = true;
    private bool UseLinkedIn { get; set; } = true;
    private bool UseFacebook { get; set; } = false;
    private bool UseTwitter { get; set; } = true;
    private bool UseYouTube { get; set; } = false;

    private void NextStep()
    {
        if (CurrentStep == 1)
        {
            CurrentStep = 2;
        }
        else if (CurrentStep == 2)
        {
            CurrentStep = 3;
        }
    }

    private void PrevStep()
    {
        if (CurrentStep == 2)
        {
            CurrentStep = 1;
        }
        else if (CurrentStep == 3)
        {
            CurrentStep = 2;
        }
    }

    private async Task HandleSubmit()
    {
        if (IsSubmitting) return;

        var user = AuthService.CurrentUser;
        if (user == null)
        {
            ErrorMessage = "No active user session detected.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = string.Empty;

        try
        {
            var selectedList = new List<string>();
            if (UseLinkedIn) selectedList.Add("LinkedIn");
            if (UseTwitter) selectedList.Add("Twitter");
            if (UseInstagram) selectedList.Add("Instagram");
            if (UseFacebook) selectedList.Add("Facebook");
            if (UseYouTube) selectedList.Add("YouTube");

            string selectedPlatforms = selectedList.Any() ? string.Join(";", selectedList) : "LinkedIn;Twitter";

            var profile = new UserBusinessProfile(
                user.LocalId,
                BusinessName,
                BusinessIndustry,
                BusinessDescription,
                TargetAudience,
                DateTime.UtcNow,
                selectedPlatforms
            );

            await ProfileService.SaveProfileAsync(profile);
            await OnOnboardingSuccess.InvokeAsync(profile);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save business profile: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
