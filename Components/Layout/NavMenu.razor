@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (IsCollapsed)
        {
            <a class="navbar-brand brand-collapsed" href="dashboard" aria-label="Agentic System">🤖</a>
        }
        else
        {
            <a class="navbar-brand gradient-brand-text" href="dashboard">Humanic Agents </a>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- Dashboard (always top-level) -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All" title="Dashboard">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
                <span class="nav-text">Dashboard</span>
            </NavLink>
        </div>

        <!-- Group: Agents -->
        <div class="nav-group">
            <button class="nav-group-header @(IsAgentsActive() ? "active-parent" : "")" @onclick='() => ToggleGroup("agents")' @onclick:stopPropagation title="Agents">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span class="nav-text">Agents</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon @(isAgentsExpanded ? "rotated" : "")"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <div class="nav-group-items @(isAgentsExpanded ? "show" : "")">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ceo-office" title="CEO Office">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
                        <span class="nav-text">CEO Office</span>
                    </NavLink>
                </div>
                 <div class="nav-item px-3">
                    <NavLink class="nav-link" href="leads-center" title="Leads Center">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                        <span class="nav-text">Leads Center</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="manager-suite" title="Manager Suite">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
                        <span class="nav-text">Manager Suite</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="social-media-posts" title="Social Advisor">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        <span class="nav-text">Social Advisor</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="documents-agent" title="Documents Agent">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span class="nav-text">Documents Agent</span>
                    </NavLink>
                </div>
            </div>
        </div>

        <!-- Group: Knowledge -->
        <div class="nav-group">
            <button class="nav-group-header @(IsKnowledgeActive() ? "active-parent" : "")" @onclick='() => ToggleGroup("knowledge")' @onclick:stopPropagation title="Knowledge">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
                <span class="nav-text">Knowledge</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon @(isKnowledgeExpanded ? "rotated" : "")"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <div class="nav-group-items @(isKnowledgeExpanded ? "show" : "")">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="knowledgebase" title="Knowledgebase">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span class="nav-text">Knowledgebase</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="search-results" title="Search Insights">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <span class="nav-text">Search Insights</span>
                    </NavLink>
                </div>
            </div>
        </div>

        <!-- Group: Tooling -->
        <div class="nav-group">
            <button class="nav-group-header @(IsToolingActive() ? "active-parent" : "")" @onclick='() => ToggleGroup("tooling")' @onclick:stopPropagation title="Tooling">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                <span class="nav-text">Tooling</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon @(isToolingExpanded ? "rotated" : "")"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <div class="nav-group-items @(isToolingExpanded ? "show" : "")">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="video-ads" title="Video Ads">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                        <span class="nav-text">Video Ads</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="image-posters" title="Image Posters">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        <span class="nav-text">Image Posters</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="business-visuals" title="Business Visuals">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
                        <span class="nav-text">Business Visuals</span>
                    </NavLink>
                </div>
            </div>
        </div>

        <!-- Billing & Usage -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="billing" title="Billing & Subscriptions">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                <span class="nav-text">Billing & Plans</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    private bool isAgentsExpanded { get; set; }
    private bool isKnowledgeExpanded { get; set; }
    private bool isToolingExpanded { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ExpandActiveGroup();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExpandActiveGroup();
        StateHasChanged();
    }

    private void ExpandActiveGroup()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativePath.Split('?')[0].Trim('/');

        if (path == "ceo-office" || path == "manager-suite" || path == "social-media-posts" || path == "leads-center" || path == "documents-agent")
        {
            isAgentsExpanded = true;
        }
        else if (path == "knowledgebase" || path == "search-results")
        {
            isKnowledgeExpanded = true;
        }
        else if (path == "video-ads" || path == "image-posters" || path == "business-visuals")
        {
            isToolingExpanded = true;
        }
    }

    private bool IsAgentsActive()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativePath.Split('?')[0].Trim('/');
        return path == "ceo-office" || path == "manager-suite" || path == "social-media-posts" || path == "leads-center" || path == "documents-agent";
    }

    private bool IsKnowledgeActive()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativePath.Split('?')[0].Trim('/');
        return path == "knowledgebase" || path == "search-results";
    }

    private bool IsToolingActive()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativePath.Split('?')[0].Trim('/');
        return path == "video-ads" || path == "image-posters" || path == "business-visuals";
    }

    private async Task ToggleGroup(string group)
    {
        if (IsCollapsed)
        {
            await OnToggleCollapse.InvokeAsync();
            if (group == "agents") isAgentsExpanded = true;
            else if (group == "knowledge") isKnowledgeExpanded = true;
            else if (group == "tooling") isToolingExpanded = true;
        }
        else
        {
            if (group == "agents") isAgentsExpanded = !isAgentsExpanded;
            else if (group == "knowledge") isKnowledgeExpanded = !isKnowledgeExpanded;
            else if (group == "tooling") isToolingExpanded = !isToolingExpanded;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

