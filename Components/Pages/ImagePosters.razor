@page "/image-posters"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseSearchSocialService SearchSocialService
@inject ImagePosterGeneratorService PosterAgent
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Poster Campaigns - Agentic OS</PageTitle>

<script>
    window.downloadFileFromUrl = async function(url, fileName) {
        try {
            const response = await fetch(url);
            const blob = await response.blob();
            const localUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = localUrl;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(localUrl);
        } catch (err) {
            console.error("Failed to download file:", err);
            window.open(url, '_blank');
        }
    }
</script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .dashboard-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0f172a 50%, #020617 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow: 0 10px 30px 0 rgba(0, 0, 0, 0.3);
        padding: 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-panel:hover {
        box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.4);
    }

    .gradient-text {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-info-custom {
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .pulse-blue {
        background-color: #38bdf8;
        box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7);
        animation: pulseBlue 2s infinite;
    }

    @@keyframes pulseBlue {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(56, 189, 248, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
    }

    .btn-action {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5);
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    }

    .btn-action:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-copy {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
    }

    .btn-copy:hover {
        background: rgba(56, 189, 248, 0.1);
        border-color: rgba(56, 189, 248, 0.3);
        color: #38bdf8;
    }

    .sidebar-item {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .sidebar-item:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.12);
        transform: translateY(-1px);
    }

    .sidebar-item.active {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.35);
        box-shadow: 0 4px 15px rgba(56, 189, 248, 0.1);
    }

    .detail-label {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #38bdf8;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 0.35rem;
    }

    .detail-val {
        color: #cbd5e1;
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .prompt-box {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #38bdf8;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(56, 189, 248, 0.25);
        padding: 1rem;
        border-radius: 10px;
        white-space: pre-wrap;
        line-height: 1.5;
    }

    .grid-board {
        display: grid;
        grid-template-columns: 1fr 2.5fr;
        gap: 2rem;
    }

    @@media (max-width: 992px) {
        .grid-board {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-container">
    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text" style="margin: 0; font-size: 2.5rem;">Image Poster Blueprints</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1.1rem;">AI-architected marketing graphics designs, copy headings, and generation prompts</p>
        </div>
        
        <div class="badge-status badge-info-custom">
            <span class="pulse-dot pulse-blue"></span>
            Agent: Design Director
        </div>
    </header>

    @if (IsGenerating)
    {
        <div class="glass-panel" style="text-align: center; padding: 6rem 2rem; margin-bottom: 2rem;">
            <div class="spinner-border text-primary" role="status" style="width: 4.5rem; height: 4.5rem; border-width: 0.35em; color: #38bdf8 !important;"></div>
            <h3 style="margin-top: 2rem; color: #38bdf8; font-weight: 700; font-size: 1.5rem;">Designing Poster Blueprint Layers</h3>
            <p style="color: #cbd5e1; max-width: 550px; margin: 0.75rem auto 0 auto; line-height: 1.6;">
                The Image Poster Agent is reviewing the social context, formatting overlay copy overlays, selecting color theme guidelines, and scripting an optimized AI image generator prompt...
            </p>
        </div>
    }

    <div class="grid-board">
        <!-- Sidebar - List of Posters -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="glass-panel" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
                <h3 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; gap: 0.5rem;">
                    🖼️ Poster Concepts
                </h3>

                @if (PostersList == null)
                {
                    <div style="text-align: center; padding: 2rem 0;">
                        <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                        <p style="color: #64748b; font-size: 0.85rem; margin-top: 0.75rem;">Loading blueprints...</p>
                    </div>
                }
                else if (!PostersList.Any())
                {
                    <div style="text-align: center; padding: 2rem 1rem; background: rgba(0,0,0,0.15); border-radius: 12px; border: 1px solid rgba(255,255,255,0.03);">
                        <div style="font-size: 2.25rem; margin-bottom: 0.5rem;">🎨</div>
                        <h4 style="color: #cbd5e1; margin-bottom: 0.25rem; font-size: 0.95rem;">No Active Layouts</h4>
                        <p style="color: #64748b; font-size: 0.8rem; line-height: 1.4; margin: 0;">
                            Create graphic poster concepts from your social Advisor cards first.
                        </p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 0.85rem; max-height: 500px; overflow-y: auto; padding-right: 0.25rem;">
                        @foreach (var poster in PostersList)
                        {
                            var currentPoster = poster;
                            <div class="sidebar-item @(SelectedPoster?.Id == currentPoster.Id ? "active" : "")"
                                 @onclick="() => SelectedPoster = currentPoster">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
                                    <strong style="color: #f1f5f9; font-size: 0.95rem; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; max-width: 170px;">
                                        @currentPoster.Title
                                    </strong>
                                    <span style="font-size: 0.75rem; background: rgba(255,255,255,0.08); padding: 0.15rem 0.45rem; border-radius: 4px; color: #38bdf8; font-weight: 600;">
                                        @currentPoster.Platform
                                    </span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">
                                    <span>Template</span>
                                    <span>@currentPoster.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Pro-tip card -->
            <div class="glass-panel" style="padding: 1.5rem; background: rgba(56, 189, 248, 0.02); border-color: rgba(56, 189, 248, 0.12); display: flex; flex-direction: column; gap: 0.85rem;">
                <h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #38bdf8;">💡 Graphic Tip</h4>
                <p style="color: #94a3b8; font-size: 0.8rem; line-height: 1.5; margin: 0;">
                    Copy the optimized **AI image prompt** and paste it directly into DALL-E 3, Midjourney, or Gemini to generate high-resolution central visuals matching this theme context.
                </p>
            </div>
        </div>

        <!-- Main Workspace - Detail Board -->
        <div>
            @if (SelectedPoster == null)
            {
                <div class="glass-panel" style="text-align: center; padding: 6rem 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                    <div style="font-size: 4rem; margin-bottom: 1.5rem;">🎨</div>
                    <h3 style="color: #cbd5e1; font-weight: 700;">Select Campaign to View Layout</h3>
                    <p style="color: #64748b; max-width: 420px; margin: 0.5rem auto 0 auto; line-height: 1.5; font-size: 0.95rem;">
                        Pick a generated poster script layout from the left sidebar list to view style specifications, overlay copies, and copyable prompts.
                    </p>
                </div>
            }
            else
            {
                <div class="glass-panel" style="display: flex; flex-direction: column; gap: 2rem;">
                    <!-- Detail Header -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                                <h2 style="margin: 0; font-weight: 800; font-size: 1.6rem; color: #f8fafc;">@SelectedPoster.Title</h2>
                                <span style="font-size: 0.8rem; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; padding: 0.2rem 0.6rem; border-radius: 9999px; font-weight: 600;">
                                    @SelectedPoster.Platform Poster
                                </span>
                            </div>
                            <p style="color: #94a3b8; font-size: 0.95rem; margin: 0; line-height: 1.5;">
                                Created: @SelectedPoster.CreatedAt.ToLocalTime().ToString("g")
                            </p>
                        </div>

                        <div style="display: flex; gap: 0.75rem;">
                            @if (!string.IsNullOrEmpty(SelectedPoster.ImageUrl))
                            {
                                <button type="button" class="btn-action" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);" 
                                        @onclick="GenerateImageDirectly" disabled="@IsGeneratingImage">
                                    🔄 Regenerate Graphic
                                </button>
                            }
                            <button type="button" class="btn-action" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);" @onclick="() => DeletePoster(SelectedPoster.Id)">
                                Delete Poster
                            </button>
                        </div>
                    </div>

                    <!-- Visual Workspace Grid -->
                    <div style="display: grid; grid-template-columns: 1.1fr 1.3fr; gap: 2.5rem; align-items: start; flex-wrap: wrap;">
                        <!-- Left Mockup Canvas Box -->
                        <div>
                            <span class="detail-label" style="margin-bottom: 0.75rem;">👀 Layout Mockup Visualizer</span>
                            
                            <div style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%); border: 2px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 2.25rem; aspect-ratio: 1 / 1.4; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.55);">
                                <!-- Glow nodes -->
                                <div style="position: absolute; top: -50px; right: -50px; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(#38bdf8, transparent); opacity: 0.18; filter: blur(20px);"></div>
                                <div style="position: absolute; bottom: -50px; left: -50px; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(#c084fc, transparent); opacity: 0.18; filter: blur(20px);"></div>
                                
                                <!-- Brand Header -->
                                <div style="display: flex; justify-content: space-between; align-items: center; z-index: 2;">
                                    <span style="font-size: 0.75rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.12em;">
                                        @UserProfile?.BusinessName
                                    </span>
                                    <span style="font-size: 0.65rem; background: rgba(255,255,255,0.08); padding: 0.2rem 0.5rem; border-radius: 4px; color: #cbd5e1; font-weight: 600;">
                                        @SelectedPoster.Platform Ad
                                    </span>
                                </div>

                                <!-- Graphic visual placeholder, actual generated image, or loading spinner -->
                                @if (IsGeneratingImage)
                                {
                                    <div style="background: rgba(15,23,42,0.6); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 10px; margin: 1.5rem 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; text-align: center; gap: 0.75rem; z-index: 2;">
                                        <div class="spinner-border text-info" role="status" style="width: 2rem; height: 2rem; color: #38bdf8 !important;"></div>
                                        <strong style="font-size: 0.85rem; color: #38bdf8; display: block;">Generating Graphic via Gemini...</strong>
                                        <span style="font-size: 0.7rem; color: #64748b; line-height: 1.4;">Waiting for AI image prediction and storage upload...</span>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(SelectedPoster.ImageUrl))
                                {
                                    <div style="margin: 1.25rem 0; flex: 1; border-radius: 10px; overflow: hidden; position: relative; z-index: 2; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 4px 15px rgba(0,0,0,0.3); display: flex; flex-direction: column;">
                                        <img src="@SelectedPoster.ImageUrl" style="width: 100%; height: 100%; object-fit: cover; flex: 1; min-height: 0;" alt="Generated Poster Graphic" />
                                        
                                        <!-- Download button container overlay -->
                                        <div style="position: absolute; bottom: 8px; right: 8px; display: flex; gap: 0.5rem; z-index: 10;">
                                            <button type="button" class="btn-copy" style="background: rgba(15, 23, 42, 0.85); border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; font-size: 0.75rem; padding: 0.35rem 0.65rem;" 
                                                    @onclick="@(() => DownloadImage(SelectedPoster.ImageUrl, SelectedPoster.Title + ".png"))">
                                                📥 Download Graphic
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="background: rgba(15,23,42,0.6); border: 1px dashed rgba(255,255,255,0.15); border-radius: 10px; margin: 1.5rem 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; text-align: center; gap: 0.5rem; z-index: 2;">
                                        <span style="font-size: 1.75rem;">🎨</span>
                                        <strong style="font-size: 0.85rem; color: #cbd5e1; display: block;">Central Graphic Layer</strong>
                                        <p style="font-size: 0.7rem; color: #64748b; margin: 0; line-height: 1.4; padding: 0 0.5rem; margin-bottom: 0.75rem;">
                                            No visual generated. Generate a tailored poster graphic using Gemini.
                                        </p>
                                        <button type="button" class="btn-action" style="font-size: 0.75rem; padding: 0.45rem 1.15rem;" 
                                                @onclick="GenerateImageDirectly">
                                            🎨 Generate Graphic Visual
                                        </button>
                                    </div>
                                }

                                <!-- Text Overlay overlays -->
                                <div style="text-align: center; z-index: 2; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;">
                                    <h2 style="font-weight: 800; font-size: 1.55rem; line-height: 1.25; background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-shadow: 0 4px 10px rgba(0,0,0,0.6); margin: 0;">
                                        @SelectedPoster.PrimaryHeadline
                                    </h2>
                                    <p style="color: #94a3b8; font-size: 0.8rem; line-height: 1.5; margin: 0; padding: 0 0.5rem;">
                                        @SelectedPoster.BodyCopy
                                    </p>
                                </div>

                                <!-- CTA button mockup -->
                                <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1rem; text-align: center; z-index: 2;">
                                    <span style="font-size: 0.75rem; color: #38bdf8; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; display: inline-block; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); padding: 0.4rem 1.25rem; border-radius: 6px;">
                                        @SelectedPoster.CallToAction
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Detail Panel -->
                        <div style="display: flex; flex-direction: column; gap: 1.75rem;">
                            <!-- Visual Design specs -->
                            <div>
                                <span class="detail-label">🎨 Visual Theme Guidelines</span>
                                <p class="detail-val" style="background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.04);">
                                    @SelectedPoster.VisualTheme
                                </p>
                            </div>

                            <!-- Typography and Copy Elements -->
                            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                                        <span class="detail-label">✍️ Headline Copy</span>
                                        <button class="btn-copy" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" @onclick="() => CopyToClipboard(SelectedPoster.PrimaryHeadline)">Copy</button>
                                    </div>
                                    <p class="detail-val" style="font-weight: 700; color: #f1f5f9; font-size: 1.1rem; margin: 0;">@SelectedPoster.PrimaryHeadline</p>
                                </div>

                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                                        <span class="detail-label">📝 Supporting Body Text</span>
                                        <button class="btn-copy" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" @onclick="() => CopyToClipboard(SelectedPoster.BodyCopy)">Copy</button>
                                    </div>
                                    <p class="detail-val" style="margin: 0;">@SelectedPoster.BodyCopy</p>
                                </div>

                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                                        <span class="detail-label">📣 Call to Action (CTA)</span>
                                        <button class="btn-copy" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" @onclick="() => CopyToClipboard(SelectedPoster.CallToAction)">Copy</button>
                                    </div>
                                    <p class="detail-val" style="margin: 0; font-weight: 600;">@SelectedPoster.CallToAction</p>
                                </div>
                            </div>

                            <!-- Image Generator Prompt box -->
                            <div style="border-top: 1px solid rgba(255,255,255,0.06); padding-top: 1.5rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <span class="detail-label" style="color: #a78bfa;">🚀 AI Image Generation Prompt</span>
                                    <button class="btn-copy" style="background: rgba(167, 139, 250, 0.1); border-color: rgba(167, 139, 250, 0.25); color: #c084fc;" @onclick="() => CopyToClipboard(SelectedPoster.ImagePrompt)">
                                        Copy Prompt
                                    </button>
                                </div>
                                <div class="prompt-box">@SelectedPoster.ImagePrompt</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    private List<ImagePosterDetail>? PostersList { get; set; }
    private ImagePosterDetail? SelectedPoster { get; set; }
    private bool IsGenerating { get; set; } = false;
    private bool IsGeneratingImage { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPosterData();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("platform", out var platformVal) && 
            query.TryGetValue("content", out var contentVal) && 
            query.TryGetValue("guidance", out var guidanceVal))
        {
            var platform = platformVal.ToString();
            var content = contentVal.ToString();
            var guidance = guidanceVal.ToString();

            Navigation.NavigateTo("/image-posters", replace: true);

            await TriggerImmediateGeneration(platform, content, guidance);
        }
    }

    private async Task LoadPosterData()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            PostersList = await SearchSocialService.GetImagePostersAsync(userId);
            if (SelectedPoster != null)
            {
                SelectedPoster = PostersList.FirstOrDefault(v => v.Id == SelectedPoster.Id) ?? PostersList.FirstOrDefault();
            }
            else
            {
                SelectedPoster = PostersList.FirstOrDefault();
            }
        }
    }

    private async Task TriggerImmediateGeneration(string platform, string content, string guidance)
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsGenerating = true;
        StateHasChanged();

        try
        {
            var generatedPoster = await PosterAgent.GenerateImagePosterAsync(
                userId, 
                UserProfile, 
                platform, 
                content, 
                guidance
            );

            await LoadPosterData();
            SelectedPoster = PostersList?.FirstOrDefault(v => v.Id == generatedPoster.Id) ?? generatedPoster;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to execute immediate poster generation: {ex.Message}");
        }
        finally
        {
            IsGenerating = false;
            StateHasChanged();
        }
    }

    private async Task DeletePoster(string id)
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null) return;

        try
        {
            bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this marketing poster concept?");
            if (confirm)
            {
                await SearchSocialService.DeleteImagePosterAsync(userId, id);
                await LoadPosterData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to delete poster: {ex.Message}");
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy to clipboard: {ex.Message}");
        }
    }

    private async Task GenerateImageDirectly()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || SelectedPoster == null) return;

        IsGeneratingImage = true;
        StateHasChanged();

        try
        {
            var imageUrl = await PosterAgent.GenerateAndSaveImageOnlyAsync(userId, SelectedPoster);
            SelectedPoster = SelectedPoster with { ImageUrl = imageUrl };
            await LoadPosterData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to generate image directly: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Image generation failed: {ex.Message}");
        }
        finally
        {
            IsGeneratingImage = false;
            StateHasChanged();
        }
    }

    private async Task DownloadImage(string url, string fileName)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("downloadFileFromUrl", url, fileName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to initiate file download: {ex.Message}");
            Navigation.NavigateTo(url, forceLoad: true);
        }
    }
}
