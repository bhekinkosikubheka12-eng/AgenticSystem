@page "/ceo-office"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseSearchSocialService SearchSocialService
@inject ChatSessionService SessionService
@inject CeoAgentOrchestrator CeoOrchestrator
@inject DataAnalystAgentOrchestrator AnalystOrchestrator
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>CEO Office - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .ceo-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0c0f1d 60%, #020617 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2rem;
        display: flex;
        flex-direction: column;
    }

    .gradient-text-gold {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-ceo {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.25);
        color: #fbbf24;
    }

    /* Chat layout wrappers */
    .chat-interface-wrapper {
        display: flex;
        gap: 1.5rem;
        height: calc(100vh - 11rem);
        min-height: 550px;
        position: relative;
    }

    .session-sidebar {
        width: 260px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(251, 191, 36, 0.15); /* Gold border */
        border-radius: 16px;
        padding: 1.25rem;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .session-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        overflow-y: auto;
        flex: 1;
        padding-right: 0.25rem;
    }

    .session-item {
        padding: 0.75rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .session-item:hover {
        background: rgba(245, 158, 11, 0.08);
        border-color: rgba(245, 158, 11, 0.2);
    }

    .session-item.active {
        background: rgba(245, 158, 11, 0.15);
        border-color: #fbbf24;
    }

    .session-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .session-date {
        font-size: 0.7rem;
        color: #64748b;
        margin-top: 0.25rem;
    }

    .btn-new-session {
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        border: none;
        color: #0f172a;
        padding: 0.65rem;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
    }

    .btn-new-session:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4);
    }

    .chat-pane {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: rgba(15, 23, 42, 0.35);
        border: 1px solid rgba(251, 191, 36, 0.15); /* Sleek gold border */
        border-radius: 16px;
        overflow: hidden;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .chat-pane:hover {
        box-shadow: 0 15px 35px rgba(251, 191, 36, 0.05);
    }

    .chat-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        scroll-behavior: smooth;
    }

    /* Message rows and bubbles */
    .message-row {
        display: flex;
        width: 100%;
    }

    .message-row.user-row {
        justify-content: flex-end;
    }

    .message-row.agent-row {
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 80%;
        padding: 1rem 1.25rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .user-bubble {
        background: linear-gradient(135deg, #d97706 0%, #1e1b4b 100%);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 16px 16px 2px 16px;
        color: #f8fafc;
    }

    .agent-bubble {
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px 16px 16px 2px;
        color: #f8fafc;
        transition: border-left 0.2s ease;
    }

    .agent-bubble.directive-completed {
        border-left: 4px solid #10b981;
    }

    .agent-bubble.directive-progress {
        border-left: 4px solid #38bdf8;
    }

    .agent-bubble.directive-pending {
        border-left: 4px solid #fbbf24;
    }

    .bubble-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .user-bubble .bubble-meta {
        justify-content: flex-end;
        color: #fde047;
    }

    .bubble-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
        font-weight: bold;
    }

    .user-avatar {
        background: #fbbf24;
        color: #0f172a;
    }

    .agent-avatar {
        background: rgba(129, 140, 248, 0.2);
        border: 1px solid rgba(129, 140, 248, 0.4);
        color: #818cf8;
    }

    .code-block {
        font-family: 'JetBrains Mono', monospace;
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 1rem;
        border-radius: 8px;
        color: #cbd5e1;
        font-size: 0.85rem;
        overflow-x: auto;
        margin-top: 0.5rem;
        white-space: pre-wrap;
    }

    /* Chat Footer & Inputs */
    .chat-footer {
        padding: 1.25rem;
        background: rgba(15, 23, 42, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .suggestions-bar {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .suggestion-tag {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        color: #94a3b8;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
    }

    .suggestion-tag:hover {
        background: rgba(245, 158, 11, 0.1);
        border-color: rgba(245, 158, 11, 0.3);
        color: #fbbf24;
        transform: translateY(-1px);
    }

    .chat-input-row {
        display: flex;
        align-items: center;
        position: relative;
        width: 100%;
    }

    .chat-input-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .chat-input-field {
        width: 100%;
        padding: 0.85rem 3.5rem 0.85rem 1.2rem;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(2, 6, 17, 0.75);
        color: white;
        font-size: 1rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .chat-input-field:focus {
        border-color: #fbbf24;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    }

    .inline-send-btn {
        position: absolute;
        right: 0.5rem;
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        border: none;
        color: #0f172a;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
    }

    .inline-send-btn:hover:not(:disabled) {
        transform: scale(1.05);
        background: linear-gradient(135deg, #fcd34d 0%, #fbbf24 100%);
    }

    .inline-send-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: rgba(255, 255, 255, 0.05);
        color: #475569;
        box-shadow: none;
    }

    /* Diagnostics Sidebar drawer */
    .chat-sidebar {
        width: 320px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .chat-sidebar.collapsed {
        width: 0;
        margin: 0;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .sidebar-toggle-trigger {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #94a3b8;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .sidebar-toggle-trigger:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #f8fafc;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(251, 191, 36, 0.15); /* Sleek gold border */
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        padding: 1.5rem;
    }

    /* Filter Bar Styles */
    .filter-select {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #cbd5e1;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        outline: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .filter-select:focus {
        border-color: #fbbf24;
    }

    .filter-date-input {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #cbd5e1;
        padding: 0.35rem 0.5rem;
        font-size: 0.8rem;
        outline: none;
    }

    /* Responsive media queries */
    @@media (max-width: 1024px) {
        .chat-interface-wrapper {
            flex-direction: column;
            height: auto;
        }

        .chat-pane {
            height: calc(100vh - 14rem);
            min-height: 480px;
        }

        .chat-sidebar {
            width: 100%;
        }

        .chat-sidebar.collapsed {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .ceo-container {
            padding: 1rem !important;
        }

        .dashboard-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 1rem !important;
            padding-bottom: 1rem !important;
            margin-bottom: 1.5rem !important;
        }

        .dashboard-title {
            font-size: 1.6rem !important;
        }

        .chat-pane {
            height: calc(100vh - 15rem);
            min-height: 400px;
        }

        .message-bubble {
            max-width: 90% !important;
        }
    }
</style>

<div class="ceo-container">
    <!-- Header -->
    <header class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text-gold dashboard-title" style="margin: 0; font-size: 2.2rem;">CEO Executive Suite</h1>
            <p class="dashboard-subtitle" style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1rem;">Strategic decision making room and high-level corporate directorship</p>
        </div>
        
        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <div class="badge-status badge-ceo">
                👑 CEO Command Center
            </div>

            <!-- Toggle Diagnostics Sidebar -->
            <button class="sidebar-toggle-trigger" @onclick="ToggleDiagnostics" title="Toggle Identity Sidebar">
                @if (isSidebarOpen)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="15" y1="3" x2="15" y2="21"></line></svg>
                }
            </button>
        </div>
    </header>

    <div class="chat-interface-wrapper">
        <!-- Sessions Sidebar (Left) -->
        <div class="session-sidebar">
            <button class="btn-new-session" @onclick="CreateNewSession">
                + New Chat
            </button>
            <div class="session-list">
                @foreach (var session in Sessions)
                {
                    <div class="session-item @(ActiveSession?.Id == session.Id ? "active" : "")" @onclick="() => SelectSession(session)">
                        <div class="session-title" title="@session.Title">@session.Title</div>
                        <div class="session-date">@session.CreatedAt.ToLocalTime().ToString("g")</div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Chat Pane -->
        <div class="chat-pane">
            <!-- Filter Bar -->
            <div class="chat-filter-bar" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(15, 23, 42, 0.4); flex-wrap: wrap;">
                <span style="font-size: 0.85rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.25rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    History Filter:
                </span>
                <select @bind="SelectedFilter" @bind:after="OnFilterChanged" class="filter-select">
                    <option value="all">All History</option>
                    <option value="today">Today</option>
                    <option value="yesterday">Yesterday</option>
                    <option value="week">This Week</option>
                    <option value="custom">Custom Date Range</option>
                </select>

                @if (SelectedFilter == "custom")
                {
                    <div style="display: inline-flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <input type="date" @bind="CustomStartDate" @bind:after="StateHasChanged" class="filter-date-input" />
                        <span style="color: #64748b; font-size: 0.8rem;">to</span>
                        <input type="date" @bind="CustomEndDate" @bind:after="StateHasChanged" class="filter-date-input" />
                    </div>
                }
            </div>

            <!-- Messages history -->
            <div class="chat-messages-container" id="chat-messages">
                @if (!Messages.Any())
                {
                    <div style="margin: auto; text-align: center; max-width: 450px; padding: 2rem;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">👑</div>
                        <h3 style="color: #cbd5e1; font-weight: 700; margin-bottom: 0.5rem;">CEO Executive Desk</h3>
                        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.5; margin: 0;">
                            No strategic directives issued yet. Enter a directive or select one of the executive suggestions below to begin.
                        </p>
                    </div>
                }
                else if (!GetFilteredMessages().Any())
                {
                    <div style="margin: auto; text-align: center; max-width: 450px; padding: 2rem;">
                        <div style="font-size: 2.5rem; margin-bottom: 1rem;">📅</div>
                        <h4 style="color: #cbd5e1; font-weight: 600; margin-bottom: 0.5rem;">No Directives In This Period</h4>
                        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.4; margin: 0;">
                            No directives match the chosen date filter. Try selecting 'All History' or a different date range.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var msg in GetFilteredMessages())
                    {
                        @if (msg.Sender == "User")
                        {
                            <!-- User (CEO) Prompt Bubble -->
                            <div class="message-row user-row">
                                <div class="message-bubble user-bubble">
                                    <div class="bubble-meta">
                                        <span>CEO Command</span>
                                        <div class="bubble-avatar user-avatar">👑</div>
                                    </div>
                                    <div style="font-size: 0.95rem; line-height: 1.5;">@msg.Text</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Response Bubble -->
                            <div class="message-row agent-row">
                                <div class="message-bubble agent-bubble @GetDirectiveStatusClass(msg.Status).ToLower()">
                                    <div class="bubble-meta">
                                        <div class="bubble-avatar agent-avatar">⚙️</div>
                                        <strong style="color: #fbbf24;">
                                            @(msg.AssignedTo == "User" ? "Data Analyst Summary" : "Manager Allocation Task")
                                        </strong>
                                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">(ID: @(msg.Id.Length > 8 ? msg.Id.Substring(0, 8) : msg.Id))</span>
                                        <span class="badge-status" style="background: @GetStatusBgColor(msg.Status); color: @GetStatusTextColor(msg.Status); font-size: 0.65rem; padding: 0.15rem 0.5rem; margin-left: auto;">
                                            @msg.Status
                                        </span>
                                    </div>
                                    
                                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                        <div class="code-block" style="border: none; margin-top: 0; background: rgba(15, 23, 42, 0.4); color: #cbd5e1; white-space: pre-wrap;">@msg.Text</div>
                                        
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.25rem; font-size: 0.75rem; color: #64748b;">
                                            <span>Assigned To: <strong style="color: #94a3b8;">@msg.AssignedTo</strong></span>
                                            <span style="font-family: 'JetBrains Mono', monospace;">
                                                @msg.Timestamp.ToLocalTime().ToString("g")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Footer input area -->
            <div class="chat-footer">
                <!-- Suggestions Floating Above Input -->
                <div class="suggestions-bar">
                    <button class="suggestion-tag" @onclick='() => ApplySuggestion("Explain what scaling trends are most critical for our industry and target audience?")'>
                        ❓ "Explain critical scaling trends for our sector..."
                    </button>
                    <button class="suggestion-tag" @onclick='() => ApplySuggestion("Directive: Coordinate search query audit to identify 3 potential competitor names.")'>
                        💼 "Directive: Coordinate search query audit to find competitor names..."
                    </button>
                </div>

                <!-- Input bar row -->
                <div class="chat-input-row">
                    <div class="chat-input-wrapper">
                        <input @bind="DirectiveInput" @bind:event="oninput" @onkeypress="HandleKeyPress" placeholder="Type a directive or strategic query for the organization..." class="chat-input-field" disabled="@IsProcessing" />
                        <button @onclick="IssueDirective" disabled="@(IsProcessing || string.IsNullOrWhiteSpace(DirectiveInput))" class="inline-send-btn" title="Issue Directive">
                            @if (IsProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 1.1rem; height: 1.1rem; border-width: 0.15em; border-color: #0f172a;"></span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transform: rotate(45deg); margin-top: -2px; margin-right: 2px;"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar executive details (Right) -->
        <div class="chat-sidebar @(isSidebarOpen ? "" : "collapsed")">
            <!-- Business Profile details -->
            @if (UserProfile != null)
            {
                <div class="glass-panel" style="padding: 1.5rem; border-color: rgba(245, 158, 11, 0.2); background: rgba(245, 158, 11, 0.01);">
                    <h4 style="margin-top: 0; color: #fbbf24; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
                        🏢 Business Identity
                    </h4>
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; color: #cbd5e1;">
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.75rem; text-transform: uppercase;">Company Name</strong>
                            <span style="font-size: 1rem; color: #38bdf8; font-weight: 700;">@UserProfile.BusinessName</span>
                        </div>
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.75rem; text-transform: uppercase;">Industry Sector</strong>
                            <span>@UserProfile.BusinessIndustry</span>
                        </div>
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.75rem; text-transform: uppercase;">Core Vision</strong>
                            <span style="display: block; max-height: 120px; overflow-y: auto; line-height: 1.4;">@UserProfile.BusinessDescription</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Corporate System Stats -->
            <div class="glass-panel" style="padding: 1.5rem;">
                <h4 style="margin-top: 0; color: #cbd5e1; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; font-size: 1.1rem;">
                    🌐 Executive Topology
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; color: #94a3b8;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, 0.02); padding-bottom: 0.4rem;">
                        <span>CEO Agent</span>
                        <span style="color: #fbbf24; font-weight: 600;">Active</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, 0.02); padding-bottom: 0.4rem;">
                        <span>Manager Agent</span>
                        <span style="color: #38bdf8; font-weight: 600;">Oversight Active</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, 0.02); padding-bottom: 0.4rem;">
                        <span>Data Analyst</span>
                        <span style="color: #2dd4bf; font-weight: 600;">Memory Cataloguer</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    private string DirectiveInput { get; set; } = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private List<CeoDirective> Directives { get; set; } = new();
    private bool isSidebarOpen { get; set; } = true;

    private string SelectedFilter { get; set; } = "all";
    private DateTime? CustomStartDate { get; set; }
    private DateTime? CustomEndDate { get; set; }

    // Chat sessions fields
    private List<ChatSession> Sessions { get; set; } = new();
    private ChatSession? ActiveSession { get; set; }
    private List<ChatMessage> Messages { get; set; } = new();

    private void OnFilterChanged()
    {
        if (SelectedFilter != "custom")
        {
            CustomStartDate = null;
            CustomEndDate = null;
        }
        else
        {
            CustomStartDate = DateTime.Today;
            CustomEndDate = DateTime.Today;
        }
        StateHasChanged();
    }

    private IEnumerable<ChatMessage> GetFilteredMessages()
    {
        var filtered = Messages.AsEnumerable();
        var today = DateTime.Today;

        switch (SelectedFilter.ToLower())
        {
            case "today":
                filtered = filtered.Where(m => m.Timestamp.ToLocalTime().Date == today);
                break;
            case "yesterday":
                var yesterday = today.AddDays(-1);
                filtered = filtered.Where(m => m.Timestamp.ToLocalTime().Date == yesterday);
                break;
            case "week":
                var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
                filtered = filtered.Where(m => m.Timestamp.ToLocalTime().Date >= startOfWeek && m.Timestamp.ToLocalTime().Date <= today);
                break;
            case "custom":
                if (CustomStartDate.HasValue)
                {
                    filtered = filtered.Where(m => m.Timestamp.ToLocalTime().Date >= CustomStartDate.Value.Date);
                }
                if (CustomEndDate.HasValue)
                {
                    filtered = filtered.Where(m => m.Timestamp.ToLocalTime().Date <= CustomEndDate.Value.Date);
                }
                break;
        }

        return filtered.OrderBy(m => m.Timestamp);
    }

    private Timer? RefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        // Refresh directives list periodically (every 5 seconds) to catch updates from the Manager Agent
        RefreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadDirectives();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UserProfile != null && Sessions.Count == 0)
        {
            await LoadSessionsAsync();
        }
    }

    private async Task LoadSessionsAsync()
    {
        if (UserProfile == null) return;
        Sessions = await SessionService.GetSessionsAsync(UserProfile.UserId, "Ceo");
        if (Sessions.Any())
        {
            await SelectSession(Sessions.First());
        }
        else
        {
            await CreateNewSession();
        }
    }

    private async Task SelectSession(ChatSession session)
    {
        ActiveSession = session;
        Messages = await SessionService.GetMessagesAsync(session.Id);
        await LoadDirectives();
        StateHasChanged();
    }

    private async Task CreateNewSession()
    {
        if (UserProfile == null) return;
        var title = $"Executive Meeting - {DateTime.Now:yyyy-MM-dd HH:mm}";
        var newSession = await SessionService.CreateSessionAsync(UserProfile.UserId, "Ceo", title);
        Sessions.Insert(0, newSession);
        await SelectSession(newSession);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "const el = document.getElementById('chat-messages'); if (el) el.scrollTop = el.scrollHeight;");
        }
        catch
        {
            // Ignore JS errors on prerendering or initialization
        }
    }

    private void ToggleDiagnostics()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private async Task LoadDirectives()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            Directives = await SearchSocialService.GetCeoDirectivesAsync(userId);

            // Sync status changes from Directives to Messages
            bool changed = false;
            foreach (var dir in Directives)
            {
                var msg = Messages.FirstOrDefault(m => m.Id == dir.Id);
                if (msg != null && (msg.Status != dir.Status || msg.Text != dir.AnswerText))
                {
                    msg.Status = dir.Status;
                    msg.Text = dir.AnswerText;
                    await SessionService.SaveMessageAsync(msg);
                    changed = true;
                }
            }
            if (changed)
            {
                StateHasChanged();
            }
        }
    }

    private void ApplySuggestion(string suggest)
    {
        DirectiveInput = suggest;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsProcessing && !string.IsNullOrWhiteSpace(DirectiveInput))
        {
            await IssueDirective();
        }
    }

    private async Task IssueDirective()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null || string.IsNullOrWhiteSpace(DirectiveInput) || ActiveSession == null) return;

        IsProcessing = true;
        StateHasChanged();

        try
        {
            var text = DirectiveInput;
            DirectiveInput = string.Empty;

            // Save user message to session
            var userMsg = new ChatMessage
            {
                Id = Guid.NewGuid().ToString("N"),
                SessionId = ActiveSession.Id,
                Sender = "User",
                Text = text,
                Timestamp = DateTime.UtcNow
            };
            Messages.Add(userMsg);
            await SessionService.SaveMessageAsync(userMsg);
            StateHasChanged();

            // 1. Fetch semantic memory summary context from Data Analyst Agent to guide CEO decisions
            string memorySummary = string.Empty;
            try
            {
                memorySummary = await AnalystOrchestrator.SearchMemoryInsightsAsync(text);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"CEO Analyst memory request failed: {ex.Message}");
            }

            // 2. Execute CEO Agent decision pipeline
            var result = await CeoOrchestrator.RunCeoDirectiveAsync(userId, text, UserProfile, memorySummary);

            // Save agent message to session
            var agentMsg = new ChatMessage
            {
                Id = result.Id,
                SessionId = ActiveSession.Id,
                Sender = "Agent",
                Text = result.AnswerText,
                AssignedTo = result.AssignedTo,
                Status = result.Status,
                Timestamp = result.Timestamp
            };
            Messages.Add(agentMsg);
            await SessionService.SaveMessageAsync(agentMsg);

            // 3. Reload list
            await LoadDirectives();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to issue CEO directive: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private string GetDirectiveStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "directive-completed",
            "In Progress" => "directive-progress",
            _ => "directive-pending"
        };
    }

    private string GetStatusBgColor(string status)
    {
        return status switch
        {
            "Completed" => "rgba(16, 185, 129, 0.15)",
            "In Progress" => "rgba(56, 189, 248, 0.15)",
            _ => "rgba(245, 158, 11, 0.15)"
        };
    }

    private string GetStatusTextColor(string status)
    {
        return status switch
        {
            "Completed" => "#34d399",
            "In Progress" => "#38bdf8",
            _ => "#fbbf24"
        };
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
