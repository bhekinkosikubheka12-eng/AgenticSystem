@page "/manager-suite"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseSearchSocialService SearchSocialService
@inject ManagerAgentOrchestrator ManagerOrchestrator
@inject DataAnalystAgentOrchestrator AnalystOrchestrator
@implements IDisposable

<PageTitle>Manager Console - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .mgr-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #0c1a30 0%, #0a0f1e 60%, #010409 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(56, 189, 248, 0.12);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        padding: 2rem;
        transition: all 0.3s ease;
    }

    .glass-panel:hover {
        box-shadow: 0 15px 35px rgba(56, 189, 248, 0.08);
    }

    .gradient-text-blue {
        background: linear-gradient(135deg, #38bdf8 0%, #2563eb 50%, #1d4ed8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-mgr {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: #38bdf8;
    }

    .btn-action {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        color: white;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(2, 132, 199, 0.4);
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    }

    .btn-action:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-mgr-run {
        background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
    }

    .btn-mgr-run:hover:not(:disabled) {
        background: linear-gradient(135deg, #c084fc 0%, #8b5cf6 100%);
        box-shadow: 0 6px 16px rgba(124, 58, 237, 0.4);
    }

    .btn-danger-custom {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #f87171;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-danger-custom:hover {
        background: #ef4444;
        color: white;
    }

    .custom-input {
        width: 100%;
        padding: 0.65rem 1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(15, 23, 42, 0.6);
        color: white;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-input:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
    }

    .score-badge {
        font-size: 1.5rem;
        font-weight: 800;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }

    .score-green {
        color: #10b981;
        background: rgba(16, 185, 129, 0.1);
        border-color: rgba(16, 185, 129, 0.2);
    }

    .score-amber {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.1);
        border-color: rgba(245, 158, 11, 0.2);
    }

    .code-block {
        font-family: 'JetBrains Mono', monospace;
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 0.85rem;
        border-radius: 8px;
        color: #cbd5e1;
        font-size: 0.85rem;
        overflow-x: auto;
        margin-top: 0.5rem;
        white-space: pre-wrap;
    }

    .review-card {
        background: rgba(15, 23, 42, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        gap: 1.25rem;
        align-items: center;
        transition: all 0.2s ease;
    }

    .review-card:hover {
        transform: translateY(-2px);
        border-color: rgba(56, 189, 248, 0.15);
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
    }

    @@media (max-width: 1024px) {
        .grid-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="mgr-container">
    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text-blue" style="margin: 0; font-size: 2.5rem;">Manager Operations Suite</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1.1rem;">Delegation monitoring, performance auditing, and Vector Analyst console</p>
        </div>
        
        <div class="badge-status badge-mgr">
            🛡️ Manager Suite Active
        </div>
    </header>

    <div class="grid-layout">
        <!-- Main Management column -->
        <div style="display: flex; flex-direction: column; gap: 2.5rem;">
            
            <!-- Pending Directives Section -->
            <div>
                <h3 style="margin-top: 0; color: #f1f5f9; font-weight: 700; font-size: 1.4rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    📥 Assigned CEO Orders
                </h3>
                
                @if (IsProcessing)
                {
                    <div class="glass-panel" style="text-align: center; padding: 4rem 1.5rem;">
                        <div class="spinner-border text-info" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 0.25em;"></div>
                        <h4 style="margin-top: 1.5rem; color: #38bdf8; font-weight: 700;">Manager Processing Pipelines</h4>
                        <p style="color: #94a3b8; max-width: 450px; margin: 0.5rem auto 0 auto;">
                            Delegating tasks to Search & Social Media working agents, monitoring output vectors, and compiling audit ratings...
                        </p>
                    </div>
                }
                else if (!Directives.Any(d => d.AssignedTo == "Manager"))
                {
                    <div class="glass-panel" style="text-align: center; padding: 2.5rem 1.5rem; background: rgba(30, 41, 59, 0.15);">
                        <p style="color: #64748b; font-style: italic; margin: 0;">No pending task orders received from CEO Office.</p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        @foreach (var dir in Directives.Where(d => d.AssignedTo == "Manager"))
                        {
                            <div class="directive-card" style="background: rgba(15,23,42,0.35); border-left: 4px solid @(dir.Status == "Completed" ? "#10b981" : (dir.Status == "In Progress" ? "#38bdf8" : "#fbbf24"));">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
                                    <div style="flex: 1;">
                                        <div style="font-size: 0.75rem; color: #64748b; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.35rem;">
                                            DIRECTIVE ID: @dir.Id.Substring(0, 8) | RECEIVED: @dir.Timestamp.ToLocalTime().ToString("g")
                                        </div>
                                        <p style="color: #cbd5e1; font-size: 0.95rem; margin: 0 0 0.5rem 0;">
                                            <strong style="color: #f1f5f9;">Strategic Goal:</strong> @dir.DirectiveText
                                        </p>
                                        <div style="font-size: 0.85rem; color: #94a3b8;">
                                            <strong>Manager Action Specification:</strong> @dir.AnswerText
                                        </div>
                                    </div>

                                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
                                        <span class="badge-status" style="background: @GetStatusBgColor(dir.Status); color: @GetStatusTextColor(dir.Status); font-size: 0.65rem; padding: 0.2rem 0.5rem;">
                                            @dir.Status
                                        </span>
                                        @if (dir.Status == "Pending")
                                        {
                                            <button class="btn-action btn-mgr-run" @onclick="() => ExecuteCeoDirective(dir.Id, dir.AnswerText)">
                                                Delegate & Run
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Agent Audits Section -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <h3 style="margin: 0; color: #f1f5f9; font-weight: 700; font-size: 1.4rem; display: flex; align-items: center; gap: 0.5rem;">
                        📋 Operations Audit Reports
                    </h3>
                    <button class="btn-action" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="TriggerManualAudit" disabled="@IsProcessing">
                        Re-Audit Now
                    </button>
                </div>

                <div class="glass-panel" style="display: flex; flex-direction: column; gap: 1.5rem;">
                    @if (LatestReport == null)
                    {
                        <p style="color: #64748b; font-style: italic; text-align: center; margin: 1rem 0;">No active performance reviews generated. Run working agents first.</p>
                    }
                    else
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.75rem;">
                            <span style="font-size: 0.85rem; color: #94a3b8;">Latest Audit Execution</span>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #38bdf8;">
                                @LatestReport.Timestamp.ToLocalTime().ToString("g")
                            </span>
                        </div>

                        @foreach (var review in LatestReport.Reviews)
                        {
                            var scoreClass = review.Score >= 85 ? "score-green" : (review.Score >= 50 ? "score-amber" : "");

                            <div class="review-card">
                                <div class="score-badge @scoreClass">
                                    @review.Score
                                </div>
                                <div style="flex: 1; display: flex; flex-direction: column; gap: 0.35rem;">
                                    <h4 style="margin: 0; color: #e2e8f0; font-size: 1.1rem; font-weight: 700;">@review.AgentName</h4>
                                    
                                    <div style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.4;">
                                        <strong style="color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; display: block; margin-bottom: 0.15rem;">Oversight Analysis</strong>
                                        @review.RelevanceAnalysis
                                    </div>
                                    <div style="font-size: 0.85rem; color: #c084fc; line-height: 1.4; margin-top: 0.25rem;">
                                        <strong style="color: #a78bfa; font-size: 0.75rem; text-transform: uppercase; display: block; margin-bottom: 0.15rem;">Optimization Directive</strong>
                                        @review.OptimizationStrategy
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Right Column (Data Analyst Memory Suite) -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Data Analyst Control Room -->
            <div class="glass-panel" style="border-color: rgba(45, 212, 191, 0.25); background: rgba(13, 148, 136, 0.01);">
                <h3 style="margin-top: 0; color: #2dd4bf; font-weight: 700; font-size: 1.3rem; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                    🧠 Data Analyst Memory Center
                </h3>

                <!-- Optimization Panel -->
                <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;">
                    <button class="btn-action" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%); width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.2);" @onclick="OptimizeMemoryIndex" disabled="@(IsAnalystRunning || IsProcessing)">
                        @if (IsAnalystRunning)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" style="width: 1rem; height: 1rem; border-width: 0.12em;"></span>
                            <span>Synthesizing index...</span>
                        }
                        else
                        {
                            <span>Optimize Memory Index</span>
                        }
                    </button>
                    
                    @if (!string.IsNullOrEmpty(AnalystInsightSummary))
                    {
                        <div>
                            <strong style="color: #2dd4bf; font-size: 0.8rem; text-transform: uppercase;">Analyst Synthesis:</strong>
                            <div class="code-block" style="font-size: 0.8rem; background: #022c22; color: #a7f3d0; border-color: rgba(13, 148, 136, 0.2);">@AnalystInsightSummary</div>
                        </div>
                    }
                </div>

                <!-- Add Custom Memory Form -->
                <div style="display: flex; flex-direction: column; gap: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem; margin-bottom: 1.5rem;">
                    <h5 style="color: #cbd5e1; margin: 0; font-size: 0.9rem; font-weight: 600;">Index New Vector Point</h5>
                    
                    <input type="text" @bind="NewMemoryTag" placeholder="Memory Semantic Tag (e.g. CompetitorTrend)..." class="custom-input" style="font-size: 0.85rem;" />
                    <textarea @bind="NewMemoryContent" placeholder="Enter key knowledge insight content..." class="custom-input" style="font-size: 0.85rem; height: 70px; resize: vertical;"></textarea>
                    
                    @if (!string.IsNullOrEmpty(AddMemoryMessage))
                    {
                        <div style="font-size: 0.8rem; color: #2dd4bf; text-align: center;">@AddMemoryMessage</div>
                    }

                    <button class="btn-action" style="padding: 0.5rem; font-size: 0.85rem; background: rgba(13, 148, 136, 0.2); border: 1px solid rgba(13, 148, 136, 0.4); color: #2dd4bf; box-shadow: none;" @onclick="AddMemoryItem" disabled="@(string.IsNullOrWhiteSpace(NewMemoryContent) || string.IsNullOrWhiteSpace(NewMemoryTag))">
                        Sync Vector Point
                    </button>
                </div>

                <!-- Catalog list -->
                <div style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem;">
                    <h5 style="color: #cbd5e1; margin: 0 0 0.75rem 0; font-size: 0.9rem; font-weight: 600; display: flex; justify-content: space-between;">
                        <span>Institutional Memory catalog</span>
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #2dd4bf;">@MemoryCatalog.Count items</span>
                    </h5>

                    <div style="max-height: 250px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.75rem; padding-right: 0.25rem;">
                        @if (!MemoryCatalog.Any())
                        {
                            <span style="font-size: 0.8rem; color: #64748b; font-style: italic;">Memory vector database is empty.</span>
                        }
                        else
                        {
                            @foreach (var item in MemoryCatalog)
                            {
                                <div style="background: rgba(0,0,0,0.15); padding: 0.75rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.02); display: flex; flex-direction: column; gap: 0.35rem;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <span style="font-size: 0.75rem; background: rgba(13, 148, 136, 0.15); border: 1px solid rgba(13, 148, 136, 0.3); color: #2dd4bf; padding: 0.15rem 0.35rem; border-radius: 4px; font-weight: 600;">
                                            @item.Tag
                                        </span>
                                        <button class="btn-danger-custom" style="padding: 0.1rem 0.3rem; font-size: 0.7rem;" @onclick="() => DeleteMemoryItem(item.Id)">
                                            Delete
                                        </button>
                                    </div>
                                    <p style="margin: 0; font-size: 0.8rem; color: #cbd5e1; line-height: 1.4; word-break: break-word;">
                                        @item.Content
                                    </p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    private List<CeoDirective> Directives { get; set; } = new();
    private ManagerPerformanceReport? LatestReport { get; set; }
    private List<MemoryCatalogItem> MemoryCatalog { get; set; } = new();

    private bool IsProcessing { get; set; } = false;
    private bool IsAnalystRunning { get; set; } = false;

    // Add memory binds
    private string NewMemoryTag { get; set; } = string.Empty;
    private string NewMemoryContent { get; set; } = string.Empty;
    private string AddMemoryMessage { get; set; } = string.Empty;

    // Analyst optimizations
    private string AnalystInsightSummary { get; set; } = string.Empty;

    private Timer? RefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadManagerWorkspaceData();

        // Refresh database streams every 5 seconds
        RefreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadManagerWorkspaceData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadManagerWorkspaceData()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            Directives = await SearchSocialService.GetCeoDirectivesAsync(userId);
            LatestReport = await SearchSocialService.GetManagerReportAsync(userId);
            MemoryCatalog = await SearchSocialService.GetMemoryCatalogAsync(userId);
        }
    }

    private async Task ExecuteCeoDirective(string directiveId, string taskText)
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsProcessing = true;
        StateHasChanged();

        try
        {
            await ManagerOrchestrator.AssignTaskToWorkingAgentAsync(userId, directiveId, UserProfile, taskText);
            await LoadManagerWorkspaceData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Manager directive execution trigger failed: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task TriggerManualAudit()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsProcessing = true;
        StateHasChanged();

        try
        {
            await ManagerOrchestrator.RunOversightReviewAsync(userId, UserProfile);
            await LoadManagerWorkspaceData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Manual audit run failed: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task OptimizeMemoryIndex()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsAnalystRunning = true;
        StateHasChanged();

        try
        {
            AnalystInsightSummary = await AnalystOrchestrator.RunMemoryOptimizationAsync(userId, UserProfile);
            await LoadManagerWorkspaceData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Memory analysis optimization run failed: {ex.Message}");
        }
        finally
        {
            IsAnalystRunning = false;
            StateHasChanged();
        }
    }

    private async Task AddMemoryItem()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || string.IsNullOrWhiteSpace(NewMemoryContent) || string.IsNullOrWhiteSpace(NewMemoryTag)) return;

        try
        {
            var content = NewMemoryContent;
            var tag = NewMemoryTag;

            NewMemoryContent = string.Empty;
            NewMemoryTag = string.Empty;
            AddMemoryMessage = "Synchronizing memory point...";
            StateHasChanged();

            await AnalystOrchestrator.AddMemoryItemAsync(userId, content, tag);
            
            AddMemoryMessage = "Memory vector synchronized successfully!";
            await LoadManagerWorkspaceData();
            StateHasChanged();

            await Task.Delay(2500);
            AddMemoryMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to manually insert memory context: {ex.Message}");
            AddMemoryMessage = "Save failed.";
            StateHasChanged();
        }
    }

    private async Task DeleteMemoryItem(string itemId)
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null) return;

        try
        {
            await AnalystOrchestrator.DeleteMemoryItemAsync(userId, itemId);
            await LoadManagerWorkspaceData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to delete memory index reference: {ex.Message}");
        }
    }

    private string GetStatusBgColor(string status)
    {
        return status switch
        {
            "Completed" => "rgba(16, 185, 129, 0.15)",
            "In Progress" => "rgba(56, 189, 248, 0.15)",
            _ => "rgba(245, 158, 11, 0.15)"
        };
    }

    private string GetStatusTextColor(string status)
    {
        return status switch
        {
            "Completed" => "#34d399",
            "In Progress" => "#38bdf8",
            _ => "#fbbf24"
        };
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
