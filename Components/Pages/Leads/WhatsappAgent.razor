@page "/leads-center/whatsapp"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseLeadsService LeadsService
@inject LeadsCenterOrchestrator LeadsOrchestrator
@inject WhatsappService WhatsappService
@inject NavigationManager Navigation

<PageTitle>WhatsApp Agent - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .wa-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #064e3b 0%, #080d16 60%, #010408 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(16, 185, 129, 0.15); /* Emerald WhatsApp theme border */
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        padding: 1.5rem;
    }

    .split-layout {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 1.5rem;
        height: calc(100vh - 180px);
        min-height: 500px;
    }

    @@media (max-width: 900px) {
        .split-layout {
            grid-template-columns: 1fr;
            height: auto;
        }
    }

    .chat-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    .chat-item {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
    }

    .chat-item:hover {
        border-color: rgba(16, 185, 129, 0.3);
        background: rgba(15, 23, 42, 0.6);
    }

    .chat-item.active {
        border-color: #10b981;
        background: rgba(16, 185, 129, 0.08);
    }

    /* Phone Simulator layout */
    .phone-simulator {
        background: #0b141a; /* WhatsApp default dark background */
        border: 2px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        position: relative;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
    }

    .phone-header {
        background: #1f2c34;
        padding: 0.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .phone-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #128c7e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        color: white;
    }

    .phone-screen {
        flex: 1;
        background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png'); /* Mock WhatsApp wallpaper pattern */
        background-repeat: repeat;
        background-size: auto;
        padding: 1.25rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .chat-bubble {
        max-width: 70%;
        padding: 0.65rem 0.85rem;
        border-radius: 10px;
        font-size: 0.9rem;
        line-height: 1.4;
        word-break: break-word;
        position: relative;
    }

    .bubble-inbound {
        background: #202c33;
        color: #e9edef;
        align-self: flex-start;
        border-top-left-radius: 0;
    }

    .bubble-outbound {
        background: #005c4b; /* WhatsApp dark green bubble */
        color: #e9edef;
        align-self: flex-end;
        border-top-right-radius: 0;
    }

    .bubble-time {
        display: block;
        text-align: right;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.45);
        margin-top: 0.25rem;
    }

    .editor-pane {
        background: #1f2c34;
        padding: 1rem;
        border-top: 1px solid rgba(255,255,255,0.05);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .custom-input {
        width: 100%;
        padding: 0.65rem 1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: #2a3942;
        color: white;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-input:focus {
        border-color: #10b981;
    }

    .btn-send {
        background: #00a884;
        border: none;
        color: white;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

    .btn-send:hover:not(:disabled) {
        background: #00c49a;
    }

    .mobile-only-btn {
        display: none;
    }

    @@media (max-width: 768px) {
        .mobile-only-btn {
            display: inline-flex !important;
            align-items: center;
            gap: 0.5rem;
        }
        .split-layout.has-selected .chat-list {
            display: none !important;
        }
        .split-layout:not(.has-selected) .phone-simulator {
            display: none !important;
        }
        .split-layout {
            grid-template-columns: 1fr;
            height: auto;
            min-height: auto;
        }
        .wa-container {
            padding: 1.25rem;
        }
        .phone-simulator {
            height: calc(100vh - 120px) !important;
            min-height: 450px;
        }
    }
</style>

<div class="wa-container">
    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="margin: 0; font-size: 2.3rem; font-weight: 800; background: linear-gradient(135deg, #10b981 0%, #059669 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">💬 WhatsApp Worker Agent</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1rem;">Listens to incoming WhatsApp chat flows, structures instant draft replies, and matches client expectations</p>
        </div>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <button class="btn-send" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #34d399; box-shadow: none;" @onclick='() => Navigation.NavigateTo("/leads-center/whatsapp/config")'>
                ⚙️ Configure WhatsApp
            </button>
            <button class="btn-send" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); color: #cbd5e1; box-shadow: none;" @onclick='() => Navigation.NavigateTo("/leads-center")'>
                Back to Leads Center
            </button>
        </div>
    </header>

    @if (!Config.IsConfigured)
    {
        <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); color: #fbbf24; padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-size: 1.5rem;">⚠️</span>
                <div>
                    <strong style="display: block; color: #fef08a;">Live WhatsApp connection is not configured</strong>
                    <span style="font-size: 0.85rem; color: #cbd5e1;">The agent is currently in simulation mode. Live incoming and outgoing messages are disabled.</span>
                </div>
            </div>
            <button class="btn-send" style="background: #d97706; color: white; padding: 0.45rem 1rem; font-size: 0.8rem; border: none;" @onclick='() => Navigation.NavigateTo("/leads-center/whatsapp/config")'>
                Configure API Keys Now
            </button>
        </div>
    }

    <div class="split-layout @(SelectedMessage != null ? "has-selected" : "")">
        <!-- Left: Chats list -->
        <div class="glass-panel chat-list">
            <h3 style="margin-top: 0; color: #f1f5f9; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.5rem; display: flex; justify-content: space-between;">
                <span>WhatsApp Chats</span>
                <span style="color: #10b981; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem;">@WhatsappMessages.Count items</span>
            </h3>

            @if (!WhatsappMessages.Any())
            {
                <div style="text-align: center; color: #64748b; font-style: italic; padding-top: 4rem;">
                    No WhatsApp chat logs.
                </div>
            }
            else
            {
                @foreach (var msg in WhatsappMessages)
                {
                    <div class="chat-item @(SelectedMessage?.Id == msg.Id ? "active" : "")" @onclick="() => SelectMessage(msg)">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                            <span style="font-weight: 700; color: #f1f5f9; font-size: 0.9rem;">@msg.LeadName</span>
                            <span style="font-size: 0.7rem; color: #64748b;">@msg.ReceivedAt.ToLocalTime().ToString("t")</span>
                        </div>
                        <div style="font-size: 0.75rem; color: #10b981; margin-bottom: 0.4rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @msg.ContactInfo
                        </div>
                        <div style="font-size: 0.8rem; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @msg.MessageBody
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Right: Mobile Chat Simulator -->
        <div class="phone-simulator">
            @if (SelectedMessage == null)
            {
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #64748b; padding: 2rem;">
                    <div style="font-size: 3.5rem; color: #128c7e; margin-bottom: 1rem;">📱</div>
                    <h4 style="color: #cbd5e1; margin-bottom: 0.5rem; font-weight: 600;">No Conversation Selected</h4>
                    <p style="margin: 0; font-size: 0.85rem; text-align: center;">Pick a WhatsApp contact card from the inbox left panel to simulate operations review.</p>
                </div>
            }
            else
            {
                <!-- Phone Header -->
                <div class="phone-header">
                    <button class="btn-send mobile-only-btn" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: #e9edef; font-weight: 500; padding: 0.4rem 0.8rem; border-radius: 6px; box-shadow: none; margin-right: 0.25rem;" @onclick="() => SelectedMessage = null">
                        ← Chats
                    </button>
                    <div class="phone-avatar">
                        @SelectedMessage.LeadName.Substring(0, 1).ToUpper()
                    </div>
                    <div style="flex: 1;">
                        <div style="font-weight: 700; font-size: 0.95rem; color: #e9edef;">@SelectedMessage.LeadName</div>
                        <div style="font-size: 0.72rem; color: #8696a0;">@SelectedMessage.ContactInfo</div>
                    </div>
                    <span style="font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 4px; background: @(SelectedMessage.Status == "Approved & Sent" ? "rgba(16, 185, 129, 0.2)" : "rgba(245, 158, 11, 0.2)"); color: @(SelectedMessage.Status == "Approved & Sent" ? "#34d399" : "#fbbf24"); font-weight: 700;">
                        @(SelectedMessage.Status == "Approved & Sent" ? "Sent" : "Pending")
                    </span>
                </div>

                <!-- Chat Screen wallpaper -->
                <div class="phone-screen">
                    <!-- Date badge -->
                    <div style="align-self: center; background: #182229; padding: 0.35rem 0.65rem; border-radius: 6px; font-size: 0.72rem; color: #8696a0; font-weight: 600; text-transform: uppercase;">
                        @SelectedMessage.ReceivedAt.ToLocalTime().ToString("d MMMM yyyy")
                    </div>

                    <!-- Customer message -->
                    <div class="chat-bubble bubble-inbound">
                        @SelectedMessage.MessageBody
                        <span class="bubble-time">@SelectedMessage.ReceivedAt.ToLocalTime().ToString("t")</span>
                    </div>

                    <!-- Reply message (if sent) -->
                    @if (SelectedMessage.Status == "Approved & Sent")
                    {
                        <div class="chat-bubble bubble-outbound">
                            @SelectedMessage.DraftResponse
                            <span class="bubble-time">@SelectedMessage.HandledAt?.ToLocalTime().ToString("t") ✔️✔️</span>
                        </div>
                    }
                </div>

                <!-- Bottomsuggested pane (if pending review) -->
                @if (SelectedMessage.Status == "Pending Review")
                {
                    <div class="editor-pane">
                        <div style="background: rgba(18, 140, 126, 0.1); border: 1px solid rgba(18, 140, 126, 0.3); padding: 0.6rem 0.85rem; border-radius: 8px; font-size: 0.78rem; color: #10b981;">
                            🤖 <strong>Agent Suggestion:</strong> Review and modify the draft below. WhatsApp markdown rules (*bold*) are enabled.
                        </div>

                        <!-- Editor -->
                        <textarea @bind="EditedResponse" class="custom-input" style="height: 90px; resize: vertical; background: #2a3942; border-color: rgba(255,255,255,0.05);" placeholder="Type a message..."></textarea>

                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.72rem; color: #8696a0;">Press Send to dispatch reply</span>
                            <button class="btn-send" @onclick="ApproveAndSend" disabled="IsProcessing">
                                @if (IsProcessing)
                                {
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span>Send Message 🚀</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<LeadMessage> WhatsappMessages { get; set; } = new();
    private LeadMessage? SelectedMessage { get; set; }
    private string EditedResponse { get; set; } = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private WhatsappConfig Config { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            var savedConfig = await WhatsappService.GetConfigAsync(userId);
            if (savedConfig != null)
            {
                Config = savedConfig;
            }
        }
        await LoadWhatsappMessages();
    }

    private async Task LoadWhatsappMessages()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            var allMessages = await LeadsService.GetLeadMessagesAsync(userId);
            WhatsappMessages = allMessages.Where(m => m.Channel == "WhatsApp").ToList();

            if (SelectedMessage != null)
            {
                SelectedMessage = WhatsappMessages.FirstOrDefault(m => m.Id == SelectedMessage.Id);
                if (SelectedMessage != null && SelectedMessage.Status == "Approved & Sent")
                {
                    EditedResponse = SelectedMessage.DraftResponse;
                }
            }
        }
    }

    private void SelectMessage(LeadMessage msg)
    {
        SelectedMessage = msg;
        EditedResponse = msg.DraftResponse;
    }

    private async Task ApproveAndSend()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || SelectedMessage == null) return;

        IsProcessing = true;
        StateHasChanged();

        try
        {
            await LeadsOrchestrator.SendApprovedResponseAsync(userId, SelectedMessage, EditedResponse);
            await LoadWhatsappMessages();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to dispatch WhatsApp reply: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }
}
