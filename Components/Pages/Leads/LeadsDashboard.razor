@page "/leads-center"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseLeadsService LeadsService
@inject FirebaseProfileService ProfileService
@inject ChatSessionService SessionService
@inject LeadsCenterOrchestrator LeadsOrchestrator
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Leads Center - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .leads-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #090b16 60%, #02040a 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(139, 92, 246, 0.15); /* Purple/Indigo theme border */
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        padding: 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-panel:hover {
        box-shadow: 0 15px 35px rgba(139, 92, 246, 0.1);
    }

    .gradient-text-purple {
        background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 50%, #6d28d9 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-leads {
        background: rgba(139, 92, 246, 0.12);
        border: 1px solid rgba(139, 92, 246, 0.25);
        color: #c084fc;
    }

    .badge-channel {
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .badge-channel-email { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
    .badge-channel-whatsapp { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-channel-facebook { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
    .badge-channel-website { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

    .status-pending { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-sent { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }

    /* Mode Switch Styling */
    .switch-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 1.25rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
    }

    @@media (max-width: 768px) {
        .leads-container {
            padding: 1.25rem;
        }
        .switch-container {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }
        .kpi-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 480px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

    .switch input { 
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #475569;
        transition: .4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }

    input:checked + .slider {
        background-color: #8b5cf6;
    }

    input:checked + .slider:before {
        transform: translateX(26px);
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .kpi-card {
        background: rgba(30, 41, 59, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .kpi-val {
        font-size: 2.2rem;
        font-weight: 800;
        color: #f8fafc;
        line-height: 1;
    }

    .btn-leads {
        background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
    }

    .btn-leads:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
        background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%);
    }

    .btn-leads:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-secondary-custom {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #cbd5e1;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-secondary-custom:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border-color: rgba(255, 255, 255, 0.15);
    }

    .btn-danger-custom {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #f87171;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-danger-custom:hover {
        background: #ef4444;
        color: white;
    }

    .custom-input {
        width: 100%;
        padding: 0.75rem 1.1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(15, 23, 42, 0.6);
        color: white;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-input:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.25);
    }

    .grid-dashboard {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
        width: 100%;
        box-sizing: border-box;
    }

    .grid-dashboard > div {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
    }

    @@media (max-width: 1100px) {
        .grid-dashboard {
            grid-template-columns: 1fr;
        }
    }

    /* Channel Grid Navigation */
    .channels-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }
    
    .channel-nav-card {
        background: rgba(30, 41, 59, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .channel-nav-card:hover {
        transform: translateY(-3px);
        background: rgba(30, 41, 59, 0.65);
    }
    
    .channel-nav-card.email:hover { border-color: rgba(56, 189, 248, 0.45); box-shadow: 0 8px 25px rgba(56, 189, 248, 0.12); }
    .channel-nav-card.whatsapp:hover { border-color: rgba(16, 185, 129, 0.45); box-shadow: 0 8px 25px rgba(16, 185, 129, 0.12); }
    .channel-nav-card.facebook:hover { border-color: rgba(59, 130, 246, 0.45); box-shadow: 0 8px 25px rgba(59, 130, 246, 0.12); }
    .channel-nav-card.website:hover { border-color: rgba(245, 158, 11, 0.45); box-shadow: 0 8px 25px rgba(245, 158, 11, 0.12); }

    /* Table styles */
    .table-container {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(15, 23, 42, 0.25);
    }

    .leads-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.9rem;
    }

    .leads-table th {
        background: rgba(15, 23, 42, 0.8);
        color: #94a3b8;
        padding: 1rem 1.25rem;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .leads-table td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        color: #cbd5e1;
        vertical-align: middle;
    }

    .leads-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .table-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        color: #64748b;
    }
</style>

<div class="leads-container">
    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text-purple" style="margin: 0; font-size: 2.5rem;">Leads Center</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1.1rem;">Multi-channel customer acquisition dashboard and automated AI response deck</p>
        </div>
        
        <div class="badge-status badge-leads">
            🎯 Leads Agent Active
        </div>
    </header>

    <!-- Top Toggle Row -->
    <div class="switch-container">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <h3 style="margin: 0; color: #f1f5f9; font-size: 1.2rem; font-weight: 700;">
                    @(Settings.IsAutonomous ? "⚡ Fully Autonomous Dispatch" : "💡 Human-in-the-Loop Review")
                </h3>
                <span class="badge-status" style="background: @(Settings.IsAutonomous ? "rgba(139, 92, 246, 0.15)" : "rgba(56, 189, 248, 0.15)"); color: @(Settings.IsAutonomous ? "#c084fc" : "#38bdf8"); font-size: 0.65rem;">
                    @(Settings.IsAutonomous ? "Auto-Pilot" : "Guard Rails Active")
                </span>
            </div>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.85rem; color: #94a3b8;">
                @(Settings.IsAutonomous 
                    ? "Incoming messages from all four channel agents generate AI drafts and send replies automatically." 
                    : "Incoming lead inquiries generate AI drafts saved to the workspace for manual review and approval.")
            </p>
        </div>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <span style="font-size: 0.9rem; font-weight: 600; color: #94a3b8;">Autonomous Mode</span>
            <label class="switch">
                <input type="checkbox" checked="@Settings.IsAutonomous" @onchange="ToggleAutonomousMode" />
                <span class="slider"></span>
            </label>
        </div>
    </div>

    <!-- KPIs Row -->
    <div class="kpi-grid">
        <div class="kpi-card" style="border-left: 4px solid #8b5cf6;">
            <span style="color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Total Leads Ingested</span>
            <span class="kpi-val">@Messages.Count</span>
            <span style="font-size: 0.75rem; color: #64748b;">Across all active channels</span>
        </div>
        <div class="kpi-card" style="border-left: 4px solid #fbbf24;">
            <span style="color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Awaiting Review</span>
            <span class="kpi-val" style="color: #fbbf24;">@Messages.Count(m => m.Status == "Pending Review")</span>
            <span style="font-size: 0.75rem; color: #64748b;">Human approval required</span>
        </div>
        <div class="kpi-card" style="border-left: 4px solid #34d399;">
            <span style="color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Approved & Sent</span>
            <span class="kpi-val" style="color: #34d399;">@Messages.Count(m => m.Status == "Approved & Sent")</span>
            <span style="font-size: 0.75rem; color: #64748b;">Dispatched replies</span>
        </div>
        <div class="kpi-card" style="border-left: 4px solid #38bdf8;">
            <span style="color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">System Response Rate</span>
            <span class="kpi-val" style="color: #38bdf8;">@(Messages.Any() ? $"{Math.Round((double)Messages.Count(m => m.Status == "Approved & Sent") / Messages.Count * 100)}%" : "0%")</span>
            <span style="font-size: 0.75rem; color: #64748b;">Efficiency analytics</span>
        </div>
    </div>

    <!-- Channel Workflows Navigation -->
    <h2 style="color: #e2e8f0; font-size: 1.4rem; margin-top: 0; margin-bottom: 1.25rem; font-weight: 700;">
        🔌 Channel Working Workflows
    </h2>
    <div class="channels-grid">
        <div class="channel-nav-card email" @onclick='() => NavigateToChannelPage("Email")'>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 1.5rem;">📧</span>
                <span class="badge-status" style="background: rgba(56,189,248,0.1); color: #38bdf8; font-size: 0.65rem;">Email Agent</span>
            </div>
            <h4 style="margin: 0.5rem 0 0.25rem 0; color: #f1f5f9; font-size: 1.05rem;">Email Queue</h4>
            <p style="margin: 0; font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">Draft formal emails, handle client inquiries, and manage proposals.</p>
            <div style="margin-top: 0.75rem; font-size: 0.75rem; color: #38bdf8; font-weight: 700;">
                Review Queue: @Messages.Count(m => m.Channel == "Email" && m.Status == "Pending Review") pending
            </div>
        </div>

        <div class="channel-nav-card whatsapp" @onclick='() => NavigateToChannelPage("WhatsApp")'>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 1.5rem;">💬</span>
                <span class="badge-status" style="background: rgba(16,185,129,0.1); color: #34d399; font-size: 0.65rem;">WhatsApp Agent</span>
            </div>
            <h4 style="margin: 0.5rem 0 0.25rem 0; color: #f1f5f9; font-size: 1.05rem;">WhatsApp Chat</h4>
            <p style="margin: 0; font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">Simulate chat flows, friendly quick answers, and booking requests.</p>
            <div style="margin-top: 0.75rem; font-size: 0.75rem; color: #34d399; font-weight: 700;">
                Review Queue: @Messages.Count(m => m.Channel == "WhatsApp" && m.Status == "Pending Review") pending
            </div>
        </div>

        <div class="channel-nav-card facebook" @onclick='() => NavigateToChannelPage("Facebook")'>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 1.5rem;">👥</span>
                <span class="badge-status" style="background: rgba(59,130,246,0.1); color: #60a5fa; font-size: 0.65rem;">Facebook Agent</span>
            </div>
            <h4 style="margin: 0.5rem 0 0.25rem 0; color: #f1f5f9; font-size: 1.05rem;">Facebook Page</h4>
            <p style="margin: 0; font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">Engage social audience, review comments, and answer page messages.</p>
            <div style="margin-top: 0.75rem; font-size: 0.75rem; color: #60a5fa; font-weight: 700;">
                Review Queue: @Messages.Count(m => m.Channel == "Facebook" && m.Status == "Pending Review") pending
            </div>
        </div>

        <div class="channel-nav-card website" @onclick='() => NavigateToChannelPage("Website Form")'>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 1.5rem;">🌐</span>
                <span class="badge-status" style="background: rgba(245,158,11,0.1); color: #fbbf24; font-size: 0.65rem;">Web Form Agent</span>
            </div>
            <h4 style="margin: 0.5rem 0 0.25rem 0; color: #f1f5f9; font-size: 1.05rem;">Website Form</h4>
            <p style="margin: 0; font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">Webhook endpoint settings, live HTML posting simulation, and audits.</p>
            <div style="margin-top: 0.75rem; font-size: 0.75rem; color: #fbbf24; font-weight: 700;">
                Review Queue: @Messages.Count(m => m.Channel == "Website Form" && m.Status == "Pending Review") pending
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="grid-dashboard">
        <!-- Unified Inbox -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <h2 style="color: #e2e8f0; font-size: 1.4rem; margin: 0; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                📥 Unified Incoming Inbox
            </h2>

            <div class="table-container">
                <table class="leads-table">
                    <thead>
                        <tr>
                            <th>Channel</th>
                            <th>Lead Contact</th>
                            <th>Inquiry Snippet</th>
                            <th>Status</th>
                            <th>Received At</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Messages.Any())
                        {
                            <tr>
                                <td colspan="6" class="table-empty">
                                    <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">📭</div>
                                    <p style="margin: 0; font-style: italic;">No lead inquiries recorded.</p>
                                    <p style="margin: 0.25rem 0 0 0; font-size: 0.8rem; color: #475569;">Use the simulator panel on the right to ingest dummy leads instantly!</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var msg in Messages)
                            {
                                <tr>
                                    <td>
                                        <span class="badge-channel @GetChannelBadgeClass(msg.Channel)">
                                            @GetChannelIcon(msg.Channel) @msg.Channel
                                        </span>
                                    </td>
                                    <td>
                                        <div style="font-weight: 700; color: #f1f5f9;">@msg.LeadName</div>
                                        <div style="font-size: 0.75rem; color: #64748b;">@msg.ContactInfo</div>
                                    </td>
                                    <td>
                                        <div style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@msg.MessageBody">
                                            @msg.MessageBody
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-channel @(msg.Status == "Approved & Sent" ? "status-sent" : "status-pending")" style="font-size: 0.65rem; border-radius: 999px;">
                                            @(msg.Status == "Approved & Sent" ? "📬 Sent" : "⏳ Review")
                                        </span>
                                    </td>
                                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #64748b;">
                                        @msg.ReceivedAt.ToLocalTime().ToString("g")
                                    </td>
                                    <td style="text-align: right; white-space: nowrap;">
                                        <button class="btn-secondary-custom" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; margin-right: 0.4rem;" @onclick="() => NavigateToChannelPage(msg.Channel)">
                                            Review
                                        </button>
                                        <button class="btn-danger-custom" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" @onclick="() => DeleteLead(msg.Id)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right Side: Simulator & AI Commander Panels -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- AI Commander Card -->
            <div class="glass-panel" style="border-color: rgba(139,92,246,0.3); background: rgba(139,92,246,0.02); display: flex; flex-direction: column; gap: 1rem;">
                <h3 style="margin-top: 0; color: #c084fc; font-weight: 700; font-size: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                    <span>🤖 Leads Commander Console</span>
                    <div style="display: flex; gap: 0.35rem; align-items: center;">
                        <select @bind="SelectedSessionId" @bind:after="OnSessionChanged" style="background: #1e1b4b; border: 1px solid rgba(139,92,246,0.3); color: #cbd5e1; font-size: 0.75rem; border-radius: 6px; padding: 0.15rem 0.4rem; max-width: 120px;">
                            @foreach (var session in Sessions)
                            {
                                <option value="@session.Id">@session.Title</option>
                            }
                        </select>
                        <button @onclick="CreateNewSession" style="background: rgba(139,92,246,0.2); border: 1px solid rgba(139,92,246,0.4); color: #c084fc; font-size: 0.75rem; border-radius: 6px; padding: 0.15rem 0.4rem; cursor: pointer;">
                            + New
                        </button>
                    </div>
                </h3>
                
                <!-- Chat Window -->
                <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 10px; padding: 1rem; height: 230px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var bubble in ChatMessages)
                    {
                        var isUser = bubble.Sender == "User";
                        <div style="align-self: @(isUser ? "flex-end" : "flex-start"); background: @(isUser ? "#6d28d9" : "#1e293b"); padding: 0.6rem 0.85rem; border-radius: 10px; max-width: 85%; font-size: 0.85rem; line-height: 1.4; word-break: break-word; white-space: pre-wrap;">
                            @bubble.Text
                            <span style="display: block; font-size: 0.65rem; color: rgba(255,255,255,0.4); text-align: right; margin-top: 0.25rem;">
                                @bubble.Timestamp.ToLocalTime().ToString("t")
                            </span>
                        </div>
                    }
                    @if (IsCommanderThinking)
                    {
                        <div style="align-self: flex-start; background: #1e293b; padding: 0.6rem 0.85rem; border-radius: 10px; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; color: #c084fc;">
                            <span class="spinner-border spinner-border-sm" role="status" style="width: 0.85rem; height: 0.85rem; border-width: 0.12em;"></span>
                            <span>Commander interpreting...</span>
                        </div>
                    }
                </div>

                <!-- Input Prompt -->
                <div style="display: flex; gap: 0.5rem;">
                    <input type="text" @bind="CommanderInput" @bind:event="oninput" @onkeypress="HandleCommanderKeyPress" placeholder="Draft email reply to Sarah..." class="custom-input" style="font-size: 0.85rem;" disabled="@IsCommanderThinking" />
                    <button class="btn-leads" style="padding: 0.5rem 1rem; font-size: 0.85rem;" @onclick="SubmitCommanderPrompt" disabled="@(IsCommanderThinking || string.IsNullOrWhiteSpace(CommanderInput) || ActiveSession == null)">
                        Ask
                    </button>
                </div>
                
                <div style="font-size: 0.7rem; color: #64748b; margin-top: -0.25rem; font-style: italic;">
                    Try: "What is Sarah Jenkins asking about?" or "Draft email reply to Sarah saying yes we scale"
                </div>
            </div>

            <div class="glass-panel" style="border-color: rgba(139,92,246,0.25); background: rgba(139,92,246,0.01);">
                <h3 style="margin-top: 0; color: #c084fc; font-weight: 700; font-size: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                    🧪 Channel Lead Simulator
                </h3>
                <p style="font-size: 0.85rem; color: #94a3b8; margin-top: -0.25rem; margin-bottom: 1.25rem;">
                    Select an entry point to simulate a customer message hitting our API or inbox handlers.
                </p>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <!-- Channel Selector -->
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">Simulated Entry Channel</label>
                        <select class="custom-input" @bind="SimChannel">
                            <option value="Email">📧 Business Email</option>
                            <option value="WhatsApp">💬 WhatsApp Message</option>
                            <option value="Facebook">👥 Facebook Page message</option>
                            <option value="Website Form">🌐 Website Form Submission</option>
                        </select>
                    </div>

                    <!-- Lead Details -->
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">Lead Details</label>
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                            <input type="text" @bind="SimName" class="custom-input" placeholder="Lead Name..." style="flex: 1;" />
                            <input type="text" @bind="SimContact" class="custom-input" placeholder="Email/Phone..." style="flex: 1;" />
                        </div>
                    </div>

                    <!-- Lead Message -->
                    <div>
                        <label style="display: block; font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem;">Customer Query</label>
                        <textarea @bind="SimMessage" class="custom-input" style="height: 90px; resize: vertical;" placeholder="Type customer inquiry here..."></textarea>
                    </div>

                    <!-- Simulated Templates -->
                    <div>
                        <span style="display: block; font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; margin-bottom: 0.4rem;">Select Mock Template</span>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <button class="custom-input" style="text-align: left; background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); font-size: 0.75rem; color: #c084fc; cursor: pointer; padding: 0.5rem;" @onclick='() => ApplyMockTemplate("QuoteRequest")'>
                                📝 Simulate detailed quote inquiry
                            </button>
                            <button class="custom-input" style="text-align: left; background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); font-size: 0.75rem; color: #c084fc; cursor: pointer; padding: 0.5rem;" @onclick='() => ApplyMockTemplate("WhatsAppQuick")'>
                                💬 Simulate quick WhatsApp booking question
                            </button>
                            <button class="custom-input" style="text-align: left; background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); font-size: 0.75rem; color: #c084fc; cursor: pointer; padding: 0.5rem;" @onclick='() => ApplyMockTemplate("FacebookSupport")'>
                                👥 Simulate Facebook page help inquiry
                            </button>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <button class="btn-leads" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.5rem;" @onclick="TriggerLeadSimulation" disabled="@(IsSimulating || string.IsNullOrWhiteSpace(SimName) || string.IsNullOrWhiteSpace(SimMessage))">
                        @if (IsSimulating)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" style="width: 1rem; height: 1rem; border-width: 0.12em;"></span>
                            <span>Agent Thinking...</span>
                        }
                        else
                        {
                            <span>Dispatch Inbound Event</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Channels Configuration -->
            <div class="glass-panel" style="padding: 1.5rem;">
                <h4 style="margin-top: 0; color: #cbd5e1; font-weight: 700; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
                    ⚙️ Active Worker Nodes
                </h4>
                <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.85rem; color: #94a3b8;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.5rem;">
                        <span style="display: flex; align-items: center; gap: 0.5rem; color: #e2e8f0; font-weight: 600;">📧 Email Agent</span>
                        <span style="color: #34d399; font-weight: 700;">ACTIVE</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.5rem;">
                        <span style="display: flex; align-items: center; gap: 0.5rem; color: #e2e8f0; font-weight: 600;">💬 WhatsApp Agent</span>
                        <span style="color: #34d399; font-weight: 700;">ACTIVE</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 0.5rem;">
                        <span style="display: flex; align-items: center; gap: 0.5rem; color: #e2e8f0; font-weight: 600;">👥 Facebook Page Agent</span>
                        <span style="color: #34d399; font-weight: 700;">ACTIVE</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="display: flex; align-items: center; gap: 0.5rem; color: #e2e8f0; font-weight: 600;">🌐 Website Form Agent</span>
                        <span style="color: #34d399; font-weight: 700;">ACTIVE</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    // Commander fields
    private string CommanderInput { get; set; } = string.Empty;
    private bool IsCommanderThinking { get; set; } = false;
    
    // Chat sessions fields
    private List<ChatSession> Sessions { get; set; } = new();
    private ChatSession? ActiveSession { get; set; }
    private List<ChatMessage> ChatMessages { get; set; } = new();
    private string SelectedSessionId { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        if (UserProfile != null && Sessions.Count == 0)
        {
            await LoadSessionsAsync();
        }
    }

    private async Task LoadSessionsAsync()
    {
        if (UserProfile == null) return;
        Sessions = await SessionService.GetSessionsAsync(UserProfile.UserId, "Leads");
        if (Sessions.Any())
        {
            await SelectSession(Sessions.First());
        }
        else
        {
            await CreateNewSession();
        }
    }

    private async Task SelectSession(ChatSession session)
    {
        ActiveSession = session;
        SelectedSessionId = session.Id;
        ChatMessages = await SessionService.GetMessagesAsync(session.Id);
        StateHasChanged();
    }

    private async Task CreateNewSession()
    {
        if (UserProfile == null) return;
        var title = $"Leads Query - {DateTime.Now:yyyy-MM-dd HH:mm}";
        var newSession = await SessionService.CreateSessionAsync(UserProfile.UserId, "Leads", title);
        Sessions.Insert(0, newSession);

        var welcomeMsg = new ChatMessage
        {
            Id = "welcome",
            SessionId = newSession.Id,
            Sender = "Agent",
            Text = "Hello! I am your Leads Commander Agent. Ask me questions about your database (e.g. 'What is Sarah Jenkins asking?') or instruct me to draft/send replies (e.g. 'Draft WhatsApp response to Daniel Craig saying yes').",
            Timestamp = DateTime.UtcNow
        };
        await SessionService.SaveMessageAsync(welcomeMsg);

        await SelectSession(newSession);
    }

    private async Task OnSessionChanged()
    {
        var session = Sessions.FirstOrDefault(s => s.Id == SelectedSessionId);
        if (session != null)
        {
            await SelectSession(session);
        }
    }

    private async Task HandleCommanderKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsCommanderThinking && !string.IsNullOrWhiteSpace(CommanderInput))
        {
            await SubmitCommanderPrompt();
        }
    }

    private async Task SubmitCommanderPrompt()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null || string.IsNullOrWhiteSpace(CommanderInput) || ActiveSession == null) return;

        var prompt = CommanderInput;
        CommanderInput = string.Empty;

        // Push User Message
        var userMsg = new ChatMessage
        {
            Id = Guid.NewGuid().ToString("N"),
            SessionId = ActiveSession.Id,
            Sender = "User",
            Text = prompt,
            Timestamp = DateTime.UtcNow
        };
        ChatMessages.Add(userMsg);
        await SessionService.SaveMessageAsync(userMsg);

        IsCommanderThinking = true;
        StateHasChanged();

        try
        {
            // Run Commander AI
            var reply = await LeadsOrchestrator.RunCommanderAgentAsync(
                userId,
                prompt,
                Messages,
                UserProfile,
                Settings.IsAutonomous
            );

            // Push Agent Message response
            var agentMsg = new ChatMessage
            {
                Id = Guid.NewGuid().ToString("N"),
                SessionId = ActiveSession.Id,
                Sender = "Agent",
                Text = reply,
                Timestamp = DateTime.UtcNow
            };
            ChatMessages.Add(agentMsg);
            await SessionService.SaveMessageAsync(agentMsg);
            
            // Reload leads list
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AI Commander failed: {ex.Message}");
            var errMsg = new ChatMessage
            {
                Id = Guid.NewGuid().ToString("N"),
                SessionId = ActiveSession.Id,
                Sender = "Agent",
                Text = $"Sorry, I encountered an error: {ex.Message}",
                Timestamp = DateTime.UtcNow
            };
            ChatMessages.Add(errMsg);
            await SessionService.SaveMessageAsync(errMsg);
        }
        finally
        {
            IsCommanderThinking = false;
            StateHasChanged();
        }
    }

    private List<LeadMessage> Messages { get; set; } = new();
    private LeadsSettings Settings { get; set; } = new();

    // Simulation fields
    private string SimChannel { get; set; } = "Email";
    private string SimName { get; set; } = string.Empty;
    private string SimContact { get; set; } = string.Empty;
    private string SimMessage { get; set; } = string.Empty;
    private bool IsSimulating { get; set; } = false;

    private Timer? RefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        // Refresh database every 4 seconds to pick up new leads (e.g. from the Website Form REST API)
        RefreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
    }

    private async Task LoadData()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            Settings = await LeadsService.GetLeadsSettingsAsync(userId);
            Messages = await LeadsService.GetLeadMessagesAsync(userId);
        }
    }

    private async Task ToggleAutonomousMode(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        Settings.IsAutonomous = isChecked;
        await LeadsService.SaveLeadsSettingsAsync(Settings);
    }

    private void ApplyMockTemplate(string templateType)
    {
        if (templateType == "QuoteRequest")
        {
            SimChannel = "Email";
            SimName = "Sarah Jenkins";
            SimContact = "sarah.j@techstartups.io";
            SimMessage = "Hello, I read about your platform. Can you send over a customized pricing quote and let me know if you support custom volume API limits? Thank you.";
        }
        else if (templateType == "WhatsAppQuick")
        {
            SimChannel = "WhatsApp";
            SimName = "Daniel Craig";
            SimContact = "+1 (555) 321-7890";
            SimMessage = "Hey! Do you guys have slots available for a demo next Tuesday morning? Let me know, thanks!";
        }
        else if (templateType == "FacebookSupport")
        {
            SimChannel = "Facebook";
            SimName = "Alisha Patel";
            SimContact = "facebook.com/alisha.patel.99";
            SimMessage = "Hi! I submitted my onboarding request yesterday but haven't received confirmation. Could you check if my setup is ready? Thanks.";
        }
    }

    private async Task TriggerLeadSimulation()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsSimulating = true;
        StateHasChanged();

        try
        {
            await LeadsOrchestrator.ProcessIncomingLeadAsync(
                userId,
                SimChannel,
                SimName,
                SimContact,
                SimMessage,
                UserProfile
            );

            // Clear simulation inputs
            SimName = string.Empty;
            SimContact = string.Empty;
            SimMessage = string.Empty;

            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Inbound lead simulation failed: {ex.Message}");
        }
        finally
        {
            IsSimulating = false;
            StateHasChanged();
        }
    }

    private async Task DeleteLead(string leadId)
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null) return;

        await LeadsService.DeleteLeadMessageAsync(userId, leadId);
        await LoadData();
    }

    private void NavigateToChannelPage(string channel)
    {
        var path = channel switch
        {
            "Email" => "/leads-center/email",
            "WhatsApp" => "/leads-center/whatsapp",
            "Facebook" => "/leads-center/facebook",
            "Website Form" => "/leads-center/website-form",
            _ => "/leads-center"
        };
        Navigation.NavigateTo(path);
    }

    private string GetChannelBadgeClass(string channel)
    {
        return channel switch
        {
            "Email" => "badge-channel-email",
            "WhatsApp" => "badge-channel-whatsapp",
            "Facebook" => "badge-channel-facebook",
            "Website Form" => "badge-channel-website",
            _ => ""
        };
    }

    private string GetChannelIcon(string channel)
    {
        return channel switch
        {
            "Email" => "📧",
            "WhatsApp" => "💬",
            "Facebook" => "👥",
            "Website Form" => "🌐",
            _ => "✏️"
        };
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
