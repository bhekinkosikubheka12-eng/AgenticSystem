                Date = DateTime.Now.AddHours(-2)
            },
            new InboxEmail
            {
                Id = "mock-msg-3",
                FromName = "Amanda Miller",
                FromAddress = "amanda.miller@retailgrowth.com",
                ToAddress = configuredUsername,
                Subject = "Partnership Proposal for Q3",
