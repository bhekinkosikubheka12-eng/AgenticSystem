                Date = DateTime.Now.AddHours(-5)
            },
            new InboxEmail
            {
                Id = "mock-msg-4",
                FromName = "John Davis",
                FromAddress = "john.davis@logisticspro.com",
                ToAddress = configuredUsername,
                Subject = "Logistics integration query",
                Body = "Hello,\n\nDo you currently have an agent template that works for automated inventory lookup and tracking in logistics? We receive a lot of inbound emails from customers asking 'Where is my order?' and would love to automate the drafting of responses using our custom SQL database.\n\nLet me know if this falls within your platform's capabilities.\n\nRegards,\nJohn Davis\nOperations Manager, LogisticsPro",
                Date = DateTime.Now.AddDays(-1)
            }
        };
    }

    public class InboxEmail
    {
        public string Id { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string FromName { get; set; } = string.Empty;
        public string FromAddress { get; set; } = string.Empty;
        public string ToAddress { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public bool IsProcessed { get; set; } = false;
    }
}
