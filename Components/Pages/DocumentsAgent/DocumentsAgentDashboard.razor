    {
        // Don't clear instantly to let clicks work, or keep selected cell values
    }

    private bool IsCellFocused(int r, int c)
    {
        return SelectedCellType == "Data" && SelectedCellRowIndex == r && SelectedCellColIndex == c;
    }

    private void AddExcelRow()
    {
        if (ActiveExcel == null) return;
        var newRow = new List<string>();
        for (int i = 0; i < ColCount; i++) newRow.Add("");
        ActiveExcel.Rows.Add(newRow);
        RowCount++;
    }

    private void AddExcelColumn()
    {
        if (ActiveExcel == null) return;
        ActiveExcel.Headers.Add("Header " + (char)('A' + ColCount));
        foreach (var r in ActiveExcel.Rows)
        {
            r.Add("");
        }
        ColCount++;
    }

    private string EvaluateCell(string val, ExcelData data)
    {
        if (string.IsNullOrEmpty(val) || !val.StartsWith("="))
            return val;

        try
        {
            var formula = val.Substring(1).Trim().ToUpper();
            if (formula.Contains("-"))
            {
                var parts = formula.Split('-');
                if (parts.Length == 2)
                {
                    var val1 = GetCellValueByRef(parts[0], data);
                    var val2 = GetCellValueByRef(parts[1], data);
                    if (double.TryParse(val1, out double d1) && double.TryParse(val2, out double d2))
                    {
                        return (d1 - d2).ToString("F2").TrimEnd('0').TrimEnd('.');
                    }
                }
            }
            else if (formula.Contains("+"))
            {
                var parts = formula.Split('+');
                if (parts.Length == 2)
                {
                    var val1 = GetCellValueByRef(parts[0], data);
                    var val2 = GetCellValueByRef(parts[1], data);
                    if (double.TryParse(val1, out double d1) && double.TryParse(val2, out double d2))
                    {
                        return (d1 + d2).ToString("F2").TrimEnd('0').TrimEnd('.');
                    }
                }
            }
        }
        catch
        {
            return "#ERR!";
        }
        return val;
    }

    private string GetCellValueByRef(string cellRef, ExcelData data)
    {
        if (cellRef.Length < 2) return "0";
        char colChar = cellRef[0];
        int colIndex = colChar - 'A';
        if (int.TryParse(cellRef.Substring(1), out int rowIndex))
        {
            // Adjustment: Row references in sheets are 1-indexed. Row 1 is the headers row.
            // So cell reference "C2" refers to row index 0 (which is row 2).
            int actualRowIndex = rowIndex - 2;
            if (actualRowIndex >= 0 && actualRowIndex < data.Rows.Count)
            {
                var row = data.Rows[actualRowIndex];
                if (colIndex >= 0 && colIndex < row.Count)
                {
                    var val = row[colIndex];
                    if (val.StartsWith("="))
                    {
                        return EvaluateCell(val, data);
                    }
                    return val;
                }
            }
        }
        return "0";
    }

