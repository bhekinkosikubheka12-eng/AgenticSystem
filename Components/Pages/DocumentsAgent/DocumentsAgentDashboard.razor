    // Markdown Parser Helper
    private string MarkdownToHtml(string md)
    {
        if (string.IsNullOrEmpty(md)) return "";
        
        // Very basic parser for styling preview
        var lines = md.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var html = "";
        bool inList = false;

        foreach (var line in lines)
        {
            var l = line.Trim();
            if (l.StartsWith("# "))
            {
                if (inList) { html += "</ul>"; inList = false; }
                html += $"<h1 style='color:#0f172a;border-bottom:1px solid #e2e8f0;padding-bottom:0.25rem;'>{l.Substring(2)}</h1>";
            }
            else if (l.StartsWith("## "))
            {
                if (inList) { html += "</ul>"; inList = false; }
                html += $"<h2 style='color:#1e293b;margin-top:1.5rem;'>{l.Substring(3)}</h2>";
            }
            else if (l.StartsWith("### "))
            {
                if (inList) { html += "</ul>"; inList = false; }
                html += $"<h3 style='color:#334155;margin-top:1rem;'>{l.Substring(4)}</h3>";
            }
            else if (l.StartsWith("- "))
            {
                if (!inList) { html += "<ul style='padding-left:1.5rem;'>"; inList = true; }
                html += $"<li>{l.Substring(2)}</li>";
            }
            else if (string.IsNullOrWhiteSpace(l))
            {
                if (inList) { html += "</ul>"; inList = false; }
                html += "<br/>";
            }
            else
            {
                if (inList) { html += "</ul>"; inList = false; }
                html += $"<p style='margin:0.5rem 0;'>{l}</p>";
            }
        }
        if (inList) html += "</ul>";

        return html;
    }

    private int CountLines(string text)
    {
        if (string.IsNullOrEmpty(text)) return 0;
        return text.Split('\n').Length;
    }

    private int CountWords(string text)
    {
        if (string.IsNullOrEmpty(text)) return 0;
        return text.Split(new[] { ' ', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

