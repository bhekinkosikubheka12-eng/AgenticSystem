    // Slide Deck Pagination
    private void NextSlide()
    {
        if (ActivePresentation != null && CurrentSlideIndex < ActivePresentation.Slides.Count - 1)
            CurrentSlideIndex++;
    }

    private void PrevSlide()
    {
        if (CurrentSlideIndex > 0)
            CurrentSlideIndex--;
    }

    private void AddPresentationSlide()
    {
        ActivePresentation?.Slides.Add(new PresentationSlide
        {
            Title = "New Slide Title",
            Subtitle = "Slide Subtitle Details",
            LayoutType = "TitleContent",
            Bullets = new List<string> { "Bullet Point 1", "Bullet Point 2" }
        });
        CurrentSlideIndex = ActivePresentation!.Slides.Count - 1;
    }

    private void RemovePresentationSlide()
    {
        if (ActivePresentation != null && ActivePresentation.Slides.Count > 1)
        {
            ActivePresentation.Slides.RemoveAt(CurrentSlideIndex);
            if (CurrentSlideIndex >= ActivePresentation.Slides.Count)
                CurrentSlideIndex = ActivePresentation.Slides.Count - 1;
        }
    }

    private void AddSlideBullet()
    {
        if (ActivePresentation != null && ActivePresentation.Slides.Count > CurrentSlideIndex)
        {
            ActivePresentation.Slides[CurrentSlideIndex].Bullets.Add("New details bullet");
        }
    }

    private void RemoveSlideBullet(int bulletIndex)
    {
        if (ActivePresentation != null && ActivePresentation.Slides.Count > CurrentSlideIndex)
        {
            var slide = ActivePresentation.Slides[CurrentSlideIndex];
            if (bulletIndex >= 0 && bulletIndex < slide.Bullets.Count)
            {
                slide.Bullets.RemoveAt(bulletIndex);
            }
        }
    }

    // Excel functions
    private string GetHeaderValue(int col)
    {
        if (ActiveExcel == null || col < 0 || col >= ActiveExcel.Headers.Count) return "";
        return ActiveExcel.Headers[col];
    }

    private void SetHeaderValue(int col, string val)
    {
        if (ActiveExcel == null) return;
        while (ActiveExcel.Headers.Count <= col) ActiveExcel.Headers.Add("");
        ActiveExcel.Headers[col] = val;
    }

    private string GetCellValueInternal(int row, int col)
    {
        if (ActiveExcel == null || row < 0 || row >= ActiveExcel.Rows.Count) return "";
        var r = ActiveExcel.Rows[row];
        if (col < 0 || col >= r.Count) return "";
        return r[col];
    }

    private void SetCellValueInternal(int row, int col, string val)
    {
        if (ActiveExcel == null) return;
        while (ActiveExcel.Rows.Count <= row)
        {
            var newRow = new List<string>();
            for (int i = 0; i < ColCount; i++) newRow.Add("");
            ActiveExcel.Rows.Add(newRow);
        }
        var r = ActiveExcel.Rows[row];
        while (r.Count <= col) r.Add("");
        r[col] = val;

        // If cell is focused, keep formula sync
        if (SelectedCellRowIndex == row && SelectedCellColIndex == col)
        {
            ActiveCellFormula = val;
        }
    }

    private void SelectCell(string type, int row, int col, string rawValue)
    {
        SelectedCellType = type;
        SelectedCellRowIndex = row;
        SelectedCellColIndex = col;
        ActiveCellFormula = rawValue;
    }

