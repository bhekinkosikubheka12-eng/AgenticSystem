        else if (format == "pptx" && SelectedDocument.Type == "Presentation" && ActivePresentation != null)
        {
            var slidesJson = JsonSerializer.Serialize(ActivePresentation.Slides);
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
