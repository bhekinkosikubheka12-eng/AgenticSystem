@page "/documents-agent"
@using System.Text.Json
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject IConfiguration Config
@inject FirebaseAuthService AuthService
@inject NavigationManager Navigation
@inject ChatSessionService SessionService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Documents Agent - Agentic OS</PageTitle>

<div class="doc-container">
    <div class="header-banner glass-panel mb-4">
        <div class="banner-title-area">
            <div class="icon-glow">📄</div>
            <div>
                <h1 class="gradient-text-cyan">Documents Orchestration Agent</h1>
                <p class="banner-subtitle">Autonomous drafting, templating, and interactive validation center for business assets</p>
            </div>
        </div>
        <div class="banner-meta">
            @if (UserProfile != null)
            {
                <span class="badge-status badge-cyan">
                    <span class="pulse-dot pulse-cyan"></span>
                    Agent Active: @UserProfile.BusinessName
                </span>
            }
            else
            {
                <span class="badge-status badge-warning">Loading Workspace Profile</span>
            }
        </div>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="tabs-bar mb-4">
        <button class="tab-btn @(ActiveTab == "chat" ? "active" : "")" @onclick='() => SetActiveTab("chat")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            Agent Workspace Console
        </button>
        <button class="tab-btn @(ActiveTab == "templates" ? "active" : "")" @onclick='() => SetActiveTab("templates")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Template Library
        </button>
        <button class="tab-btn @(ActiveTab == "archive" ? "active" : "")" @onclick='() => SetActiveTab("archive")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
            Generated Archive & Viewer
        </button>
    </div>

    <!-- Active Tab Workspaces -->
    @if (ActiveTab == "chat")
    {
        <div class="chat-workspace glass-panel">
            <!-- Sessions Sidebar (Left) -->
            <div class="session-sidebar">
                <button class="btn-new-session" @onclick="CreateNewSession">
                    + New Chat
                </button>
                <div class="session-list">
                    @foreach (var session in Sessions)
                    {
                        <div class="session-item @(ActiveSession?.Id == session.Id ? "active" : "")" @onclick="() => SelectSession(session)">
                            <div class="session-title" title="@session.Title">@session.Title</div>
                            <div class="session-date">@session.CreatedAt.ToLocalTime().ToString("g")</div>
                        </div>
                    }
                </div>
            </div>

            <div class="chat-sidebar">
                <h3 class="section-title">Quick Tasks</h3>
                <p class="sidebar-help">Ask the agent to generate new files using your business templates.</p>
                <div class="quick-prompts">
                    <button class="quick-prompt-btn" @onclick='() => InsertPrompt("Draft a client proposal PDF for Acme Corp detailing custom cloud migrations for $5,000 using the Service Proposal template.")'>
                        📝 Draft Service Proposal
                    </button>
                    <button class="quick-prompt-btn" @onclick='() => InsertPrompt("Create a marketing pitch deck presentation for NextGen Systems with 4 slides about local data sovereignty and security.")'>
                        📊 Build Pitch Slides
                    </button>
                    <button class="quick-prompt-btn" @onclick='() => InsertPrompt("Generate an invoice for CloudStream Systems LLC for 30 hours of consulting work and API webhook setup.")'>
                        💰 Generate Invoice
                    </button>
                    <button class="quick-prompt-btn" @onclick='() => InsertPrompt("Create a task list text note outlining immediate priorities for the database migration team on Monday.")'>
                        🗒️ Meeting Discussion Notes
                    </button>
                    <button class="quick-prompt-btn" @onclick='() => InsertPrompt("Build an operational budget Excel grid calculating variance between allocated and spent costs for servers.")'>
                        📈 Excel Cost Summary
                    </button>
                </div>
            </div>

            <div class="chat-main-pane">
                <div class="chat-header">
                    <div class="agent-avatar">🤖</div>
                    <div>
                        <h4 class="m-0">DocuBot v2.4</h4>
                        <span class="status-indicator online">Autonomous Drafting Agent</span>
                    </div>
                </div>

                <div class="chat-messages" id="chatScroll">
                    @foreach (var msg in Messages)
                    {
                        <div class="message-wrapper @(msg.Sender == "User" ? "user-msg" : "agent-msg")">
                            <div class="message-bubble">
                                <div class="message-sender">@(msg.Sender == "User" ? "You" : "Documents Agent")</div>
                                <div class="message-text">@msg.Text</div>

                                @if (!string.IsNullOrEmpty(msg.Thought))
                                {
                                    <div class="thought-box mt-2">
                                        <div class="thought-header" @onclick="() => ToggleThought(msg.Id)">
                                            <span>🧠 Agent Thought Process</span>
                                            <span class="chevron">@(ExpandedThoughts.Contains(msg.Id) ? "▼" : "▶")</span>
                                        </div>
                                        @if (ExpandedThoughts.Contains(msg.Id))
                                        {
                                            <div class="thought-body">@msg.Thought</div>
                                        }
                                    </div>
                                }
                                
                                <span class="message-time">@msg.Timestamp.ToLocalTime().ToString("t")</span>
                            </div>
                        </div>
                    }

                    @if (IsAgentGenerating)
                    {
                        <div class="message-wrapper agent-msg">
                            <div class="message-bubble drafting">
                                <div class="message-sender">Documents Agent</div>
                                <div class="drafting-loader">
                                    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                </div>
                                <div class="agent-progress-steps">
                                    @foreach (var step in ProgressSteps)
                                    {
                                        <div class="progress-step">✓ @step</div>
                                    }
                                    <div class="progress-step active">⚡ @ActiveProgressStep...</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="chat-input-area">
                    <input type="text" class="custom-chat-input" placeholder="Ask the agent to generate or edit a document..." @bind="CurrentChatInput" @onkeyup="HandleKeyUp" />
                    <button class="btn-send-chat" @onclick="SubmitChat" disabled="@IsAgentGenerating">
                        <span>Send</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (ActiveTab == "templates")
    {
        <div class="templates-workspace">
            <div class="workspace-header mb-3">
                <h3 class="section-title">Active Document Templates</h3>
                <button class="btn-action-primary" @onclick="OpenNewTemplateModal">
                    + Add New Template
                </button>
            </div>

            <div class="templates-grid">
                @foreach (var temp in Templates)
                {
                    <div class="template-card glass-panel">
                        <div class="template-card-header">
                            <span class="template-type-badge type-@temp.Type.ToLower().Replace(" ", "")">@temp.Type</span>
                            <div class="template-actions">
                                <button class="action-icon-btn" title="Edit Template" @onclick="() => EditTemplate(temp)">
                                    ✏️
                                </button>
                                <button class="action-icon-btn delete" title="Delete Template" @onclick="() => DeleteTemplate(temp.Id)">
                                    🗑️
                                </button>
                            </div>
                        </div>
                        <h4 class="template-name">@temp.Name</h4>
                        <p class="template-desc">@temp.Description</p>
                        <div class="template-variables">
                            <strong>Placeholders:</strong> 
                            @foreach (var variable in temp.Variables.Split(','))
                            {
                                @if (!string.IsNullOrWhiteSpace(variable))
                                {
                                    <span class="variable-tag">@variable.Trim()</span>
                                }
                            }
                        </div>
                        <div class="template-footer">
                            <span class="date-text">Modified: @temp.LastModified.ToLocalTime().ToString("d")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (ActiveTab == "archive")
    {
        <div class="archive-workspace split-layout">
            <!-- Sidebar: Document selection -->
            <div class="archive-list glass-panel">
                <h3 class="section-title mb-3">Generated Documents</h3>
                
                <div class="search-filter-box mb-3">
                    <input type="text" class="search-input" placeholder="Search files..." @bind="SearchQuery" @bind:event="oninput" />
                </div>

                <div class="doc-list-scroll">
                    @if (FilteredDocuments.Any())
                    {
                        @foreach (var doc in FilteredDocuments)
                        {
                            <div class="doc-item-card @(SelectedDocument?.Id == doc.Id ? "active" : "")" @onclick="() => SelectDocument(doc)">
                                <div class="doc-item-header">
                                    <span class="doc-type-badge type-@doc.Type.ToLower().Replace(" ", "")">@doc.Type</span>
                                    <span class="doc-status-badge status-@doc.Status.ToLower()">@doc.Status</span>
                                </div>
                                <h5 class="doc-item-title">@doc.Title</h5>
                                <div class="doc-item-footer">
                                    <span>📅 @doc.CreatedAt.ToLocalTime().ToString("g")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-docs-message">No generated documents found.</div>
                    }
                </div>
            </div>

            <!-- Main Panel: Document Preview & Editor -->
            <div class="archive-preview glass-panel">
                @if (SelectedDocument != null)
                {
                    <div class="preview-header">
                        <div class="preview-title-area">
                            <h3 class="preview-title">@SelectedDocument.Title</h3>
                            <span class="badge-status">@SelectedDocument.Type</span>
                        </div>
                        <div class="preview-actions">
                            <button class="btn-action-sec" @onclick="RequestAgentEdit">
                                🤖 Agent
                            </button>
                            <button class="btn-action-sec" @onclick="ToggleEditMode">
                                @(IsEditingDocData ? "👁️ View" : "✏️ Edit")
                            </button>
                            <button class="btn-action-primary" @onclick="SaveDocumentEdits">
                               📅 Save 
                            </button>
                            <button class="btn-action-sec text-info" @onclick="ExportDocument">
                                📥 Export
                            </button>
                        </div>
                    </div>

                    <div class="preview-viewport">
                        @if (IsEditingDocData)
                        {
                            <div class="editor-pane">
                                <div class="form-group mb-3">
                                    <label class="form-label">Document Title</label>
                                    <input type="text" class="custom-input" @bind="SelectedDocument.Title" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Document Status</label>
                                    <select class="custom-input" @bind="SelectedDocument.Status">
                                        <option value="Draft">Draft</option>
                                        <option value="Finalized">Finalized</option>
                                        <option value="Approved">Approved</option>
                                    </select>
                                </div>

                                @if (SelectedDocument.Type == "PDF" || SelectedDocument.Type == "Txt Note")
                                {
                                    <div class="form-group">
                                        <label class="form-label">Raw Narrative/Content</label>
                                        <textarea class="custom-input text-monospace" style="height: 300px; font-family: 'JetBrains Mono', monospace;" @bind="SelectedDocument.RawContent"></textarea>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-group">
                                        <label class="form-label">Structured JSON Data</label>
                                        <textarea class="custom-input text-monospace" style="height: 250px; font-family: 'JetBrains Mono', monospace;" @bind="SelectedDocument.StructuredDataJson" @onblur="OnStructuredJsonBlur"></textarea>
                                        @if (!string.IsNullOrEmpty(JsonParseError))
                                        {
                                            <span class="text-danger mt-1">⚠️ @JsonParseError</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Visual Render Previews -->
                            <div class="visual-viewport">
                                @if (SelectedDocument.Type == "PDF")
                                {
                                    <div class="pdf-viewer-render">
                                        <div class="pdf-letterhead">
                                            <div class="pdf-logo">🏢</div>
                                            <div>
                                                <h4>@UserProfile?.BusinessName</h4>
                                                <p>Workspace Managed PDF Document</p>
                                            </div>
                                        </div>
                                        <div class="pdf-body">
                                            @((MarkupString)MarkdownToHtml(SelectedDocument.RawContent))
                                        </div>
                                        <div class="pdf-footer">
                                            <p>Page 1 of 1 | Digitally Sealed by Agentic OS</p>
                                        </div>
                                    </div>
                                }
                                else if (SelectedDocument.Type == "Txt Note")
                                {
                                    <div class="txt-viewer-render">
                                        <div class="txt-header">
                                            <span>📄 PLAIN TEXT NOTEPAD</span>
                                            <span>Lines: @CountLines(SelectedDocument.RawContent) | Words: @CountWords(SelectedDocument.RawContent)</span>
                                        </div>
                                        <pre class="txt-body">@SelectedDocument.RawContent</pre>
                                    </div>
                                }
                                else if (SelectedDocument.Type == "Invoice")
                                {
                                    @if (ActiveInvoice != null)
                                    {
                                        <div class="invoice-viewer-render">
                                            <div class="invoice-top">
                                                <div>
                                                    <input class="inv-inline-input font-bold text-lg" @bind="ActiveInvoice.BusinessName" placeholder="Business Name" />
                                                    <textarea class="inv-inline-textarea text-sm text-secondary" @bind="ActiveInvoice.BusinessAddress" placeholder="Business Address"></textarea>
                                                </div>
                                                <div class="text-right">
                                                    <h2 class="invoice-title">INVOICE</h2>
                                                    <div class="form-row mt-2">
                                                        <span class="label">Invoice #:</span>
                                                        <input class="inv-inline-input inline-val w-28 text-right" @bind="ActiveInvoice.InvoiceNumber" />
                                                    </div>
                                                    <div class="form-row">
                                                        <span class="label">Date:</span>
                                                        <input class="inv-inline-input inline-val w-28 text-right" @bind="ActiveInvoice.Date" />
                                                    </div>
                                                    <div class="form-row">
                                                        <span class="label">Due Date:</span>
                                                        <input class="inv-inline-input inline-val w-28 text-right" @bind="ActiveInvoice.DueDate" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="invoice-billing-details mt-4">
                                                <div>
                                                    <span class="section-sub">Billed To:</span>
                                                    <input class="inv-inline-input font-bold" @bind="ActiveInvoice.ClientName" placeholder="Client Name" />
                                                    <input class="inv-inline-input text-sm text-secondary" @bind="ActiveInvoice.ClientEmail" placeholder="Client Email" />
                                                </div>
                                            </div>

                                            <table class="invoice-table mt-4">
                                                <thead>
                                                    <tr>
                                                        <th>Description</th>
                                                        <th class="w-16 text-center">Qty</th>
                                                        <th class="w-24 text-right">Rate ($)</th>
                                                        <th class="w-28 text-right">Amount ($)</th>
                                                        <th class="w-12"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < ActiveInvoice.LineItems.Count; i++)
                                                    {
                                                        var index = i;
                                                        var item = ActiveInvoice.LineItems[index];
                                                        <tr>
                                                            <td>
                                                                <input class="inv-inline-input" @bind="item.Description" />
                                                            </td>
                                                            <td>
                                                                <input type="number" class="inv-inline-input text-center" @bind="item.Quantity" />
                                                            </td>
                                                            <td>
                                                                <input type="number" step="0.01" class="inv-inline-input text-right" @bind="item.Rate" />
                                                            </td>
                                                            <td class="text-right align-middle pr-2">
                                                                $@((item.Quantity * item.Rate).ToString("N2"))
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                <button class="delete-line-btn" @onclick="() => RemoveInvoiceLine(index)">✕</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                            <div class="invoice-actions-row">
                                                <button class="btn-action-sec py-1 px-3 text-xs" @onclick="AddInvoiceLine">+ Add Line Item</button>
                                            </div>

                                            <div class="invoice-summary-area mt-4">
                                                <div class="invoice-notes">
                                                    <span class="section-sub">Notes:</span>
                                                    <textarea class="inv-inline-textarea" @bind="ActiveInvoice.Notes" placeholder="Additional notes or payment instructions..."></textarea>
                                                </div>
                                                <div class="invoice-totals">
                                                    <div class="total-row">
                                                        <span>Subtotal:</span>
                                                        <span>$@InvoiceSubtotal.ToString("N2")</span>
                                                    </div>
                                                    <div class="total-row">
                                                        <span>Tax (State / Local):</span>
                                                        <div class="flex items-center gap-1 justify-end">
                                                            <input type="number" step="0.01" class="inv-inline-input text-right w-12" @bind="ActiveInvoice.TaxRate" />
                                                            <span>%</span>
                                                        </div>
                                                    </div>
                                                    <div class="total-row grand-total mt-2">
                                                        <span>Amount Due:</span>
                                                        <span>$@InvoiceGrandTotal.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else if (SelectedDocument.Type == "Presentation")
                                {
                                    @if (ActivePresentation != null)
                                    {
                                        <div class="ppt-viewer-render">
                                            <!-- Slides Navigator -->
                                            <div class="ppt-controls mb-3">
                                                <button class="btn-action-sec" @onclick="PrevSlide" disabled="@(CurrentSlideIndex <= 0)">◀ Prev</button>
                                                <span class="slide-indicator">Slide @(CurrentSlideIndex + 1) of @ActivePresentation.Slides.Count</span>
                                                <button class="btn-action-sec" @onclick="NextSlide" disabled="@(CurrentSlideIndex >= ActivePresentation.Slides.Count - 1)">Next ▶</button>
                                                <div style="flex-grow: 1;"></div>
                                                <button class="btn-action-sec text-xs" @onclick="AddPresentationSlide">+ Add Slide</button>
                                                <button class="btn-action-sec text-xs text-danger" @onclick="RemovePresentationSlide" disabled="@(ActivePresentation.Slides.Count <= 1)">✕ Delete Slide</button>
                                            </div>

                                            <!-- Slide Viewport Screen -->
                                            @if (ActivePresentation.Slides.Count > CurrentSlideIndex)
                                            {
                                                var slide = ActivePresentation.Slides[CurrentSlideIndex];
                                                <div class="slide-screen theme-@ActivePresentation.ThemeColor">
                                                    <div class="slide-content layout-@slide.LayoutType">
                                                        @if (slide.LayoutType == "TitleContent")
                                                        {
                                                            <input class="slide-inline-input slide-title" @bind="slide.Title" placeholder="Slide Title" />
                                                            <input class="slide-inline-input slide-subtitle" @bind="slide.Subtitle" placeholder="Slide Subtitle" />
                                                            <div class="slide-bullets mt-3">
                                                                @for (int j = 0; j < slide.Bullets.Count; j++)
                                                                {
                                                                    var bulletIndex = j;
                                                                    <div class="bullet-row">
                                                                        <span class="bullet-dot">•</span>
                                                                        <input class="slide-inline-input bullet-val" @bind="slide.Bullets[bulletIndex]" placeholder="Bullet point text" />
                                                                        <button class="delete-bullet-btn" @onclick="() => RemoveSlideBullet(bulletIndex)">✕</button>
                                                                    </div>
                                                                }
                                                                <button class="btn-add-bullet" @onclick="AddSlideBullet">+ Add Bullet</button>
                                                            </div>
                                                        }
                                                        else if (slide.LayoutType == "TwoColumns")
                                                        {
                                                            <input class="slide-inline-input slide-title" @bind="slide.Title" placeholder="Slide Title" />
                                                            <div class="slide-columns mt-3">
                                                                <div class="slide-column">
                                                                    <span class="section-sub text-white">Left Column Details</span>
                                                                    <input class="slide-inline-input slide-subtitle" @bind="slide.Subtitle" placeholder="Subtitle" />
                                                                </div>
                                                                <div class="slide-column border-left pl-3">
                                                                    <span class="section-sub text-white">Right Column Details</span>
                                                                    @for (int j = 0; j < slide.Bullets.Count; j++)
                                                                    {
                                                                        var bulletIndex = j;
                                                                        <div class="bullet-row">
                                                                            <span class="bullet-dot">•</span>
                                                                            <input class="slide-inline-input bullet-val" @bind="slide.Bullets[bulletIndex]" />
                                                                            <button class="delete-bullet-btn" @onclick="() => RemoveSlideBullet(bulletIndex)">✕</button>
                                                                        </div>
                                                                    }
                                                                    <button class="btn-add-bullet" @onclick="AddSlideBullet">+ Add Bullet</button>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (slide.LayoutType == "BigStat")
                                                        {
                                                            <div class="big-stat-container">
                                                                <input class="slide-inline-input text-center font-bold text-6xl text-cyan-glow" @bind="slide.Title" placeholder="95%" />
                                                                <input class="slide-inline-input text-center text-secondary text-lg" @bind="slide.Subtitle" placeholder="Efficiency gain achieved" />
                                                            </div>
                                                        }
                                                        else // Quote
                                                        {
                                                            <div class="slide-quote-container">
                                                                <textarea class="slide-inline-textarea text-center italic text-xl" @bind="slide.Title" placeholder="“Enter client testimonial or quote”"></textarea>
                                                                <input class="slide-inline-input text-center font-bold text-cyan" @bind="slide.Subtitle" placeholder="— Author details" />
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Slide Metadata Editor -->
                                                <div class="slide-metadata mt-3 p-3 glass-panel">
                                                    <div class="grid grid-cols-2 gap-3">
                                                        <div class="form-group">
                                                            <label class="form-label text-xs">Slide Layout</label>
                                                            <select class="custom-input py-1 text-xs" @bind="slide.LayoutType">
                                                                <option value="TitleContent">Title & Bullets</option>
                                                                <option value="TwoColumns">Two Columns</option>
                                                                <option value="BigStat">Huge Metric</option>
                                                                <option value="Quote">Block Quote</option>
                                                            </select>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label text-xs">Visual Design Instructions (for exports)</label>
                                                            <input type="text" class="custom-input py-1 text-xs" @bind="slide.VisualNotes" placeholder="e.g. Include flowchart graphic" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (SelectedDocument.Type == "Excel")
                                {
                                    @if (ActiveExcel != null)
                                    {
                                        <div class="excel-viewer-render">
                                            <div class="excel-header-bar mb-2">
                                                <div class="form-inline">
                                                    <span class="label text-xs mr-2">Sheet Name:</span>
                                                    <input class="excel-sheet-name-input" @bind="ActiveExcel.SheetName" />
                                                </div>
                                                <span class="formula-preview text-xs">Selected Cell Formula: <code class="text-info">@ActiveCellFormula</code></span>
                                            </div>

                                            <div class="excel-grid-scroll">
                                                <table class="excel-table">
                                                    <thead>
                                                        <tr>
                                                            <th class="row-number-col"></th>
                                                            @for (int c = 0; c < ColCount; c++)
                                                            {
                                                                var colChar = (char)('A' + c);
                                                                <th>@colChar</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Headers Row (Row 1) -->
                                                        <tr>
                                                            <td class="row-number-col text-center font-bold text-xs">1</td>
                                                            @for (int c = 0; c < ColCount; c++)
                                                            {
                                                                var colIndex = c;
                                                                <td>
                                                                    <input class="excel-cell-input font-bold" 
                                                                           value="@GetHeaderValue(colIndex)" 
                                                                           @onchange='(e) => SetHeaderValue(colIndex, e.Value?.ToString() ?? "")' 
                                                                           @onfocus='() => SelectCell("Header", 0, colIndex, GetHeaderValue(colIndex))' />
                                                                </td>
                                                            }
                                                        </tr>

                                                        <!-- Data Rows (Rows 2+) -->
                                                        @for (int r = 0; r < RowCount; r++)
                                                        {
                                                            var rowIndex = r;
                                                            var displayRowNumber = rowIndex + 2;
                                                            <tr>
                                                                <td class="row-number-col text-center font-bold text-xs">@displayRowNumber</td>
                                                                @for (int c = 0; c < ColCount; c++)
                                                                {
                                                                    var colIndex = c;
                                                                    var rawVal = GetCellValueInternal(rowIndex, colIndex);
                                                                    var evaluatedVal = EvaluateCell(rawVal, ActiveExcel);
                                                                    <td>
                                                                        <input class="excel-cell-input @(rawVal.StartsWith("=") ? "formula-cell" : "")" 
                                                                               value="@(IsCellFocused(rowIndex, colIndex) ? rawVal : evaluatedVal)" 
                                                                               @onchange='(e) => SetCellValueInternal(rowIndex, colIndex, e.Value?.ToString() ?? "")'
                                                                               @onfocus='() => SelectCell("Data", rowIndex, colIndex, rawVal)' 
                                                                               @onblur="ClearCellFocus" />
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="excel-footer-bar mt-2 text-right">
                                                <button class="btn-action-sec text-xs" @onclick="AddExcelRow">+ Add Row</button>
                                                <button class="btn-action-sec text-xs" @onclick="AddExcelColumn">+ Add Column</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-selection-container">
                        <div class="placeholder-icon">📂</div>
                        <h3>Select a Document</h3>
                        <p class="text-secondary">Choose a document from the archive list to view its rich interface, edit values, or run templates operations.</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Template Management Modals -->
    @if (IsTemplateModalOpen && EditingTemplate != null)
    {
        <div class="modal-backdrop">
            <div class="custom-modal glass-panel">
                <div class="modal-header">
                    <h4>@(IsNewTemplate ? "Create Document Template" : "Edit Template Details")</h4>
                    <button class="modal-close-btn" @onclick="CloseTemplateModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label">Template Name</label>
                        <input type="text" class="custom-input" @bind="EditingTemplate.Name" placeholder="e.g. Sales Pitch Presentation" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Document Type</label>
                        <select class="custom-input" @bind="EditingTemplate.Type" disabled="@(!IsNewTemplate)">
                            <option value="PDF">PDF Report / Agreement</option>
                            <option value="Presentation">Presentation (Slides)</option>
                            <option value="Invoice">Invoice Layout</option>
                            <option value="Txt Note">Plain Text / Markdown Note</option>
                            <option value="Excel">Excel Spreadsheet Grid</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" class="custom-input" @bind="EditingTemplate.Description" placeholder="Quick description of what this template defines" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Placeholders / Variables (Comma Separated)</label>
                        <input type="text" class="custom-input" @bind="EditingTemplate.Variables" placeholder="BusinessName, ClientName, TotalAmount" />
                        <span class="text-secondary text-xs">These tags can be injected into the template layout as <code>{{TagName}}</code>.</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Template Layout/Formatting Definition</label>
                        <textarea class="custom-input text-monospace" style="height: 200px; font-family: 'JetBrains Mono', monospace;" @bind="EditingTemplate.Content" placeholder="Enter markdown or descriptive outline placeholders..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-action-sec" @onclick="CloseTemplateModal">Cancel</button>
                    <button class="btn-action-primary" @onclick="SaveTemplate">Save Template</button>
                </div>
            </div>
        </div>
    }

    <!-- Export Formats Modal -->
    @if (IsExportPopupOpen && SelectedDocument != null)
    {
        <div class="modal-backdrop" @onclick="CloseExportPopup">
            <div class="custom-modal glass-panel" @onclick:stopPropagation>
                <div class="modal-header">
                    <h4>Export Options: @SelectedDocument.Title</h4>
                    <button class="modal-close-btn" @onclick="CloseExportPopup">✕</button>
                </div>
                <div class="modal-body">
                    <p class="mb-4 text-sm text-secondary">Choose the format you would like to export this <strong>@SelectedDocument.Type</strong> in:</p>
                    <div class="export-formats-list">
                        @if (SelectedDocument.Type == "PDF")
                        {
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pdf")'>
                                <span class="format-icon">📄</span>
                                <div class="format-details">
                                    <strong>Print/Save PDF</strong>
                                    <span>Open standard browser print dialog for PDF saving</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("md")'>
                                <span class="format-icon">📝</span>
                                <div class="format-details">
                                    <strong>Markdown (.md)</strong>
                                    <span>Retains template layouts in plain markdown formatting</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("txt")'>
                                <span class="format-icon">🗒️</span>
                                <div class="format-details">
                                    <strong>Plain Text (.txt)</strong>
                                    <span>Unformatted plain text draft file</span>
                                </div>
                            </button>
                        }
                        else if (SelectedDocument.Type == "Invoice")
                        {
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pdf")'>
                                <span class="format-icon">📄</span>
                                <div class="format-details">
                                    <strong>PDF Document (.pdf)</strong>
                                    <span>Print or save as professional PDF document</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("html")'>
                                <span class="format-icon">🌐</span>
                                <div class="format-details">
                                    <strong>HTML Invoice (.html)</strong>
                                    <span>Interactive, styled single-page HTML layout</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("json")'>
                                <span class="format-icon">⚙️</span>
                                <div class="format-details">
                                    <strong>Raw Data JSON (.json)</strong>
                                    <span>Raw key-value structured data parameters</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("txt")'>
                                <span class="format-icon">🗒️</span>
                                <div class="format-details">
                                    <strong>Text Details (.txt)</strong>
                                    <span>Hierarchical text layout summarizing billing rows</span>
                                </div>
                            </button>
                        }
                        else if (SelectedDocument.Type == "Presentation")
                        {
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pptx")'>
                                <span class="format-icon">📊</span>
                                <div class="format-details">
                                    <strong>PowerPoint Slide Deck (.pptx)</strong>
                                    <span>Download presentation slides for Microsoft PowerPoint</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pdf")'>
                                <span class="format-icon">📄</span>
                                <div class="format-details">
                                    <strong>PDF Document (.pdf)</strong>
                                    <span>Print or save slide deck as PDF pages</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("html")'>
                                <span class="format-icon">🌐</span>
                                <div class="format-details">
                                    <strong>Interactive HTML slides (.html)</strong>
                                    <span>Styled slideshow presentation deck view</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("json")'>
                                <span class="format-icon">⚙️</span>
                                <div class="format-details">
                                    <strong>Metadata JSON (.json)</strong>
                                    <span>Slide structures, color properties and bullet lists</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("txt")'>
                                <span class="format-icon">🗒️</span>
                                <div class="format-details">
                                    <strong>Outline Text (.txt)</strong>
                                    <span>Slide-by-slide hierarchical bullet outline</span>
                                </div>
                            </button>
                        }
                        else if (SelectedDocument.Type == "Excel")
                        {
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pdf")'>
                                <span class="format-icon">📄</span>
                                <div class="format-details">
                                    <strong>PDF Document (.pdf)</strong>
                                    <span>Print or save spreadsheet grid layout as PDF</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("csv")'>
                                <span class="format-icon">📊</span>
                                <div class="format-details">
                                    <strong>Spreadsheet CSV (.csv)</strong>
                                    <span>Standard values table separator for MS Excel/Sheets</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("json")'>
                                <span class="format-icon">⚙️</span>
                                <div class="format-details">
                                    <strong>Grid JSON (.json)</strong>
                                    <span>JSON representation of the rows grid values and formulas</span>
                                </div>
                            </button>
                        }
                        else
                        {
                            <button class="btn-export-format" @onclick='() => ExecuteExport("pdf")'>
                                <span class="format-icon">📄</span>
                                <div class="format-details">
                                    <strong>PDF Document (.pdf)</strong>
                                    <span>Print or save notepad text as PDF layout</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("txt")'>
                                <span class="format-icon">🗒️</span>
                                <div class="format-details">
                                    <strong>Plain Text (.txt)</strong>
                                    <span>Standard Notepad text document</span>
                                </div>
                            </button>
                            <button class="btn-export-format" @onclick='() => ExecuteExport("md")'>
                                <span class="format-icon">📝</span>
                                <div class="format-details">
                                    <strong>Markdown File (.md)</strong>
                                    <span>Markdown text file containing structure syntax</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-action-sec" @onclick="CloseExportPopup">Cancel</button>
                </div>
            </div>
        </div>
    }

    <!-- Print-only container (hidden by default on screen, visible during printing) -->
    <div class="print-only-container">
        @if (SelectedDocument != null)
        {
            @if (SelectedDocument.Type == "PDF")
            {
                <div class="pdf-viewer-render">
                    <div class="pdf-letterhead">
                        <div class="pdf-logo">🏢</div>
                        <div>
                            <h4>@UserProfile?.BusinessName</h4>
                            <p>Workspace Managed PDF Document</p>
                        </div>
                    </div>
                    <div class="pdf-body">
                        @((MarkupString)MarkdownToHtml(SelectedDocument.RawContent))
                    </div>
                    <div class="pdf-footer">
                        <p>Page 1 of 1 | Digitally Sealed by Agentic OS</p>
                    </div>
                </div>
            }
            else if (SelectedDocument.Type == "Txt Note")
            {
                <div class="txt-viewer-render">
                    <div class="txt-header">
                        <span>📄 PLAIN TEXT NOTEPAD</span>
                    </div>
                    <pre class="txt-body">@SelectedDocument.RawContent</pre>
                </div>
            }
            else if (SelectedDocument.Type == "Invoice" && ActiveInvoice != null)
            {
                <div class="invoice-viewer-render" style="border:none !important;">
                    <div class="invoice-top">
                        <div>
                            <h3>@ActiveInvoice.BusinessName</h3>
                            <p>@ActiveInvoice.BusinessAddress</p>
                        </div>
                        <div class="text-right">
                            <h2 class="invoice-title">INVOICE</h2>
                            <p><strong>Invoice #:</strong> @ActiveInvoice.InvoiceNumber</p>
                            <p><strong>Date:</strong> @ActiveInvoice.Date</p>
                            <p><strong>Due Date:</strong> @ActiveInvoice.DueDate</p>
                        </div>
                    </div>
                    <div class="invoice-billing-details mt-4">
                        <p><strong>Billed To:</strong> @ActiveInvoice.ClientName</p>
                        <p>@ActiveInvoice.ClientEmail</p>
                    </div>
                    <table class="invoice-table mt-4" style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="border-bottom:2px solid #000; padding:8px; text-align:left;">Description</th>
                                <th style="border-bottom:2px solid #000; padding:8px; text-align:center; width: 60px;">Qty</th>
                                <th style="border-bottom:2px solid #000; padding:8px; text-align:right; width: 100px;">Rate ($)</th>
                                <th style="border-bottom:2px solid #000; padding:8px; text-align:right; width: 120px;">Amount ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ActiveInvoice.LineItems)
                            {
                                <tr>
                                    <td style="border-bottom:1px solid #ccc; padding:8px;">@item.Description</td>
                                    <td style="border-bottom:1px solid #ccc; padding:8px; text-align:center;">@item.Quantity</td>
                                    <td style="border-bottom:1px solid #ccc; padding:8px; text-align:right;">$@item.Rate.ToString("N2")</td>
                                    <td style="border-bottom:1px solid #ccc; padding:8px; text-align:right;">$@((item.Quantity * item.Rate).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="invoice-summary-area mt-4" style="display:flex; justify-content:space-between;">
                        <div style="width: 55%;">
                            <p><strong>Notes:</strong></p>
                            <p>@ActiveInvoice.Notes</p>
                        </div>
                        <div style="width: 35%; text-align:right;">
                            <p><strong>Subtotal:</strong> $@InvoiceSubtotal.ToString("N2")</p>
                            <p><strong>Tax (@ActiveInvoice.TaxRate%):</strong> $@((InvoiceSubtotal * ActiveInvoice.TaxRate / 100).ToString("N2"))</p>
                            <h3 style="border-top:1.5px solid #000; padding-top:6px; margin-top:6px;"><strong>Total Due:</strong> $@InvoiceGrandTotal.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            }
            else if (SelectedDocument.Type == "Presentation" && ActivePresentation != null)
            {
                @foreach (var slide in ActivePresentation.Slides)
                {
                    <div class="slide-screen theme-@ActivePresentation.ThemeColor print-slide-card" style="page-break-after:always; break-after:page; margin-bottom:20px; border:1px solid #ccc;">
                        <div class="slide-content layout-@slide.LayoutType">
                            @if (slide.LayoutType == "TitleContent")
                            {
                                <div class="slide-title">@slide.Title</div>
                                <div class="slide-subtitle">@slide.Subtitle</div>
                                <div class="slide-bullets mt-3">
                                    @foreach (var bullet in slide.Bullets)
                                    {
                                        <div class="bullet-row">
                                            <span class="bullet-dot">•</span>
                                            <span class="bullet-val">@bullet</span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (slide.LayoutType == "TwoColumns")
                            {
                                <div class="slide-title">@slide.Title</div>
                                <div class="slide-columns mt-3">
                                    <div class="slide-column">
                                        <div class="slide-subtitle">@slide.Subtitle</div>
                                    </div>
                                    <div class="slide-column border-left pl-3">
                                        @foreach (var bullet in slide.Bullets)
                                        {
                                            <div class="bullet-row">
                                                <span class="bullet-dot">•</span>
                                                <span class="bullet-val">@bullet</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (slide.LayoutType == "BigStat")
                            {
                                <div class="big-stat-container">
                                    <div class="text-center font-bold text-6xl text-cyan-glow">@slide.Title</div>
                                    <div class="text-center text-secondary text-lg">@slide.Subtitle</div>
                                </div>
                            }
                            else
                            {
                                <div class="slide-quote-container">
                                    <div class="text-center italic text-xl" style="color:white;">@slide.Title</div>
                                    <div class="text-center font-bold text-cyan">@slide.Subtitle</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else if (SelectedDocument.Type == "Excel" && ActiveExcel != null)
            {
                <div class="excel-viewer-render">
                    <h3 class="mb-2">@ActiveExcel.SheetName</h3>
                    <table class="excel-table" style="width:100%; border-collapse:collapse; border:1px solid #ccc;">
                        <thead>
                            <tr>
                                @foreach (var head in ActiveExcel.Headers)
                                {
                                    <th style="border:1px solid #ccc; padding:6px; background:#f4f4f4; color:#333;">@head</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ActiveExcel.Rows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td style="border:1px solid #ccc; padding:6px; color:#111; background:#fff;">
                                            @EvaluateCell(cell, ActiveExcel)
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<style>
    .doc-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #082f49 0%, #030712 60%, #010409 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(17, 24, 39, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(6, 182, 212, 0.15); /* Cyan border */
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .header-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
    }

    .banner-title-area {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .icon-glow {
        font-size: 2.5rem;
        text-shadow: 0 0 15px rgba(6, 182, 212, 0.6);
        background: rgba(6, 182, 212, 0.1);
        padding: 0.5rem 0.75rem;
        border-radius: 12px;
        border: 1px solid rgba(6, 182, 212, 0.3);
    }

    .gradient-text-cyan {
        background: linear-gradient(135deg, #22d3ee 0%, #06b6d4 50%, #0891b2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        font-size: 2rem;
        margin: 0;
    }

    .banner-subtitle {
        color: #94a3b8;
        margin: 0.25rem 0 0 0;
        font-size: 0.95rem;
    }

    /* Status Badges */
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-cyan {
        background: rgba(6, 182, 212, 0.12);
        border: 1px solid rgba(6, 182, 212, 0.25);
        color: #22d3ee;
    }

    .badge-warning {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.25);
        color: #fbbf24;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .pulse-cyan {
        background-color: #06b6d4;
        box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.7);
        animation: pulseCyan 2s infinite;
    }

    @@keyframes pulseCyan {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(6, 182, 212, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(6, 182, 212, 0); }
    }

    /* Tabs Bar */
    .tabs-bar {
        display: flex;
        gap: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 0.5rem;
    }

    .tab-btn {
        background: none;
        border: none;
        color: #94a3b8;
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .tab-btn:hover {
        background: rgba(255, 255, 255, 0.04);
        color: #f1f5f9;
    }

    .tab-btn.active {
        background: rgba(6, 182, 212, 0.1);
        border: 1px solid rgba(6, 182, 212, 0.25);
        color: #22d3ee;
        text-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
    }

    /* Chat Workspace */
    .chat-workspace {
        display: grid;
        grid-template-columns: 260px 280px 1fr;
        height: calc(100vh - 250px);
        min-height: 550px;
        overflow: hidden;
    }

    .session-sidebar {
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: rgba(15, 23, 42, 0.35);
    }

    .session-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        overflow-y: auto;
        flex: 1;
    }

    .session-item {
        padding: 0.75rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .session-item:hover {
        background: rgba(6, 182, 212, 0.08);
        border-color: rgba(6, 182, 212, 0.2);
    }

    .session-item.active {
        background: rgba(6, 182, 212, 0.15);
        border-color: #22d3ee;
    }

    .session-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .session-date {
        font-size: 0.7rem;
        color: #64748b;
        margin-top: 0.25rem;
    }

    .btn-new-session {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
        border: none;
        color: white;
        padding: 0.65rem;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.2);
    }

    .btn-new-session:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(6, 182, 212, 0.4);
    }

    .chat-sidebar {
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: rgba(15, 23, 42, 0.2);
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .sidebar-help {
        color: #64748b;
        font-size: 0.8rem;
        margin: 0;
        line-height: 1.4;
    }

    .quick-prompts {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        overflow-y: auto;
    }

    .quick-prompt-btn {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 0.75rem;
        color: #cbd5e1;
        font-size: 0.82rem;
        text-align: left;
        cursor: pointer;
        line-height: 1.3;
        transition: all 0.2s ease;
    }

    .quick-prompt-btn:hover {
        background: rgba(6, 182, 212, 0.05);
        border-color: rgba(6, 182, 212, 0.3);
        color: #f1f5f9;
        transform: translateY(-1px);
    }

    .chat-main-pane {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .chat-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(15, 23, 42, 0.1);
    }

    .agent-avatar {
        font-size: 1.75rem;
        background: rgba(6, 182, 212, 0.1);
        border: 1px solid rgba(6, 182, 212, 0.2);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-indicator {
        font-size: 0.75rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .status-indicator.online::before {
        content: "";
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #10b981;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        background: rgba(15, 23, 42, 0.05);
    }

    .message-wrapper {
        display: flex;
        width: 100%;
    }

    .message-wrapper.user-msg {
        justify-content: flex-end;
    }

    .message-wrapper.agent-msg {
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 75%;
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 0.85rem 1.1rem;
        position: relative;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .user-msg .message-bubble {
        background: rgba(6, 182, 212, 0.15);
        border-color: rgba(6, 182, 212, 0.3);
        border-top-right-radius: 2px;
    }

    .agent-msg .message-bubble {
        border-top-left-radius: 2px;
    }

    .message-sender {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #22d3ee;
        margin-bottom: 0.25rem;
        letter-spacing: 0.05em;
    }

    .user-msg .message-sender {
        color: #a78bfa;
        text-align: right;
    }

    .message-text {
        font-size: 0.92rem;
        line-height: 1.5;
        white-space: pre-wrap;
        color: #e2e8f0;
    }

    .message-time {
        display: block;
        text-align: right;
        font-size: 0.65rem;
        color: #64748b;
        margin-top: 0.4rem;
    }

    /* Thought process box */
    .thought-box {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 8px;
        overflow: hidden;
    }

    .thought-header {
        background: rgba(139, 92, 246, 0.1);
        padding: 0.5rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: #c084fc;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
    }

    .thought-body {
        padding: 0.75rem;
        font-size: 0.8rem;
        line-height: 1.4;
        color: #94a3b8;
        border-top: 1px solid rgba(139, 92, 246, 0.15);
        white-space: pre-wrap;
        font-family: 'JetBrains Mono', monospace;
    }

    /* Drafting Loader */
    .drafting-loader {
        display: flex;
        gap: 0.35rem;
        padding: 0.5rem 0;
    }

    .drafting-loader .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #22d3ee;
        animation: typingDot 1.4s infinite ease-in-out both;
    }

    .drafting-loader .dot:nth-child(1) { animation-delay: -0.32s; }
    .drafting-loader .dot:nth-child(2) { animation-delay: -0.16s; }

    @@keyframes typingDot {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    .agent-progress-steps {
        margin-top: 0.75rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .progress-step {
        font-size: 0.75rem;
        color: #64748b;
    }

    .progress-step.active {
        color: #22d3ee;
        font-weight: 600;
    }

    /* Chat Input */
    .chat-input-area {
        padding: 1.25rem 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        gap: 0.75rem;
        background: rgba(15, 23, 42, 0.1);
    }

    .custom-chat-input {
        flex: 1;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: white;
        font-size: 0.92rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-chat-input:focus {
        border-color: rgba(6, 182, 212, 0.5);
        background: rgba(15, 23, 42, 0.6);
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.15);
    }

    .btn-send-chat {
        background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }

    .btn-send-chat:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);
    }

    .btn-send-chat:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Templates Grid */
    .templates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .template-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        height: 240px;
        position: relative;
        transition: all 0.3s ease;
    }

    .template-card:hover {
        transform: translateY(-4px);
        border-color: rgba(6, 182, 212, 0.4);
        box-shadow: 0 10px 25px rgba(6, 182, 212, 0.1);
    }

    .template-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .template-type-badge {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        letter-spacing: 0.05em;
    }

    .type-pdf { background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); }
    .type-presentation { background: rgba(168, 85, 247, 0.12); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25); }
    .type-invoice { background: rgba(34, 197, 94, 0.12); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.25); }
    .type-txtnote { background: rgba(100, 116, 139, 0.12); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.25); }
    .type-excel { background: rgba(234, 179, 8, 0.12); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.25); }

    .template-actions {
        display: flex;
        gap: 0.35rem;
    }

    .action-icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 4px;
        transition: background 0.2s;
    }

    .action-icon-btn:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .action-icon-btn.delete:hover {
        background: rgba(239, 68, 68, 0.15);
    }

    .template-name {
        margin: 0 0 0.5rem 0;
        font-weight: 700;
        font-size: 1.1rem;
        color: #f1f5f9;
    }

    .template-desc {
        font-size: 0.85rem;
        color: #94a3b8;
        margin: 0 0 1rem 0;
        flex: 1;
        line-height: 1.4;
    }

    .template-variables {
        font-size: 0.78rem;
        margin-bottom: 1rem;
    }

    .variable-tag {
        display: inline-block;
        background: rgba(255, 255, 255, 0.05);
        color: #cbd5e1;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        margin-right: 0.25rem;
        margin-bottom: 0.25rem;
        font-family: 'JetBrains Mono', monospace;
    }

    .template-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 0.5rem;
    }

    .date-text {
        font-size: 0.7rem;
        color: #64748b;
    }

    /* Archive Split Layout */
    .split-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1.5rem;
        height: calc(100vh - 250px);
        min-height: 550px;
    }

    .archive-list {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        padding: 1.5rem;
    }

    .search-input {
        width: 100%;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: white;
        font-size: 0.85rem;
        outline: none;
    }

    .search-input:focus {
        border-color: rgba(6, 182, 212, 0.4);
    }

    .doc-list-scroll {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .doc-item-card {
        background: rgba(15, 23, 42, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .doc-item-card:hover {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(6, 182, 212, 0.2);
    }

    .doc-item-card.active {
        background: rgba(6, 182, 212, 0.06);
        border-color: rgba(6, 182, 212, 0.5);
    }

    .doc-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .doc-type-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        letter-spacing: 0.02em;
    }

    .doc-status-badge {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        letter-spacing: 0.02em;
    }

    .status-draft { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }
    .status-finalized { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .status-approved { background: rgba(6, 182, 212, 0.15); color: #22d3ee; }

    .doc-item-title {
        margin: 0 0 0.5rem 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: #f1f5f9;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .doc-item-footer {
        font-size: 0.7rem;
        color: #64748b;
    }

    .no-docs-message {
        text-align: center;
        padding: 2rem;
        color: #64748b;
        font-size: 0.85rem;
    }

    /* Main Preview Window */
    .archive-preview {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        padding: 1.5rem;
    }

    .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

    .preview-title-area {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .preview-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .preview-actions {
        display: flex;
        gap: 0.5rem;
    }

    .preview-viewport {
        flex: 1;
        overflow-y: auto;
        background: rgba(15, 23, 42, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .no-selection-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        padding: 3rem;
    }

    .placeholder-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        opacity: 0.4;
    }

    /* Common Buttons */
    .btn-action-primary {
        background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        font-size: 0.88rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-action-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(6, 182, 212, 0.3);
    }

    .btn-action-sec {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #cbd5e1;
        padding: 0.5rem 1rem;
        font-size: 0.88rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-action-sec:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.15);
        color: #f8fafc;
    }

    .btn-action-sec:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* Form Styles */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .custom-input {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        color: white;
        font-size: 0.9rem;
        outline: none;
    }

    .custom-input:focus {
        border-color: rgba(6, 182, 212, 0.4);
    }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .custom-modal {
        width: 100%;
        max-width: 600px;
        padding: 2rem;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .modal-header h4 {
        margin: 0;
    }

    .modal-close-btn {
        background: none;
        border: none;
        color: #64748b;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .modal-close-btn:hover {
        color: white;
    }

    .modal-body {
        margin-bottom: 1.5rem;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 1rem;
    }

    /* Visual Previews Details */

    /* PDF Viewer */
    .pdf-viewer-render {
        background: white;
        color: #1e293b;
        padding: 2.5rem;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        min-height: 500px;
    }

    .pdf-letterhead {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .pdf-logo {
        font-size: 2rem;
        background: #f1f5f9;
        padding: 0.5rem;
        border-radius: 8px;
    }

    .pdf-letterhead h4 {
        margin: 0;
        color: #0f172a;
    }

    .pdf-letterhead p {
        margin: 0;
        font-size: 0.8rem;
        color: #64748b;
    }

    .pdf-body {
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .pdf-footer {
        margin-top: 3rem;
        border-top: 1px solid #e2e8f0;
        padding-top: 0.75rem;
        font-size: 0.75rem;
        color: #94a3b8;
        text-align: center;
    }

    /* Txt Notepad */
    .txt-viewer-render {
        background: #1e293b;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 6px;
        overflow: hidden;
    }

    .txt-header {
        background: #0f172a;
        padding: 0.5rem 1rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        display: flex;
        justify-content: space-between;
    }

    .txt-body {
        margin: 0;
        padding: 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        line-height: 1.5;
        color: #e2e8f0;
        white-space: pre-wrap;
        background: #1e293b;
    }

    /* Invoice Viewer Render */
    .invoice-viewer-render {
        background: #0f172a;
        border: 1px solid rgba(64, 224, 208, 0.15);
        border-radius: 8px;
        padding: 2rem;
        color: #f1f5f9;
    }

    .invoice-top {
        display: flex;
        justify-content: space-between;
    }

    .invoice-title {
        color: #06b6d4;
        font-weight: 800;
        letter-spacing: 0.05em;
        margin: 0;
    }

    .inv-inline-input {
        background: transparent;
        border: none;
        border-bottom: 1px dashed rgba(255,255,255,0.1);
        color: white;
        outline: none;
        width: 100%;
        padding: 0.2rem;
        transition: border-bottom 0.2s;
    }

    .inv-inline-input:focus {
        border-bottom: 1px solid #06b6d4;
        background: rgba(255,255,255,0.02);
    }

    .inv-inline-textarea {
        background: transparent;
        border: none;
        border-bottom: 1px dashed rgba(255,255,255,0.1);
        color: white;
        outline: none;
        width: 100%;
        height: 60px;
        resize: vertical;
        padding: 0.2rem;
    }

    .inv-inline-textarea:focus {
        border-bottom: 1px solid #06b6d4;
        background: rgba(255,255,255,0.02);
    }

    .form-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }

    .form-row .label {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 600;
    }

    .inline-val {
        border-bottom: 1px dashed rgba(255,255,255,0.15);
    }

    .section-sub {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #06b6d4;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 0.25rem;
    }

    .invoice-table {
        width: 100%;
        border-collapse: collapse;
    }

    .invoice-table th {
        background: rgba(15, 23, 42, 0.4);
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #06b6d4;
        border-bottom: 2px solid rgba(6, 182, 212, 0.2);
    }

    .invoice-table td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .invoice-actions-row {
        padding: 0.5rem;
    }

    .delete-line-btn {
        background: none;
        border: none;
        color: #ef4444;
        cursor: pointer;
        padding: 0.25rem;
    }

    .delete-line-btn:hover {
        color: #f87171;
    }

    .invoice-summary-area {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 2rem;
    }

    .invoice-totals {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.88rem;
        color: #94a3b8;
    }

