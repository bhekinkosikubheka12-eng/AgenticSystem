            exportContent += $@"</tbody></table>
            <p><strong>Subtotal:</strong> ${InvoiceSubtotal}</p>
            <p><strong>Tax ({ActiveInvoice.TaxRate}%):</strong> ${(InvoiceSubtotal * ActiveInvoice.TaxRate / 100):N2}</p>
            <h2>Total Due: ${InvoiceGrandTotal:N2}</h2>
            <p>Notes: {ActiveInvoice.Notes}</p>
            </body></html>";
        }
        else if (format == "html" && SelectedDocument.Type == "Presentation" && ActivePresentation != null)
        {
            exportContent = $@"<html><head><style>
                body{{font-family:system-ui, sans-serif;background:#0f172a;color:#fff;padding:40px;display:flex;flex-direction:column;gap:30px;align-items:center;}}
                .slide{{background:linear-gradient(135deg, #083344 0%, #030712 100%);border:2px solid #06b6d4;width:800px;height:450px;border-radius:12px;padding:40px;display:flex;flex-direction:column;justify-content:center;box-sizing:border-box;box-shadow:0 10px 25px rgba(0,0,0,0.5);}}
                .slide-title{{font-size:32px;font-weight:bold;margin-bottom:10px;}}
                .slide-subtitle{{color:#94a3b8;font-size:18px;margin-bottom:20px;}}
                ul{{font-size:18px;line-height:1.6;color:#cbd5e1;}}
                .big-stat{{font-size:80px;font-weight:bold;color:#22d3ee;text-align:center;text-shadow:0 0 15px rgba(6,182,212,0.5);}}
                .big-stat-sub{{font-size:20px;color:#94a3b8;text-align:center;}}
                .quote{{font-style:italic;font-size:24px;text-align:center;}}
                .quote-author{{color:#22d3ee;font-weight:bold;text-align:center;margin-top:15px;}}
            </style></head><body>
            <h1>{ActivePresentation.Title}</h1>
            <h3>{ActivePresentation.Subtitle}</h3>";
            
            foreach (var slide in ActivePresentation.Slides)
            {
                exportContent += $"<div class='slide'>";
                if (slide.LayoutType == "TitleContent")
                {
                    exportContent += $"<div class='slide-title'>{slide.Title}</div>";
                    exportContent += $"<div class='slide-subtitle'>{slide.Subtitle}</div>";
                    exportContent += "<ul>";
                    foreach (var bullet in slide.Bullets)
                    {
                        exportContent += $"<li>{bullet}</li>";
                    }
                    exportContent += "</ul>";
                }
                else if (slide.LayoutType == "TwoColumns")
                {
                    exportContent += $"<div class='slide-title'>{slide.Title}</div>";
                    exportContent += $"<div style='display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px;'>";
                    exportContent += $"<div><h4>Left Column</h4><p>{slide.Subtitle}</p></div>";
                    exportContent += $"<div><h4>Right Column</h4><ul>";
                    foreach (var bullet in slide.Bullets)
                    {
                        exportContent += $"<li>{bullet}</li>";
                    }
                    exportContent += "</ul></div></div>";
                }
                else if (slide.LayoutType == "BigStat")
                {
                    exportContent += $"<div class='big-stat'>{slide.Title}</div>";
                    exportContent += $"<div class='big-stat-sub'>{slide.Subtitle}</div>";
                }
                else // Quote
                {
                    exportContent += $"<div class='quote'>{slide.Title}</div>";
                    exportContent += $"<div class='quote-author'>{slide.Subtitle}</div>";
                }
                exportContent += "</div>";
            }
            exportContent += "</body></html>";
        }
        else if (format == "txt" && SelectedDocument.Type == "Presentation" && ActivePresentation != null)
        {
            exportContent = $"PRESENTATION OUTLINE: {ActivePresentation.Title}\n{ActivePresentation.Subtitle}\n\n";
            int idx = 1;
            foreach (var slide in ActivePresentation.Slides)
            {
                exportContent += $"Slide {idx++}: {slide.Title}\n";
                if (!string.IsNullOrEmpty(slide.Subtitle)) exportContent += $"  {slide.Subtitle}\n";
                foreach (var bullet in slide.Bullets)
                {
                    exportContent += $"  - {bullet}\n";
                }
                exportContent += "\n";
            }
        }
        else if (format == "txt" && SelectedDocument.Type == "Invoice" && ActiveInvoice != null)
        {
            exportContent = $"INVOICE {ActiveInvoice.InvoiceNumber}\n";
            exportContent += $"From: {ActiveInvoice.BusinessName}\n";
            exportContent += $"Billed To: {ActiveInvoice.ClientName} ({ActiveInvoice.ClientEmail})\n";
            exportContent += $"Date: {ActiveInvoice.Date} | Due Date: {ActiveInvoice.DueDate}\n\n";
            exportContent += "BILLING ITEMS:\n";
            foreach (var item in ActiveInvoice.LineItems)
            {
                exportContent += $"- {item.Description}: {item.Quantity} @ ${item.Rate} = ${item.Quantity * item.Rate}\n";
            }
            exportContent += $"\nSubtotal: ${InvoiceSubtotal}\n";
            exportContent += $"Tax ({ActiveInvoice.TaxRate}%): ${(InvoiceSubtotal * ActiveInvoice.TaxRate / 100):N2}\n";
            exportContent += $"Total Due: ${InvoiceGrandTotal:N2}\n\n";
            exportContent += $"Notes: {ActiveInvoice.Notes}\n";
        }
        else
        {
            exportContent = SelectedDocument.RawContent;
        }

        // Trigger native download
        try
        {
            var fileName = $"{SelectedDocument.Title.Replace(" ", "_").ToLower()}_export.{fileExtension}";
            await JSRuntime.InvokeVoidAsync("eval", $@"
                var blob = new Blob([`{exportContent.Replace("`", "\\`").Replace("$", "\\$")}`], {{type: 'text/plain'}});
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Browser download trigger failed: " + ex.Message);
        }
    }

