            SelectedDocument.StructuredDataJson = JsonSerializer.Serialize(ActiveInvoice);
        }
        else if (SelectedDocument.Type == "Presentation" && ActivePresentation != null)
        {
            SelectedDocument.StructuredDataJson = JsonSerializer.Serialize(ActivePresentation);
        }
        else if (SelectedDocument.Type == "Excel" && ActiveExcel != null)
        {
            // Sync current sizes
            ActiveExcel.Rows = ActiveExcel.Rows.Take(RowCount).Select(x => x.Take(ColCount).ToList()).ToList();
            ActiveExcel.Headers = ActiveExcel.Headers.Take(ColCount).ToList();
            SelectedDocument.StructuredDataJson = JsonSerializer.Serialize(ActiveExcel);
        }

        var userId = AuthService.CurrentUser?.LocalId ?? "default_user";
        await DocumentsService!.SaveGeneratedDocumentAsync(userId, SelectedDocument);
        
        IsEditingDocData = false;
        JsonParseError = "";
        
