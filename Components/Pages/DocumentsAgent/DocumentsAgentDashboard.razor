    protected override async Task OnInitializedAsync()
    {
        DocumentsService = new DocumentsAgentService(Config);

        var userId = AuthService.CurrentUser?.LocalId ?? "default_user";
        
        Templates = await DocumentsService.GetTemplatesAsync(userId);
        Documents = await DocumentsService.GetGeneratedDocumentsAsync(userId);

        if (Documents.Any())
        {
            SelectDocument(Documents.First());
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UserProfile != null && Sessions.Count == 0)
        {
            await LoadSessionsAsync();
        }
    }

    private async Task LoadSessionsAsync()
    {
        if (UserProfile == null) return;
        Sessions = await SessionService.GetSessionsAsync(UserProfile.UserId, "Documents");
        if (Sessions.Any())
        {
            await SelectSession(Sessions.First());
        }
        else
        {
            await CreateNewSession();
        }
    }

    private async Task SelectSession(ChatSession session)
    {
        ActiveSession = session;
        Messages = await SessionService.GetMessagesAsync(session.Id);
        StateHasChanged();
    }

    private async Task CreateNewSession()
    {
        if (UserProfile == null) return;
        var title = $"Doc Draft - {DateTime.Now:yyyy-MM-dd HH:mm}";
        var newSession = await SessionService.CreateSessionAsync(UserProfile.UserId, "Documents", title);
        Sessions.Insert(0, newSession);

        var welcomeMsg = new ChatMessage
        {
            Id = "welcome",
            SessionId = newSession.Id,
            Sender = "Agent",
            Text = "Hello! I am your Documents Orchestration Agent. I can help you draft proposals, design slideshow presentations, compile invoices, write discussion logs, or build Excel spreadsheets using your templates and business profile. Try choosing a quick task on the left or type your request below!",
            Thought = "Directives loaded: Waiting for user instruction to bind active placeholders and generate structural models.",
            Timestamp = DateTime.UtcNow
        };
        await SessionService.SaveMessageAsync(welcomeMsg);

        await SelectSession(newSession);
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
        IsEditingDocData = false;
        JsonParseError = "";
    }

    private void InsertPrompt(string prompt)
    {
        CurrentChatInput = prompt;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitChat();
        }
    }

    private async Task SubmitChat()
    {
        if (string.IsNullOrWhiteSpace(CurrentChatInput) || IsAgentGenerating || ActiveSession == null) return;

        var userId = AuthService.CurrentUser?.LocalId ?? "default_user";
        var userText = CurrentChatInput;
        CurrentChatInput = "";

        // Push User Message
        var userMsg = new ChatMessage
        {
            Id = Guid.NewGuid().ToString("N"),
            SessionId = ActiveSession.Id,
            Sender = "User",
            Text = userText,
            Timestamp = DateTime.UtcNow
        };
        Messages.Add(userMsg);
        await SessionService.SaveMessageAsync(userMsg);

        await ScrollChat();

        // Start Agent Generation Animation
        IsAgentGenerating = true;
        ProgressSteps.Clear();
        
        ActiveProgressStep = "Analyzing prompt keywords & detecting document type";
        StateHasChanged();
        await Task.Delay(800);

        // Simple classification based on prompt
        string detectedType = "PDF";
        DocumentTemplate? matchedTemplate = null;

        if (userText.ToLower().Contains("invoice") || userText.ToLower().Contains("bill"))
        {
            detectedType = "Invoice";
            matchedTemplate = Templates.FirstOrDefault(x => x.Type == "Invoice");
        }
        else if (userText.ToLower().Contains("slide") || userText.ToLower().Contains("presentation") || userText.ToLower().Contains("pitch"))
        {
            detectedType = "Presentation";
            matchedTemplate = Templates.FirstOrDefault(x => x.Type == "Presentation");
        }
        else if (userText.ToLower().Contains("excel") || userText.ToLower().Contains("budget") || userText.ToLower().Contains("spreadsheet") || userText.ToLower().Contains("grid"))
        {
            detectedType = "Excel";
            matchedTemplate = Templates.FirstOrDefault(x => x.Type == "Excel");
        }
        else if (userText.ToLower().Contains("note") || userText.ToLower().Contains("minutes") || userText.ToLower().Contains("txt"))
        {
            detectedType = "Txt Note";
            matchedTemplate = Templates.FirstOrDefault(x => x.Type == "Txt Note");
        }
        else
        {
            matchedTemplate = Templates.FirstOrDefault(x => x.Type == "PDF");
        }

        ProgressSteps.Add($"Identified target layout type: {detectedType}");
        ActiveProgressStep = "Resolving business profile context & binding variables";
        StateHasChanged();
        await Task.Delay(1000);

        ProgressSteps.Add("Injected placeholders: Date, ClientName, BusinessName, Values");
        ActiveProgressStep = "Executing Semantic Kernel and compiling structured fields";
        StateHasChanged();
        await Task.Delay(1200);

        // Invoke service generator
        var result = await DocumentsService!.GenerateDocumentAsync(userId, userText, detectedType, matchedTemplate, UserProfile);

        ProgressSteps.Add("Output generated and validation checks PASSED");
        ActiveProgressStep = "Saving file asset to archive";
        StateHasChanged();
        await Task.Delay(600);

        IsAgentGenerating = false;
        ProgressSteps.Clear();

        // Refresh documents list
        Documents = await DocumentsService.GetGeneratedDocumentsAsync(userId);

        // Push Agent Message response
        if (result.document != null)
        {
            var agentMsg = new ChatMessage
            {
                Id = result.document.Id,
                SessionId = ActiveSession.Id,
                Sender = "Agent",
                Text = $"Successfully drafted your document: **{result.document.Title}** ({result.document.Type}). I have auto-filled values based on your template. [Click here to view it in the Archive.]",
                Thought = result.agentThought,
                Timestamp = DateTime.UtcNow
            };
            Messages.Add(agentMsg);
            await SessionService.SaveMessageAsync(agentMsg);
            ExpandedThoughts.Add(result.document.Id);
            
            SelectDocument(result.document);
        }
        else
        {
            var agentMsg = new ChatMessage
            {
                Id = Guid.NewGuid().ToString("N"),
                SessionId = ActiveSession.Id,
                Sender = "Agent",
                Text = "I encountered an issue drafting the document. Please try again with details.",
                Thought = "Orchestrator returned empty file. Validation guard failed.",
                Timestamp = DateTime.UtcNow
            };
            Messages.Add(agentMsg);
            await SessionService.SaveMessageAsync(agentMsg);
        }

        await ScrollChat();
        StateHasChanged();
    }

