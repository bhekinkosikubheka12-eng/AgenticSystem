        else if (doc.Type == "Excel")
        {
            try
            {
                ActiveExcel = JsonSerializer.Deserialize<ExcelData>(doc.StructuredDataJson) ?? new ExcelData();
            }
            catch
            {
                ActiveExcel = new ExcelData();
