@page "/search-results"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseSearchSocialService SearchSocialService
@inject SearchAndSocialOrchestrator Orchestrator
@implements IDisposable

<PageTitle>Search Insights - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .dashboard-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0f172a 50%, #020617 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow: 0 10px 30px 0 rgba(0, 0, 0, 0.3);
        padding: 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-panel:hover {
        box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.4);
    }

    .gradient-text {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-info-custom {
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .pulse-green {
        background-color: #10b981;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseGreen 2s infinite;
    }

    .pulse-blue {
        background-color: #38bdf8;
        box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7);
        animation: pulseBlue 2s infinite;
    }

    @@keyframes pulseGreen {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    @@keyframes pulseBlue {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(56, 189, 248, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
    }

    .btn-action {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5);
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    }

    .btn-action:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-save:hover:not(:disabled) {
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .custom-input {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(15, 23, 42, 0.6);
        color: white;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-input:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
    }

    .slider-container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .slider-range {
        flex: 1;
        min-width: 200px;
        accent-color: #38bdf8;
        background: rgba(255, 255, 255, 0.1);
        height: 6px;
        border-radius: 3px;
        outline: none;
    }

    .result-card {
        background: rgba(15, 23, 42, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s ease;
    }

    .result-card:hover {
        transform: translateY(-3px);
        border-color: rgba(56, 189, 248, 0.2);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 2rem;
    }

    @@media (max-width: 1024px) {
        .grid-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-container">
    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text" style="margin: 0; font-size: 2.5rem;">Market Search Insights</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1.1rem;">Latest industry news, trends, and competitor reports for your business</p>
        </div>
        
        <div class="badge-status badge-info-custom">
            <span class="pulse-dot pulse-blue"></span>
            Agent: Active Searcher
        </div>
    </header>

    <div class="grid-layout">
        <!-- Search Results List -->
        <div>
            @if (IsRunning)
            {
                <div class="glass-panel" style="text-align: center; padding: 5rem 2rem;">
                    <div class="spinner-border text-info" role="status" style="width: 4rem; height: 4rem; border-width: 0.3em;"></div>
                    <h3 style="margin-top: 2rem; color: #38bdf8; font-weight: 700;">Search Agent In Action</h3>
                    <p style="color: #94a3b8; max-width: 500px; margin: 0.75rem auto 0 auto;">
                        Analyzing your business profile and executing simulated web queries to fetch top-performing competitor articles and industry updates...
                    </p>
                </div>
            }
            else if (SearchAgentResults == null || !SearchAgentResults.Items.Any())
            {
                <div class="glass-panel" style="text-align: center; padding: 5rem 2rem; background: rgba(30, 41, 59, 0.2);">
                    <div style="font-size: 3.5rem; margin-bottom: 1.5rem;">🔍</div>
                    <h3 style="color: #f1f5f9; font-weight: 600;">No Search Insights Found</h3>
                    <p style="color: #64748b; max-width: 460px; margin: 0.5rem auto 1.5rem auto;">
                        Our autonomous Search Agent has not run yet or does not have recorded insights for this workspace.
                    </p>
                    <button class="btn-action" @onclick="TriggerRunNow">
                        Deploy Search Agent Now
                    </button>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="margin: 0; font-weight: 700; color: #e2e8f0;">Latest Results</h3>
                        <small style="color: #64748b; font-family: 'JetBrains Mono', monospace;">
                            Last Updated: @SearchAgentResults.Timestamp.ToLocalTime().ToString("g")
                        </small>
                    </div>

                    @foreach (var item in SearchAgentResults.Items)
                    {
                        <div class="result-card">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem;">
                                <h4 style="margin: 0; color: #38bdf8; font-size: 1.2rem; font-weight: 700; line-height: 1.4;">
                                    @item.Title
                                </h4>
                                <span style="font-size: 0.75rem; background: rgba(255,255,255,0.06); padding: 0.25rem 0.5rem; border-radius: 6px; color: #94a3b8; font-family: 'JetBrains Mono', monospace; white-space: nowrap;">
                                    @item.PublishedDate
                                </span>
                            </div>
                            
                            <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
                                @item.Snippet
                            </p>

                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                                <a href="@item.Url" target="_blank" style="color: #ec4899; text-decoration: none; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem; transition: color 0.2s ease;">
                                    Read Full Article
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sidebar Scheduling Panel -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Schedule Configuration -->
            <div class="glass-panel" style="border-color: rgba(56, 189, 248, 0.2); background: rgba(15, 23, 42, 0.4);">
                <h3 style="margin-top: 0; color: #f1f5f9; font-weight: 700; font-size: 1.3rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #38bdf8;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Agent Scheduler
                </h3>

                @if (Schedule == null)
                {
                    <div style="text-align: center; padding: 1rem;">
                        <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                        <p style="color: #64748b; font-size: 0.85rem; margin-top: 0.5rem;">Retrieving Schedule Profile...</p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        <!-- Status Readout -->
                        <div style="background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.50rem;">
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Scheduler Status:</span>
                                <span style="color: @(Schedule.IsEnabled ? "#10b981" : "#ef4444"); font-weight: 600;">
                                    @(Schedule.IsEnabled ? "Autonomous Active" : "Disabled")
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Last Action:</span>
                                <span style="color: #f1f5f9; font-family: 'JetBrains Mono', monospace;">
                                    @(Schedule.LastRunTime == DateTime.MinValue ? "Never Executed" : Schedule.LastRunTime.ToLocalTime().ToString("g"))
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Next Scheduled:</span>
                                <span style="color: #38bdf8; font-family: 'JetBrains Mono', monospace; font-weight: 500;">
                                    @(!Schedule.IsEnabled ? "N/A" : Schedule.NextRunTime.ToLocalTime().ToString("g"))
                                </span>
                            </div>
                        </div>

                        <!-- Interval Input -->
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <label style="color: #94a3b8; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0;">
                                Run Interval: @GetFormattedInterval(SelectedIntervalHours)
                            </label>
                            
                            <div class="slider-container">
                                <input type="range" class="slider-range" min="1" max="120" @bind="SelectedIntervalHours" @bind:event="oninput" />
                                <input type="number" class="custom-input" style="width: 75px; text-align: center;" min="1" max="120" @bind="SelectedIntervalHours" />
                                <span style="font-size: 0.85rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">Hours</span>
                            </div>
                        </div>

                        <!-- Active Toggle -->
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <input type="checkbox" id="schedulerEnabled" @bind="IsSchedulerEnabled" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="schedulerEnabled" style="color: #cbd5e1; font-size: 0.9rem; cursor: pointer; user-select: none;">
                                Enable background executions
                            </label>
                        </div>

                        @if (!string.IsNullOrEmpty(SaveMessage))
                        {
                            <div style="padding: 0.5rem 0.75rem; border-radius: 8px; font-size: 0.8rem; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #34d399; text-align: center;">
                                @SaveMessage
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <button class="btn-action btn-save" @onclick="SaveSchedule" disabled="@IsRunning">
                                Save Scheduler Settings
                            </button>
                            
                            <button class="btn-action" style="background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%); box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);" @onclick="TriggerRunNow" disabled="@IsRunning">
                                @if (IsRunning)
                                {
                                    <span>Orchestrating Workflow...</span>
                                }
                                else
                                {
                                    <span>Run Now (Bypass)</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Active Profile Context Sidebar Card -->
            @if (UserProfile != null)
            {
                <div class="glass-panel" style="padding: 1.5rem; border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.01);">
                    <h4 style="margin-top: 0; color: #10b981; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        Business Info Context
                    </h4>
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; color: #cbd5e1;">
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.7rem; text-transform: uppercase;">Company</strong>
                            <span style="font-size: 0.9rem; color: #38bdf8; font-weight: 600;">@UserProfile.BusinessName</span>
                        </div>
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.7rem; text-transform: uppercase;">Industry</strong>
                            <span>@UserProfile.BusinessIndustry</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    private SearchAgentResult? SearchAgentResults { get; set; }
    private AgentSchedule? Schedule { get; set; }

    private int SelectedIntervalHours { get; set; } = 24;
    private bool IsSchedulerEnabled { get; set; } = true;
    private bool IsRunning { get; set; } = false;
    private string SaveMessage { get; set; } = string.Empty;

    private Timer? RefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceData();

        // Periodically refresh the data (e.g. every 5 seconds) to reflect background autonomous runs
        RefreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadWorkspaceData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadWorkspaceData()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            SearchAgentResults = await SearchSocialService.GetSearchResultsAsync(userId);
            var freshSchedule = await SearchSocialService.GetScheduleAsync(userId);
            
            if (freshSchedule != null)
            {
                Schedule = freshSchedule;
                // Only overwrite UI binding if we aren't mid-editing
                if (string.IsNullOrEmpty(SaveMessage))
                {
                    SelectedIntervalHours = Schedule.IntervalHours;
                    IsSchedulerEnabled = Schedule.IsEnabled;
                }
            }
            else
            {
                // Initialize default object structure locally for layout binding until scheduler writes it
                Schedule = new AgentSchedule(userId, 24, DateTime.MinValue, DateTime.UtcNow, true);
            }
        }
    }

    private string GetFormattedInterval(int hours)
    {
        if (hours < 24)
        {
            return hours == 1 ? "1 Hour" : $"{hours} Hours";
        }
        
        var days = hours / 24;
        var remainingHours = hours % 24;

        string dayStr = days == 1 ? "1 Day" : $"{days} Days";
        string hourStr = remainingHours == 0 ? "" : (remainingHours == 1 ? ", 1 Hour" : $", {remainingHours} Hours");

        return $"{dayStr}{hourStr}";
    }

    private async Task SaveSchedule()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || Schedule == null) return;

        try
        {
            var nextRun = DateTime.UtcNow >= Schedule.NextRunTime || Schedule.IntervalHours != SelectedIntervalHours
                ? DateTime.UtcNow.AddHours(SelectedIntervalHours)
                : Schedule.NextRunTime;

            var updatedSchedule = Schedule with
            {
                IntervalHours = SelectedIntervalHours,
                IsEnabled = IsSchedulerEnabled,
                NextRunTime = nextRun
            };

            await SearchSocialService.SaveScheduleAsync(updatedSchedule);
            Schedule = updatedSchedule;

            SaveMessage = "Scheduler updated successfully!";
            StateHasChanged();

            await Task.Delay(3000);
            SaveMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to save schedule: {ex.Message}");
        }
    }

    private async Task TriggerRunNow()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsRunning = true;
        StateHasChanged();

        try
        {
            // Trigger the double orchestrator workflow immediately
            await Orchestrator.RunWorkflowAsync(userId, UserProfile);

            // Fetch fresh results
            await LoadWorkspaceData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed executing Run Now: {ex.Message}");
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
