            overflow-x: auto;
            padding: 0.75rem;
        }

        .sim-sidebar-title {
            display: none;
        }

        .sim-objective-btn {
            white-space: nowrap;
        }
    }
</style>

@code {
    private int ActiveObjective { get; set; } = 1;
    private bool IsSimulating { get; set; } = false;
    private bool ShowDownloadMessage { get; set; } = false;
    private List<SimulatedLogEntry> SimulatedLogs { get; set; } = new();

    protected override void OnInitialized()
    {
        ResetSimulatorLogs();
    }

    private void SetObjective(int id)
    {
        if (IsSimulating) return;
        ActiveObjective = id;
        ResetSimulatorLogs();
    }

    private string GetObjectivePrompt()
    {
        return ActiveObjective switch
        {
            1 => "Sync active user directory /documents to volatile database index.",
            2 => "Perform code dependency security scan on local workspace folder.",
            3 => "Generate local weekly activity summary report from memory index.",
            _ => ""
        };
    }

    private void ResetSimulatorLogs()
    {
        SimulatedLogs.Clear();
    }

    private void OnDownloadClick()
    {
        ShowDownloadMessage = true;
    }

    private async Task RunSimulation()
    {
        if (IsSimulating) return;
        IsSimulating = true;
        ResetSimulatorLogs();
        StateHasChanged();

        var random = new Random();

        // Step 1: Agent Thoughts
        await Task.Delay(800 + random.Next(400));
        SimulatedLogs.Add(new SimulatedLogEntry
        {
            Timestamp = DateTime.Now.ToString("HH:mm:ss"),
            Type = "thought",
            Title = "AGENT THOUGHT",
            Message = ActiveObjective switch
            {
                1 => "Objective received. Scanning file system structure. I need to list subdirectories of c:/User/documents, filter text files, and compute embeddings.",
                2 => "Executing workspace audit. I will read package config files and verify checksums against database vulnerabilities.",
                3 => "Compiling ledger logs. Retrieving operational documents within current date range and summarizing agent workloads.",
                _ => ""
            }
        });
        StateHasChanged();

        // Step 2: Tool Call
        await Task.Delay(1000 + random.Next(400));
        SimulatedLogs.Add(new SimulatedLogEntry
        {
            Timestamp = DateTime.Now.ToString("HH:mm:ss"),
            Type = "tool",
            Title = "TOOL CALL",
            Message = ActiveObjective switch
            {
                1 => "ListDir(Path='c:/User/documents')",
                2 => "FindFiles(Query='*.json;*.csproj')",
                3 => "MemoryRetrieve(Filter='weekly_log_summary')",
                _ => ""
            },
            Details = ActiveObjective switch
            {
                1 => "[Found files: info.txt (2KB), draft.md (14KB), report.docx (1.2MB)]",
                2 => "[Found files: package.json, AgenticSystem.csproj]",
                3 => "[Found logs: 12 events loaded from local memory]",
                _ => ""
            }
        });
        StateHasChanged();

        // Step 3: Local embedding / action
        await Task.Delay(1200 + random.Next(400));
        SimulatedLogs.Add(new SimulatedLogEntry
        {
            Timestamp = DateTime.Now.ToString("HH:mm:ss"),
            Type = "thought",
            Title = "AGENT THOUGHT",
            Message = ActiveObjective switch
            {
                1 => "Generating vector embeddings for text contents using local model text-embedding-004. Syncing chunks to memory index.",
                2 => "Extracting dependency definitions. Cross referencing vulnerability index database loaded in local cache.",
                3 => "Consolidating 12 logs. Organizing data into high-level agent thought processes, tool latency metrics, and success ratios.",
                _ => ""
            }
        });
        StateHasChanged();

        // Step 4: Outcome / Tool result
        await Task.Delay(1000 + random.Next(400));
        SimulatedLogs.Add(new SimulatedLogEntry
        {
            Timestamp = DateTime.Now.ToString("HH:mm:ss"),
            Type = "output",
            Title = "EXECUTION RESULT",
            Message = ActiveObjective switch
            {
                1 => "Successfully embedded 16 text sections. Vector index memory updated. Sync operation completed successfully.",
                2 => "Completed dependency scan. 0 major vulnerability patches needed. Warnings: 1 (outdated local logger).",
                3 => "Weekly report created successfully and stored to disk as output_weekly_report.md.",
                _ => ""
            },
            Details = ActiveObjective switch
            {
                1 => "Indexing response: { Status: 'Indexed', VectorCount: 16, MemoryConsumption: '142 KB' }",
                2 => "Vulnerability scan: { Scanned: 43 libraries, HighRisk: 0, Recommendations: 'Update logger packages' }",
                3 => "Weekly report summary: { WorkloadsCompleted: 42, SuccessRate: '98.5%', OutputPath: 'c:/User/outputs/weekly_report.md' }",
                _ => ""
            }
        });

        IsSimulating = false;
        StateHasChanged();
    }

    public class SimulatedLogEntry
    {
        public string Timestamp { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty; // thought, tool, output
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }
}
