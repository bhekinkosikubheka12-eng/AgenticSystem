@page "/"
@layout PublicLayout
@namespace AgenticSystem.Components.Pages

<PageTitle>HumanicBot &mdash; Local Agentic Intelligence</PageTitle>

<div class="landing-hero">
    <div class="hero-glow"></div>
    <div class="hero-content">
        <div class="hero-badge">INTELLIGENT BUSINESS ORCHESTRATION</div>
        <h1 class="hero-title">Meet the <span class="gradient-text">Business Automation System</span></h1>
        <p class="hero-lead">
            The next-generation autonomous platform designed to streamline operations, automate tasks,
            and orchestrate business processes with secure, local agentic intelligence.
        </p>
        <div class="hero-actions">
            <a href="/dashboard" class="btn-primary-glow">Get System App</a>
            <a href="#explain" class="btn-secondary-link">How it works &rarr;</a>
        </div>
    </div>
</div>

<div class="section-container" id="explain">
    <div class="section-header">
        <span class="section-tag">Capabilities</span>
        <h2>Why HumanicBot?</h2>
        <p class="section-desc">A secure, localized agent architecture that puts control back in your hands.</p>
    </div>

    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>100% Data Sovereignty</h3>
            <p>Every token is processed locally. Chat logs, embeddings, and vector databases never leave your hard drive. No external API queries, no tracking, no subscription fees.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🧠</div>
            <h3>Cognitive Agent Memory</h3>
            <p>Powered by local semantic memory stores. HumanicBot builds context-rich indexing of your local documents, source code, and knowledge bases to provide hyper-relevant advice.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Autonomous Executions</h3>
            <p>Deploy agents to run multi-step workflows, edit local files safely, perform diagnostics, and orchestrate tools on your system with interactive validation guards.</p>
        </div>
    </div>
</div>

<div class="section-container bg-subtle">
    <div class="section-header">
        <span class="section-tag">Interactive Preview</span>
        <h2>See HumanicBot in Action</h2>
        <p class="section-desc">Test real-time planning, thought generation, and tool usage inside this browser simulator.</p>
    </div>

    <div class="simulator-wrapper">
        <div class="simulator-window">
            <div class="simulator-header">
                <div class="window-dot red"></div>
                <div class="window-dot yellow"></div>
                <div class="window-dot green"></div>
                <div class="window-title">humanicbot@@local-agent: ~</div>
            </div>
            
            <div class="simulator-body">
                <div class="sim-sidebar">
                    <div class="sim-sidebar-title">DEMO OBJECTIVES</div>
                    <button class="sim-objective-btn @(ActiveObjective == 1 ? "active" : "")" @onclick="() => SetObjective(1)">
                        📊 File System Sync
                    </button>
                    <button class="sim-objective-btn @(ActiveObjective == 2 ? "active" : "")" @onclick="() => SetObjective(2)">
                        🔒 Security Audit
                    </button>
                    <button class="sim-objective-btn @(ActiveObjective == 3 ? "active" : "")" @onclick="() => SetObjective(3)">
                        📝 Report Synthesis
                    </button>
                </div>

                <div class="sim-terminal">
                    <div class="sim-log-scroll">
                        <div class="sim-line system"><b>[SYSTEM]</b> Client established connection to Local-OS-Kernel v1.4.0</div>
                        <div class="sim-line system"><b>[SYSTEM]</b> Volatile RAM vector index status: READY</div>
                        <div class="sim-line user"><b>[USER]</b> @GetObjectivePrompt()</div>

                        @foreach (var log in SimulatedLogs)
                        {
                            <div class="sim-log-entry @log.Type">
                                <div class="sim-log-time">[@log.Timestamp]</div>
                                <div class="sim-log-content">
                                    <strong>@log.Title:</strong> @log.Message
                                </div>
                                @if (!string.IsNullOrEmpty(log.Details))
                                {
                                    <pre class="sim-details">@log.Details</pre>
                                }
                            </div>
                        }

                        @if (IsSimulating)
                        {
                            <div class="sim-typing">
                                <span class="dot"></span>
                                <span class="dot"></span>
                                <span class="dot"></span>
                            </div>
                        }
                    </div>
                    
                    <div class="sim-input-bar">
                        <span class="sim-prompt">$</span>
                        <input type="text" class="sim-input" readonly value="@GetObjectivePrompt()" />
                        <button class="sim-btn-run" disabled="@IsSimulating" @onclick="RunSimulation">
                            @if (IsSimulating) { <span>Running...</span> } else { <span>Execute</span> }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section-container" id="download">
    <div class="download-card">
        <div class="download-content">
            <span class="download-badge">RELEASE LATEST v1.2.4</span>
            <h2>Download HumanicBot Desktop</h2>
            <p>Deploy your local-first agent in under 2 minutes. Standard installation includes a local embeddings engine and UI dashboard.</p>
            <div class="download-meta">
                <span>📦 Size: ~124 MB</span>
                <span>🖥️ Platform: Windows 10/11 (x64), macOS 12+, Linux x64</span>
            </div>
            <!-- The download link triggers the download notification -->
            <a href="/dashboard" class="btn-download" >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 0.5rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                 Offline App
            </a>
            @if (ShowDownloadMessage)
            {
                <div class="download-alert">
                    🎉 Thank you for downloading! The setup file link is currently being configured. In production, this link downloads the standalone installer directly.
                </div>
            }
        </div>
    </div>
</div>

