@page "/social-media-posts"
@using AgenticSystem.Data
@using AgenticSystem.Services
@inject FirebaseAuthService AuthService
@inject FirebaseSearchSocialService SearchSocialService
@inject SearchAndSocialOrchestrator Orchestrator
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Social Advisor - Agentic OS</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

    .dashboard-container {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #0f172a 50%, #020617 100%);
        color: #f8fafc;
        min-height: 100vh;
        padding: 2.5rem;
    }

    .glass-panel {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow: 0 10px 30px 0 rgba(0, 0, 0, 0.3);
        padding: 2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-panel:hover {
        box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.4);
    }

    .gradient-text {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-info-custom {
        background: rgba(167, 139, 250, 0.15);
        border: 1px solid rgba(167, 139, 250, 0.3);
        color: #c084fc;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .pulse-purple {
        background-color: #a78bfa;
        box-shadow: 0 0 0 0 rgba(167, 139, 250, 0.7);
        animation: pulsePurple 2s infinite;
    }

    @@keyframes pulsePurple {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(167, 139, 250, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(167, 139, 250, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(167, 139, 250, 0); }
    }

    .btn-action {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5);
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    }

    .btn-action:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-save:hover:not(:disabled) {
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .custom-input {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(15, 23, 42, 0.6);
        color: white;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .custom-input:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
    }

    .slider-container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .slider-range {
        flex: 1;
        min-width: 200px;
        accent-color: #38bdf8;
        background: rgba(255, 255, 255, 0.1);
        height: 6px;
        border-radius: 3px;
        outline: none;
    }

    /* Platform Recommendation Cards */
    .post-card {
        border-radius: 14px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .post-linkedin {
        background: rgba(10, 102, 194, 0.04);
        border-left: 5px solid #0a66c2;
    }

    .post-twitter {
        background: rgba(24, 250, 252, 0.02);
        border-left: 5px solid #1da1f2;
    }

    .post-instagram {
        background: rgba(225, 48, 108, 0.03);
        border-left: 5px solid #e1306c;
    }

    .post-facebook {
        background: rgba(24, 119, 242, 0.04);
        border-left: 5px solid #1877f2;
    }

    .post-youtube {
        background: rgba(255, 0, 0, 0.03);
        border-left: 5px solid #ff0000;
    }

    /* Tabs Navigation */
    .tabs-nav {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .tab-btn {
        background: rgba(30, 41, 59, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #94a3b8;
        padding: 0.6rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #f1f5f9;
        border-color: rgba(255, 255, 255, 0.15);
    }

    .tab-btn.active {
        background: rgba(56, 189, 248, 0.15);
        border-color: rgba(56, 189, 248, 0.4);
        color: #38bdf8;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.15);
        transform: translateY(-1px);
    }

    .platform-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 0.75rem;
    }

    .platform-title {
        font-weight: 700;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .post-body {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        color: #e2e8f0;
        white-space: pre-wrap;
        background: rgba(0, 0, 0, 0.2);
        padding: 1rem 1.25rem;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.03);
    }

    .hashtag {
        color: #38bdf8;
        font-weight: 600;
        margin-right: 0.5rem;
        font-size: 0.9rem;
    }

    .post-meta-item {
        background: rgba(255, 255, 255, 0.04);
        padding: 0.5rem 0.85rem;
        border-radius: 8px;
        font-size: 0.8rem;
        color: #cbd5e1;
        border: 1px solid rgba(255,255,255,0.03);
    }

    .post-meta-label {
        color: #94a3b8;
        font-weight: 700;
        text-transform: uppercase;
        margin-right: 0.25rem;
        font-size: 0.75rem;
    }

    .btn-copy {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
    }

    .btn-copy:hover {
        background: rgba(56, 189, 248, 0.1);
        border-color: rgba(56, 189, 248, 0.3);
        color: #38bdf8;
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 2rem;
    }

    @@media (max-width: 1024px) {
        .grid-layout {
            grid-template-columns: 1fr;
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes scaleUp {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>

<div class="dashboard-container">
    @if (ShowGuidanceModal)
    {
        <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(2, 6, 23, 0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; animation: fadeIn 0.25s ease-out;">
            <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 2.25rem; border-color: rgba(56, 189, 248, 0.2); background: rgba(15, 23, 42, 0.95); box-shadow: 0 20px 40px rgba(0,0,0,0.5); transform: scale(1); animation: scaleUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
                <h3 style="margin-top: 0; margin-bottom: 0.5rem; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 0.5rem; font-size: 1.35rem;">
                    🧠 Guide the Advisor Agent
                </h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                    What topic, announcement, or campaign are you thinking about? The Copywriter Agent will use this guidance to align the post recommendations.
                </p>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
                        Your Thoughts / Instructions
                    </label>
                    <textarea class="custom-input" style="min-height: 120px; resize: vertical;" 
                              placeholder="e.g. Focus on our new carbon-neutral product line, or announce a 20% summer sale starting next Monday..." 
                              @bind="UserGuidanceText"></textarea>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-copy" style="background: rgba(255,255,255,0.05); color: #cbd5e1; border: 1px solid rgba(255,255,255,0.1); padding: 0.6rem 1.25rem; font-weight: 600;" @onclick="CloseGuidanceModal">
                        Cancel
                    </button>
                    <button type="button" class="btn-action" style="padding: 0.6rem 1.25rem;" @onclick="ConfirmAndRun">
                        Launch Agent
                    </button>
                </div>
            </div>
        </div>
    }

    @if (ShowVideoAdModal)
    {
        <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(2, 6, 23, 0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; animation: fadeIn 0.25s ease-out;">
            <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 2.25rem; border-color: rgba(167, 139, 250, 0.2); background: rgba(15, 23, 42, 0.95); box-shadow: 0 20px 40px rgba(0,0,0,0.5); transform: scale(1); animation: scaleUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
                <h3 style="margin-top: 0; margin-bottom: 0.5rem; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 0.5rem; font-size: 1.35rem;">
                    🎥 Guide the Video Ad Agent
                </h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                    Specify target visual styles, themes, transitions, voiceover instructions, or music style guidelines for your @(SelectedPostForVideo?.Platform) promo ad video.
                </p>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
                        Visual Style & Guidance instructions
                    </label>
                    <textarea class="custom-input" style="min-height: 120px; resize: vertical;" 
                              placeholder="e.g. Modern startup style, high-contrast, energetic synthwave background music, rapid scene changes, focus on B2B features..." 
                              @bind="VideoAdGuidanceText"></textarea>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-copy" style="background: rgba(255,255,255,0.05); color: #cbd5e1; border: 1px solid rgba(255,255,255,0.1); padding: 0.6rem 1.25rem; font-weight: 600;" @onclick="CloseVideoAdModal">
                        Cancel
                    </button>
                    <button type="button" class="btn-action" style="background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%); box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3); padding: 0.6rem 1.25rem;" @onclick="ConfirmAndGenerateVideoAd">
                        Create Video Script
                    </button>
                </div>
            </div>
        </div>
    }

    @if (ShowImagePosterModal)
    {
        <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(2, 6, 23, 0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; animation: fadeIn 0.25s ease-out;">
            <div class="glass-panel" style="width: 100%; max-width: 500px; padding: 2.25rem; border-color: rgba(56, 189, 248, 0.2); background: rgba(15, 23, 42, 0.95); box-shadow: 0 20px 40px rgba(0,0,0,0.5); transform: scale(1); animation: scaleUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
                <h3 style="margin-top: 0; margin-bottom: 0.5rem; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 0.5rem; font-size: 1.35rem;">
                    🎨 Guide the Image Poster Agent
                </h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                    Specify visual theme direction, brand color combinations, headline overlay styles, or central visual graphic requests for your @(SelectedPostForPoster?.Platform) marketing poster.
                </p>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
                        Design Styles & Theme guidelines
                    </label>
                    <textarea class="custom-input" style="min-height: 120px; resize: vertical;" 
                              placeholder="e.g. Minimalist layout, emerald and dark slate gradient theme, bold sans-serif typography, high-tech abstract network central vector graphics..." 
                              @bind="ImagePosterGuidanceText"></textarea>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-copy" style="background: rgba(255,255,255,0.05); color: #cbd5e1; border: 1px solid rgba(255,255,255,0.1); padding: 0.6rem 1.25rem; font-weight: 600;" @onclick="CloseImagePosterModal">
                        Cancel
                    </button>
                    <button type="button" class="btn-action" style="padding: 0.6rem 1.25rem;" @onclick="ConfirmAndGenerateImagePoster">
                        Create Poster Layout
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Header -->
    <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 class="gradient-text" style="margin: 0; font-size: 2.5rem;">Social Media Advisor</h1>
            <p style="color: #94a3b8; margin: 0.25rem 0 0 0; font-size: 1.1rem;">AI-crafted post recommendations based on active search findings and business target keywords</p>
        </div>
        
        <div class="badge-status badge-info-custom">
            <span class="pulse-dot pulse-purple"></span>
            Agent: Social Copywriter
        </div>
    </header>

    <div class="grid-layout">
        <!-- Post Recommendations -->
        <div>
            @if (ActivePlatforms.Any())
            {
                <div class="tabs-nav">
                    @foreach (var platform in ActivePlatforms)
                    {
                        var p = platform;
                        <button class="tab-btn @(ActiveTab.Equals(p, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                @onclick="() => ActiveTab = p">
                            <span>@GetPlatformEmoji(p)</span>
                            <span>@p</span>
                        </button>
                    }
                </div>
            }

            @if (IsRunning)
            {
                <div class="glass-panel" style="text-align: center; padding: 5rem 2rem;">
                    <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem; border-width: 0.3em; color: #a78bfa !important;"></div>
                    <h3 style="margin-top: 2rem; color: #a78bfa; font-weight: 700;">Generating Social Templates</h3>
                    <p style="color: #94a3b8; max-width: 500px; margin: 0.75rem auto 0 auto;">
                        Our Social Media Agent is analyzing search articles, extracting core narratives, and formatting high-engagement @string.Join(" and ", ActivePlatforms) recommendation templates...
                    </p>
                </div>
            }
            else if (SocialResults == null || !SocialResults.Recommendations.Any())
            {
                <div class="glass-panel" style="text-align: center; padding: 5rem 2rem; background: rgba(30, 41, 59, 0.2);">
                    <div style="font-size: 3.5rem; margin-bottom: 1.5rem;">📣</div>
                    <h3 style="color: #f1f5f9; font-weight: 600;">No Recommendations Generated</h3>
                    <p style="color: #64748b; max-width: 460px; margin: 0.5rem auto 1.5rem auto;">
                        No social post recommendations have been generated yet. You need to run the Search Agent first, followed by the Social Media Agent.
                    </p>
                    <button class="btn-action" @onclick="OpenGuidanceModal">
                        Deploy Copywriter Agent Now
                    </button>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 2rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="margin: 0; font-weight: 700; color: #e2e8f0;">@ActiveTab Recommendation</h3>
                        <small style="color: #64748b; font-family: 'JetBrains Mono', monospace;">
                            Last Updated: @SocialResults.Timestamp.ToLocalTime().ToString("g")
                        </small>
                    </div>

                    @{
                        var activeRecs = SocialResults.Recommendations
                            .Where(r => r.Platform.Equals(ActiveTab, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                    }

                    @if (activeRecs.Any())
                    {
                        @foreach (var rec in activeRecs)
                        {
                            var cssClass = GetPlatformCardClass(rec.Platform);
                            var iconColor = GetPlatformColor(rec.Platform);

                            <div class="post-card @cssClass">
                                <div class="platform-header">
                                    <span class="platform-title">
                                        <span style="color: @iconColor; font-size: 1.3rem;">@GetPlatformEmoji(rec.Platform)</span>
                                        @rec.Platform Copy
                                    </span>
                                    
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button type="button" class="btn-copy" style="background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.3); color: #38bdf8;" @onclick="() => OpenImagePosterModal(rec)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                            Create Poster
                                        </button>

                                        <button type="button" class="btn-copy" style="background: rgba(167, 139, 250, 0.1); border-color: rgba(167, 139, 250, 0.3); color: #c084fc;" @onclick="() => OpenVideoAdModal(rec)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                            Create Video Ad
                                        </button>
                                        
                                        <button type="button" class="btn-copy" @onclick="() => CopyToClipboard(rec.Content)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                            Copy Post
                                        </button>
                                    </div>
                                </div>

                                <div class="post-body">@rec.Content</div>

                                @if (rec.Hashtags != null && rec.Hashtags.Any())
                                {
                                    <div style="display: flex; flex-wrap: wrap;">
                                        @foreach (var tag in rec.Hashtags)
                                        {
                                            <span class="hashtag">#@tag.Replace("#", "")</span>
                                        }
                                    </div>
                                }

                                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.04); padding-top: 1rem;">
                                    <div class="post-meta-item">
                                        <span class="post-meta-label">Audience:</span>
                                        @rec.TargetAudience
                                    </div>
                                    <div class="post-meta-item" style="flex: 1; min-width: 200px;">
                                        <span class="post-meta-label">Rationale:</span>
                                        @rec.Rationale
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="glass-panel" style="text-align: center; padding: 4rem 2rem; background: rgba(30, 41, 59, 0.2);">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">@GetPlatformEmoji(ActiveTab)</div>
                            <h4 style="color: #f1f5f9; font-weight: 600;">No recommendation for @ActiveTab</h4>
                            <p style="color: #64748b; max-width: 400px; margin: 0.5rem auto 1.5rem auto;">
                                The Social Media Agent has not drafted a post for @ActiveTab. Run the advisor agent now to generate recommendations.
                            </p>
                            <button class="btn-action" @onclick="OpenGuidanceModal">
                                Generate @ActiveTab Post
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sidebar Scheduling Panel -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Schedule Configuration -->
            <div class="glass-panel" style="border-color: rgba(56, 189, 248, 0.2); background: rgba(15, 23, 42, 0.4);">
                <h3 style="margin-top: 0; color: #f1f5f9; font-weight: 700; font-size: 1.3rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #38bdf8;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Agent Scheduler
                </h3>

                @if (Schedule == null)
                {
                    <div style="text-align: center; padding: 1rem;">
                        <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                        <p style="color: #64748b; font-size: 0.85rem; margin-top: 0.5rem;">Retrieving Schedule Profile...</p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        <!-- Status Readout -->
                        <div style="background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.50rem;">
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Scheduler Status:</span>
                                <span style="color: @(Schedule.IsEnabled ? "#10b981" : "#ef4444"); font-weight: 600;">
                                    @(Schedule.IsEnabled ? "Autonomous Active" : "Disabled")
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Last Action:</span>
                                <span style="color: #f1f5f9; font-family: 'JetBrains Mono', monospace;">
                                    @(Schedule.LastRunTime == DateTime.MinValue ? "Never Executed" : Schedule.LastRunTime.ToLocalTime().ToString("g"))
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #94a3b8;">Next Scheduled:</span>
                                <span style="color: #38bdf8; font-family: 'JetBrains Mono', monospace; font-weight: 500;">
                                    @(!Schedule.IsEnabled ? "N/A" : Schedule.NextRunTime.ToLocalTime().ToString("g"))
                                </span>
                            </div>
                        </div>

                        <!-- Interval Input -->
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <label style="color: #94a3b8; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0;">
                                Run Interval: @GetFormattedInterval(SelectedIntervalHours)
                            </label>
                            
                            <div class="slider-container">
                                <input type="range" class="slider-range" min="1" max="120" @bind="SelectedIntervalHours" @bind:event="oninput" />
                                <input type="number" class="custom-input" style="width: 75px; text-align: center;" min="1" max="120" @bind="SelectedIntervalHours" />
                                <span style="font-size: 0.85rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">Hours</span>
                            </div>
                        </div>

                        <!-- Active Toggle -->
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <input type="checkbox" id="schedulerEnabled" @bind="IsSchedulerEnabled" style="width: 18px; height: 18px; cursor: pointer; accent-color: #38bdf8;" />
                            <label for="schedulerEnabled" style="color: #cbd5e1; font-size: 0.9rem; cursor: pointer; user-select: none;">
                                Enable background executions
                            </label>
                        </div>

                        @if (!string.IsNullOrEmpty(SaveMessage))
                        {
                            <div style="padding: 0.5rem 0.75rem; border-radius: 8px; font-size: 0.8rem; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #34d399; text-align: center;">
                                @SaveMessage
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <button class="btn-action btn-save" @onclick="SaveSchedule" disabled="@IsRunning">
                                Save Scheduler Settings
                            </button>
                            
                            <button class="btn-action" style="background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%); box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);" @onclick="OpenGuidanceModal" disabled="@IsRunning">
                                @if (IsRunning)
                                {
                                    <span>Orchestrating Workflow...</span>
                                }
                                else
                                {
                                    <span>Run Now (Bypass)</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Active Profile Context Sidebar Card -->
            @if (UserProfile != null)
            {
                <div class="glass-panel" style="padding: 1.5rem; border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.01);">
                    <h4 style="margin-top: 0; color: #10b981; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        Business Info Context
                    </h4>
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; color: #cbd5e1;">
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.7rem; text-transform: uppercase;">Company</strong>
                            <span style="font-size: 0.9rem; color: #38bdf8; font-weight: 600;">@UserProfile.BusinessName</span>
                        </div>
                        <div>
                            <strong style="color: #94a3b8; display: block; font-size: 0.7rem; text-transform: uppercase;">Industry</strong>
                            <span>@UserProfile.BusinessIndustry</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public UserBusinessProfile? UserProfile { get; set; }

    private SocialMediaAgentResult? SocialResults { get; set; }
    private AgentSchedule? Schedule { get; set; }

    private int SelectedIntervalHours { get; set; } = 24;
    private bool IsSchedulerEnabled { get; set; } = true;
    private bool IsRunning { get; set; } = false;
    private string SaveMessage { get; set; } = string.Empty;

    private Timer? RefreshTimer;

    private string ActiveTab { get; set; } = string.Empty;
    private bool ShowGuidanceModal { get; set; } = false;
    private string UserGuidanceText { get; set; } = string.Empty;

    private bool ShowVideoAdModal { get; set; } = false;
    private string VideoAdGuidanceText { get; set; } = string.Empty;
    private SocialPostRecommendation? SelectedPostForVideo { get; set; }

    private void OpenVideoAdModal(SocialPostRecommendation post)
    {
        SelectedPostForVideo = post;
        VideoAdGuidanceText = string.Empty;
        ShowVideoAdModal = true;
    }

    private void CloseVideoAdModal()
    {
        ShowVideoAdModal = false;
    }

    private void ConfirmAndGenerateVideoAd()
    {
        if (SelectedPostForVideo == null) return;
        ShowVideoAdModal = false;

        var platformEscaped = Uri.EscapeDataString(SelectedPostForVideo.Platform);
        var contentEscaped = Uri.EscapeDataString(SelectedPostForVideo.Content);
        var guidanceEscaped = Uri.EscapeDataString(VideoAdGuidanceText);

        Navigation.NavigateTo($"/video-ads?platform={platformEscaped}&content={contentEscaped}&guidance={guidanceEscaped}");
    }

    private bool ShowImagePosterModal { get; set; } = false;
    private string ImagePosterGuidanceText { get; set; } = string.Empty;
    private SocialPostRecommendation? SelectedPostForPoster { get; set; }

    private void OpenImagePosterModal(SocialPostRecommendation post)
    {
        SelectedPostForPoster = post;
        ImagePosterGuidanceText = string.Empty;
        ShowImagePosterModal = true;
    }

    private void CloseImagePosterModal()
    {
        ShowImagePosterModal = false;
    }

    private void ConfirmAndGenerateImagePoster()
    {
        if (SelectedPostForPoster == null) return;
        ShowImagePosterModal = false;

        var platformEscaped = Uri.EscapeDataString(SelectedPostForPoster.Platform);
        var contentEscaped = Uri.EscapeDataString(SelectedPostForPoster.Content);
        var guidanceEscaped = Uri.EscapeDataString(ImagePosterGuidanceText);

        Navigation.NavigateTo($"/image-posters?platform={platformEscaped}&content={contentEscaped}&guidance={guidanceEscaped}");
    }

    private List<string> ActivePlatforms => UserProfile?.SelectedPlatforms
        ?.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList()
        ?? new List<string> { "LinkedIn", "Twitter" };

    private void OpenGuidanceModal()
    {
        UserGuidanceText = string.Empty;
        ShowGuidanceModal = true;
    }

    private void CloseGuidanceModal()
    {
        ShowGuidanceModal = false;
    }

    private async Task ConfirmAndRun()
    {
        ShowGuidanceModal = false;
        await TriggerRunNow(UserGuidanceText);
    }

    protected override void OnParametersSet()
    {
        if (ActivePlatforms.Any() && (string.IsNullOrEmpty(ActiveTab) || !ActivePlatforms.Contains(ActiveTab)))
        {
            ActiveTab = ActivePlatforms.First();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceData();

        // Periodically refresh the data (e.g. every 5 seconds) to reflect background autonomous runs
        RefreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadWorkspaceData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadWorkspaceData()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId != null)
        {
            SocialResults = await SearchSocialService.GetSocialResultsAsync(userId);
            var freshSchedule = await SearchSocialService.GetScheduleAsync(userId);
            
            if (freshSchedule != null)
            {
                Schedule = freshSchedule;
                if (string.IsNullOrEmpty(SaveMessage))
                {
                    SelectedIntervalHours = Schedule.IntervalHours;
                    IsSchedulerEnabled = Schedule.IsEnabled;
                }
            }
            else
            {
                Schedule = new AgentSchedule(userId, 24, DateTime.MinValue, DateTime.UtcNow, true);
            }
        }
    }

    private string GetFormattedInterval(int hours)
    {
        if (hours < 24)
        {
            return hours == 1 ? "1 Hour" : $"{hours} Hours";
        }
        
        var days = hours / 24;
        var remainingHours = hours % 24;

        string dayStr = days == 1 ? "1 Day" : $"{days} Days";
        string hourStr = remainingHours == 0 ? "" : (remainingHours == 1 ? ", 1 Hour" : $", {remainingHours} Hours");

        return $"{dayStr}{hourStr}";
    }

    private string GetPlatformCardClass(string platform)
    {
        return platform.ToLower() switch
        {
            "linkedin" => "post-linkedin",
            "twitter" or "x" => "post-twitter",
            "instagram" => "post-instagram",
            "facebook" => "post-facebook",
            "youtube" => "post-youtube",
            _ => ""
        };
    }

    private string GetPlatformEmoji(string platform)
    {
        return platform.ToLower() switch
        {
            "linkedin" => "💼",
            "twitter" or "x" => "🐦",
            "instagram" => "📸",
            "facebook" => "👥",
            "youtube" => "🎥",
            _ => "📢"
        };
    }

    private string GetPlatformColor(string platform)
    {
        return platform.ToLower() switch
        {
            "linkedin" => "#0a66c2",
            "twitter" or "x" => "#1da1f2",
            "instagram" => "#e1306c",
            "facebook" => "#1877f2",
            "youtube" => "#ff0000",
            _ => "#cbd5e1"
        };
    }

    private async Task SaveSchedule()
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || Schedule == null) return;

        try
        {
            var nextRun = DateTime.UtcNow >= Schedule.NextRunTime || Schedule.IntervalHours != SelectedIntervalHours
                ? DateTime.UtcNow.AddHours(SelectedIntervalHours)
                : Schedule.NextRunTime;

            var updatedSchedule = Schedule with
            {
                IntervalHours = SelectedIntervalHours,
                IsEnabled = IsSchedulerEnabled,
                NextRunTime = nextRun
            };

            await SearchSocialService.SaveScheduleAsync(updatedSchedule);
            Schedule = updatedSchedule;

            SaveMessage = "Scheduler updated successfully!";
            StateHasChanged();

            await Task.Delay(3000);
            SaveMessage = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to save schedule: {ex.Message}");
        }
    }

    private async Task TriggerRunNow(string guidance = "")
    {
        var userId = AuthService.CurrentUser?.LocalId;
        if (userId == null || UserProfile == null) return;

        IsRunning = true;
        StateHasChanged();

        try
        {
            // Run workflow immediately
            await Orchestrator.RunWorkflowAsync(userId, UserProfile, guidance);

            // Fetch fresh results
            await LoadWorkspaceData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed executing Run Now: {ex.Message}");
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy to clipboard: {ex.Message}");
        }
    }

    public void Dispose()
    {
        RefreshTimer?.Dispose();
    }
}
